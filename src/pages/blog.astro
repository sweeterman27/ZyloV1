---
import Layout from "../layouts/Layout.astro";

const articles = [
  {
    id: "best-home-gym-ph",
    slug: "best-home-gym-equipment-in-the-philippines",
    category: "AI Technology",
    title: "Best Home Gym Equipment in the Philippines for Smarter Training at Home",
    excerpt: "Finding the right home gym equipment in the Philippines is no longer just about buying weights, benches, or cardio machines. Today, more Filipinos are looking for smarter, more compact, and more personalized fitness solutions.",
    author: "ZYLO Editorial Team",
    date: "July 18, 2026",
    readTime: "5 min read",
    featured: true,
    tag: "Home Fitness PH"
  },
  {
    id: "gym-equipment-near-me",
    slug: "gym-equipment-for-sale-near-me-what-to-consider",
    category: "Strength & Performance",
    title: "Gym Equipment for Sale Near Me? What to Consider Before Buying",
    excerpt: "When people search for gym equipment for sale near me, the usual options are treadmills, benches, dumbbells, resistance machines, and cardio equipment. But before buying, will it fit your lifestyle long-term?",
    author: "ZYLO Editorial Team",
    date: "July 14, 2026",
    readTime: "5 min read",
    featured: true,
    tag: "Buying Guide"
  },
  {
    id: "ai-smart-home-gym-ph",
    slug: "ai-smart-home-gym-philippines-future-of-private-fitness",
    category: "AI Technology",
    title: "AI Smart Home Gym Philippines: The Future of Private Fitness at Home",
    excerpt: "The future of fitness is becoming smarter, more private, and more personalized. In the Philippines, where busy lifestyles, traffic, and limited time affect training consistency, an AI smart home gym gives people a practical way to stay active.",
    author: "ZYLO Editorial Team",
    date: "July 10, 2026",
    readTime: "4 min read",
    featured: true,
    tag: "AI Fitness PH"
  },
  {
    id: "compact-gym-equipment-ph",
    slug: "why-premium-homes-in-the-philippines-are-choosing-compact-gym-equipment",
    category: "Home Fitness",
    title: "Why Premium Homes in the Philippines Are Choosing Compact Gym Equipment",
    excerpt: "In today's premium Filipino homes, wellness is no longer treated as an extra room or weekend activity. Discover why compact fitness technology allows users to train privately and maintain an elevated home environment.",
    author: "ZYLO Editorial Team",
    date: "July 05, 2026",
    readTime: "6 min read",
    featured: false,
    tag: "Spatial Design"
  },
  {
    id: "no-subscription-home-gym",
    slug: "why-a-no-subscription-home-gym-makes-sense-for-modern-filipino-homes",
    category: "Ecosystem & Value",
    title: "Why a No Subscription Home Gym Makes Sense for Modern Filipino Homes",
    excerpt: "For many Filipinos, fitness has become part of a bigger lifestyle decision. Discover why a no subscription home gym gives users the freedom to train without recurring monthly access fees.",
    author: "ZYLO Editorial Team",
    date: "June 28, 2026",
    readTime: "6 min read",
    featured: false,
    tag: "Ecosystem"
  },
  {
    id: "miss-universe-ph-partnership",
    slug: "zylo-ai-joins-miss-universe-philippines-2026-official-partner",
    category: "Press & Partnerships",
    title: "ZYLO AI Joins Miss Universe Philippines 2026 as Official Intelligent Wellbeing & Smart Living Partner",
    excerpt: "March 17, 2026 | Manila — ZYLO AI by Zion has officially joined Miss Universe Philippines 2026 as its Official Intelligent Wellbeing and Smart Living Partner, marking a new chapter in technology and wellness.",
    author: "ZYLO Media Relations",
    date: "March 17, 2026",
    readTime: "4 min read",
    featured: false,
    tag: "Partnerships"
  },
  {
    id: "gamified-motion",
    slug: "gamified-fitness-9-motion-games",
    category: "Lifestyle",
    title: "Gamified Fitness: How 9 Built-In Motion Games Turn Daily Workouts Into Play",
    excerpt: "Consistency is key to results. Explore how interactive motion games like Space Dodger and Balloon Pop keep executive families motivated every single day.",
    author: "Interactive Gaming Division",
    date: "June 12, 2026",
    readTime: "6 min read",
    featured: false,
    tag: "Motion Games"
  }
];

const categoriesList = [
  { name: "AI Technology", count: 12 },
  { name: "Strength & Performance", count: 8 },
  { name: "Body Composition", count: 6 },
  { name: "Home Fitness", count: 15 },
  { name: "Ecosystem & Value", count: 4 },
  { name: "Recovery & Mobility", count: 9 }
];
---

<Layout
  title="ZYLO AI Fitness Journal & Insights | Smart Home Gym Blog"
  description="Read articles, guides, and insights on AI smart home gyms, digital resistance training, posture correction, and home fitness in the Philippines."
  canonical="/blog"
>
  <!-- Sticky Header Navbar -->


  <!-- Editorial Main Container -->
  <div class="bg-brand-lightGray/40 min-h-screen py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      
      <!-- Editorial Header Banner -->
      <div class="text-center max-w-3xl mx-auto mb-12 border-b border-zinc-200 pb-10">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-mint/10 border border-brand-mint/30 text-[10px] font-mono text-brand-mint font-bold uppercase tracking-widest mb-3">
          <span class="h-2 w-2 rounded-full bg-brand-mint"></span>
          ZYLO AI JOURNAL &amp; RESEARCH
        </span>
        <h1 class="font-display font-extrabold text-3xl sm:text-5xl text-brand-black tracking-tight leading-tight uppercase">
          Smart Fitness Insights
        </h1>
        <p class="text-xs sm:text-sm text-zinc-500 font-medium leading-relaxed mt-3 max-w-xl mx-auto">
          Explore the latest research on 42-point AI skeletal tracking, motorized digital resistance, body composition analysis, and executive home wellness.
        </p>
      </div>

      <!-- ─── TOP 3 FEATURED HIGHLIGHTS GRID ─── -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
        {articles.slice(0, 3).map((art) => (
          <a 
            href={`/blog/${art.slug}`}
            class="group flex flex-col bg-white rounded-3xl border border-zinc-200/80 overflow-hidden shadow-sm hover:shadow-xl hover:border-brand-mint/60 transition-all duration-300"
          >
            
            <!-- Placeholder Image Box (No generated images, pure CSS schematic placeholder) -->
            <div class="relative aspect-[16/9] w-full bg-zinc-900 border-b border-zinc-100 overflow-hidden select-none p-6 flex flex-col items-center justify-center text-center group-hover:bg-zinc-950 transition-colors">
              <div class="absolute inset-0 bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:20px_20px] opacity-15"></div>
              
              <!-- Placeholder Graphic Badge -->
              <div class="relative z-10 flex flex-col items-center gap-2">
                <div class="h-10 w-10 rounded-2xl bg-white/10 border border-white/20 flex items-center justify-center text-brand-mint group-hover:scale-110 transition-transform">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                  </svg>
                </div>
                <span class="text-[9px] font-mono text-zinc-400 uppercase tracking-widest">{art.tag} Image Placeholder</span>
              </div>

              <!-- Top Left Tag -->
              <span class="absolute top-4 left-4 text-[9px] font-mono font-bold text-white bg-white/10 backdrop-blur-md border border-white/20 px-2.5 py-0.5 rounded-full uppercase tracking-wider">
                {art.category}
              </span>
            </div>

            <!-- Card Content -->
            <div class="p-6 flex flex-col justify-between flex-1">
              <div>
                <div class="flex items-center gap-2 text-[10px] font-mono text-zinc-400 mb-2">
                  <span>{art.date}</span>
                  <span>•</span>
                  <span>{art.readTime}</span>
                </div>
                <h3 class="font-display font-extrabold text-base text-brand-black leading-snug group-hover:text-brand-black transition-colors">
                  {art.title}
                </h3>
              </div>

              <div class="mt-6 border-t border-zinc-100 pt-4 flex items-center justify-between text-xs font-bold text-brand-black">
                <span class="group-hover:text-brand-mint transition-colors">Read Article →</span>
                <span class="text-[10px] text-zinc-400 font-mono">{art.author}</span>
              </div>
            </div>

          </a>
        ))}
      </div>

      <!-- ─── MAIN 2-COLUMN MAGAZINE LAYOUT ─── -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- LEFT COLUMN: ARTICLES FEED (8 COLS) -->
        <div class="lg:col-span-8 flex flex-col gap-10">
          
          <!-- Main Featured Lead Story Card -->
          <a 
            href={`/blog/${articles[0].slug}`}
            class="block group bg-white rounded-3xl border border-zinc-200/80 overflow-hidden shadow-sm hover:shadow-xl hover:border-brand-mint/60 transition-all duration-300"
          >
            <!-- Large Image Placeholder Box -->
            <div class="relative aspect-[21/9] sm:aspect-[16/7] w-full bg-zinc-950 border-b border-zinc-100 flex flex-col items-center justify-center select-none p-8 text-center">
              <div class="absolute inset-0 bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:24px_24px] opacity-15"></div>
              
              <div class="relative z-10 flex flex-col items-center gap-3">
                <div class="h-14 w-14 rounded-2xl bg-white/10 border border-white/20 flex items-center justify-center text-brand-mint group-hover:scale-110 transition-transform">
                  <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 01-2.25 2.25M16.5 7.5V18a2.25 2.25 0 002.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 002.25 2.25h13.5" />
                  </svg>
                </div>
                <span class="text-xs font-mono text-zinc-400 uppercase tracking-widest">Featured Article 1 Cover Placeholder</span>
              </div>

              <span class="absolute top-6 left-6 inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-black text-white text-[10px] font-mono uppercase tracking-widest font-bold">
                <span class="h-2 w-2 rounded-full bg-brand-mint"></span>
                Lead Story
              </span>
            </div>

            <!-- Content Details -->
            <div class="p-8 sm:p-10">
              <div class="flex items-center gap-3 text-xs font-mono text-zinc-400 mb-3">
                <span class="font-bold text-brand-mint uppercase tracking-wider">{articles[0].category}</span>
                <span>•</span>
                <span>{articles[0].date}</span>
                <span>•</span>
                <span>{articles[0].readTime}</span>
              </div>

              <h2 class="font-display font-extrabold text-2xl sm:text-3xl text-brand-black leading-tight group-hover:text-brand-black">
                {articles[0].title}
              </h2>

              <p class="text-xs sm:text-sm text-zinc-600 font-medium leading-relaxed mt-4">
                {articles[0].excerpt}
              </p>

              <div class="mt-8 pt-6 border-t border-zinc-100 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                  <div class="h-9 w-9 rounded-full bg-zinc-900 flex items-center justify-center text-white text-xs font-extrabold">
                    ZY
                  </div>
                  <div>
                    <span class="block text-xs font-bold text-brand-black">{articles[0].author}</span>
                    <span class="block text-[10px] text-zinc-400">Computer Vision &amp; Biomechanics Lab</span>
                  </div>
                </div>

                <span class="btn-spring inline-flex items-center justify-center gap-2 rounded-xl bg-brand-black px-6 py-3 text-xs font-bold text-white uppercase tracking-wider group-hover:bg-neutral-800 transition-colors">
                  <span>Read Full Article</span>
                  <svg class="h-3.5 w-3.5 text-brand-mint" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </span>
              </div>
            </div>
          </a>

          <!-- Remaining Articles Feed Grid (Articles 4 to 7) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
            {articles.slice(3).map((art) => (
              <a 
                href={`/blog/${art.slug}`}
                class="group flex flex-col bg-white rounded-3xl border border-zinc-200/80 overflow-hidden shadow-sm hover:shadow-xl hover:border-brand-mint/60 transition-all duration-300"
              >
                <!-- Image Placeholder Box -->
                <div class="relative aspect-[16/9] w-full bg-zinc-900 border-b border-zinc-100 flex flex-col items-center justify-center text-center select-none p-6 group-hover:bg-zinc-950 transition-colors">
                  <div class="absolute inset-0 bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:16px_16px] opacity-15"></div>
                  
                  <div class="relative z-10 flex flex-col items-center gap-1.5">
                    <svg class="h-6 w-6 text-brand-mint group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                    </svg>
                    <span class="text-[9px] font-mono text-zinc-400 uppercase tracking-widest">{art.tag} Image Placeholder</span>
                  </div>

                  <span class="absolute top-3 left-3 text-[9px] font-mono font-bold text-white bg-white/10 backdrop-blur-md px-2.5 py-0.5 rounded-full uppercase tracking-wider">
                    {art.category}
                  </span>
                </div>

                <!-- Content Area -->
                <div class="p-6 flex flex-col justify-between flex-1">
                  <div>
                    <div class="flex items-center gap-2 text-[10px] font-mono text-zinc-400 mb-2">
                      <span>{art.date}</span>
                      <span>•</span>
                      <span>{art.readTime}</span>
                    </div>
                    <h3 class="font-display font-extrabold text-base text-brand-black leading-snug group-hover:text-brand-black transition-colors">
                      {art.title}
                    </h3>
                    <p class="text-xs text-zinc-500 font-medium mt-2 leading-relaxed line-clamp-2">
                      {art.excerpt}
                    </p>
                  </div>

                  <div class="mt-6 pt-4 border-t border-zinc-100 flex items-center justify-between text-xs font-bold text-brand-black">
                    <span class="group-hover:text-brand-mint transition-colors">Read Story →</span>
                    <span class="text-[10px] text-zinc-400 font-mono">{art.author}</span>
                  </div>
                </div>
              </a>
            ))}
          </div>

          <!-- Pagination Bar -->
          <div class="flex items-center justify-center gap-2 mt-6">
            <button type="button" class="h-10 w-10 rounded-full bg-brand-black text-white font-mono text-xs font-bold flex items-center justify-center">1</button>
            <button type="button" class="h-10 w-10 rounded-full bg-white border border-zinc-200 text-zinc-600 hover:border-brand-mint font-mono text-xs font-bold flex items-center justify-center transition-colors">2</button>
            <button type="button" class="h-10 w-10 rounded-full bg-white border border-zinc-200 text-zinc-600 hover:border-brand-mint font-mono text-xs font-bold flex items-center justify-center transition-colors">3</button>
            <button type="button" class="h-10 px-4 rounded-full bg-white border border-zinc-200 text-zinc-600 hover:border-brand-mint font-mono text-xs font-bold flex items-center justify-center transition-colors">Next →</button>
          </div>

        </div>

        <!-- RIGHT COLUMN: SIDEBAR WIDGETS (4 COLS) -->
        <div class="lg:col-span-4 flex flex-col gap-8">
          
          <!-- Widget 1: ZYLO AI Story Card -->
          <div class="bg-zinc-950 text-white rounded-3xl p-6 sm:p-8 border border-zinc-800 shadow-lg relative overflow-hidden">
            <div class="relative z-10">
              <div class="h-10 w-10 rounded-2xl bg-brand-mint/20 border border-brand-mint/30 flex items-center justify-center text-brand-mint mb-4">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
                </svg>
              </div>
              <h3 class="font-display font-extrabold text-lg text-white uppercase tracking-tight">
                About ZYLO AI
              </h3>
              <p class="text-xs text-zinc-400 leading-relaxed mt-2 font-medium">
                An AI-powered smart wellness and fitness brand created to redefine how Filipinos train, recover, and stay active at home under ZK Summit Holdings Inc.
              </p>
              <a href="/about" class="mt-4 inline-flex items-center gap-1.5 text-xs font-bold text-brand-mint hover:underline">
                <span>Discover Our Story</span>
                <span>&rarr;</span>
              </a>
            </div>
          </div>

          <!-- Widget 2: Article Categories List -->
          <div class="bg-white rounded-3xl p-6 sm:p-8 border border-zinc-200/80 shadow-sm">
            <h3 class="font-display font-extrabold text-base text-brand-black uppercase tracking-tight mb-4 border-b border-zinc-100 pb-3">
              Categories
            </h3>
            <ul class="flex flex-col divide-y divide-zinc-100 text-xs font-semibold text-zinc-700">
              {categoriesList.map((cat) => (
                <li class="py-2.5 flex items-center justify-between hover:text-brand-black cursor-pointer transition-colors group">
                  <span class="group-hover:text-brand-black">{cat.name}</span>
                  <span class="font-mono text-[10px] text-zinc-400 bg-zinc-100 px-2 py-0.5 rounded-full">{cat.count}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Widget 3: Quote of the Day -->
          <div class="bg-brand-mint/10 border border-brand-mint/30 rounded-3xl p-6 sm:p-8 relative">
            <span class="text-xs font-mono font-bold text-brand-mint uppercase tracking-widest block mb-2">Quote of the Day</span>
            <blockquote class="font-display font-extrabold text-base text-brand-black leading-snug">
              &ldquo;Intelligence is the ultimate force multiplier in physical performance.&rdquo;
            </blockquote>
            <span class="block text-[10px] font-mono text-zinc-500 mt-3">&mdash; ZYLO AI Research Team</span>
          </div>

          <!-- Widget 4: Popular Posts -->
          <div class="bg-white rounded-3xl p-6 sm:p-8 border border-zinc-200/80 shadow-sm">
            <h3 class="font-display font-extrabold text-base text-brand-black uppercase tracking-tight mb-4 border-b border-zinc-100 pb-3">
              Popular Posts
            </h3>
            <div class="flex flex-col gap-4">
              {articles.slice(1, 4).map((pop) => (
                <div class="flex items-center gap-3 group cursor-pointer">
                  <!-- Thumbnail Placeholder -->
                  <div class="h-12 w-12 rounded-xl bg-zinc-900 shrink-0 border border-zinc-200 flex items-center justify-center text-brand-mint text-[9px] font-mono select-none">
                    IMG
                  </div>
                  <div>
                    <h4 class="font-display font-bold text-xs text-brand-black group-hover:text-brand-black leading-tight line-clamp-2 transition-colors">
                      {pop.title}
                    </h4>
                    <span class="text-[9px] font-mono text-zinc-400 mt-1 block">{pop.date}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Widget 5: Newsletter Box -->
          <div class="bg-white rounded-3xl p-6 sm:p-8 border border-zinc-200/80 shadow-sm">
            <h3 class="font-display font-extrabold text-base text-brand-black uppercase tracking-tight mb-2">
              Stay Informed
            </h3>
            <p class="text-xs text-zinc-500 font-medium leading-relaxed mb-4">
              Subscribe to get the latest AI fitness research, software updates, and exclusive launch invites.
            </p>
            <form class="flex flex-col gap-2.5">
              <input
                type="email"
                placeholder="Enter your email address"
                class="w-full rounded-xl border border-zinc-200 px-4 py-3 text-xs focus:outline-none focus:border-brand-mint focus:ring-1 focus:ring-brand-mint font-medium"
              />
              <button
                type="button"
                class="btn-spring w-full rounded-xl bg-brand-black py-3 text-xs font-bold uppercase tracking-widest text-white hover:bg-neutral-800"
              >
                Subscribe Free
              </button>
            </form>
          </div>

        </div>

      </div>

    </div>
  </div>

</Layout>
