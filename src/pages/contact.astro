---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact Us — ZYLO AI Philippines"
  description="Reach ZYLO AI customer service hotline, contact form, showrooms and warehouses across the Philippines, plus product care, warranty, and after-sales support."
>
  <!-- Leaflet CSS for Map -->
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
    crossorigin=""
  />

  <!-- Top Breadcrumb Bar -->
  <div class="mx-auto max-w-[1280px] px-4 sm:px-6 pt-5 md:pt-10 pb-3">
    <a
      href="/"
      class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-zinc-500 hover:text-brand-black transition-colors min-h-[44px] py-2"
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Back to Home
    </a>
  </div>

  <!-- Main Full-Width Layout Container -->
  <section class="bg-white py-6 sm:py-10 border-t border-zinc-200/80">
    <div class="mx-auto max-w-[1280px] px-4 sm:px-6 grid gap-12 sm:gap-16">
        
        <!-- SECTION 1: Showrooms & Warehouses -->
        <section id="showrooms" class="scroll-mt-24 md:scroll-mt-28">
          <div class="grid gap-1.5 pb-4 text-center md:pb-5">
            <p class="text-[10px] sm:text-[11px] font-mono tracking-[0.3em] uppercase text-brand-mint font-bold">
              ZYLO Near You
            </p>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-black tracking-tight leading-tight">
              Showrooms &amp; Warehouses
            </h2>
          </div>

          <!-- Interactive Map Container -->
          <div class="relative overflow-hidden rounded-3xl h-[420px] sm:h-[520px] md:h-[580px] mb-6 sm:mb-8 shadow-xl border border-zinc-200 bg-emerald-50/20 group">
            <div id="philippines-map" class="w-full h-full z-10"></div>

            <!-- Top Left Floating Badge -->
            <div class="absolute top-3 left-14 sm:top-4 sm:left-16 z-[500] max-w-[calc(100%-4.5rem)] px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl bg-white/95 backdrop-blur-md text-brand-black text-[11px] sm:text-xs font-bold flex items-center gap-2 shadow-md border border-zinc-200/90 shrink-0">
              <span class="relative flex h-2.5 w-2.5 shrink-0">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
              </span>
              <span class="truncate">12 Showrooms &amp; 5 Warehouses Nationwide</span>
            </div>

            <!-- Reset Zoom Button -->
            <button
              type="button"
              id="reset-map-view"
              class="absolute bottom-3 right-3 sm:bottom-4 sm:right-4 z-[500] min-h-[44px] px-3.5 py-2 rounded-xl bg-white/95 backdrop-blur-md text-zinc-700 text-xs font-semibold hover:bg-white hover:text-brand-black transition-all shadow-md border border-zinc-200/90 flex items-center gap-1.5 cursor-pointer touch-manipulation"
            >
              <svg class="h-4 w-4 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
              </svg>
              <span>Reset Map</span>
            </button>
          </div>

          <!-- Tab Switcher: Showrooms vs Warehouses -->
          <div class="flex justify-center md:justify-end pb-6 sm:pb-8">
            <div role="tablist" aria-label="Choose showrooms or warehouses" class="inline-flex rounded-lg border border-zinc-200 bg-zinc-100 p-1 shadow-inner w-full sm:w-auto">
              <button
                type="button"
                id="tab-showrooms"
                role="tab"
                aria-selected="true"
                class="tab-btn flex-1 sm:flex-none min-h-[44px] rounded-md px-5 py-2.5 text-xs sm:text-sm font-bold transition-all bg-white text-brand-black shadow-sm cursor-pointer touch-manipulation"
              >
                Showrooms (12)
              </button>
              <button
                type="button"
                id="tab-warehouses"
                role="tab"
                aria-selected="false"
                class="tab-btn flex-1 sm:flex-none min-h-[44px] rounded-md px-5 py-2.5 text-xs sm:text-sm font-semibold transition-all text-zinc-500 hover:text-brand-black cursor-pointer touch-manipulation"
              >
                Warehouses (8)
              </button>
            </div>
          </div>

          <!-- SHOWROOMS GRID PANEL -->
          <div id="panel-showrooms" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 sm:gap-6">

            <!-- 1. SM Mall of Asia -->
