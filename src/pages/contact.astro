            </h4>

            <!-- Address with Location Pin Icon -->
            <div class="flex items-start gap-1.5 text-xs text-zinc-500 leading-snug">
              <svg class="h-3.5 w-3.5 text-zinc-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span>${loc.address}</span>
            </div>

            <!-- Bottom Contact & Directions Row (Crisp Light Mint Button) -->
            <div class="pt-2 border-t border-zinc-100 mt-1 flex items-center justify-between gap-2 text-xs">
              <a href="tel:${phoneOnly}" class="font-semibold text-zinc-700 hover:text-emerald-600 inline-flex items-center gap-1.5 transition-colors group">
                <svg class="h-3.5 w-3.5 text-zinc-400 group-hover:text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <span class="truncate max-w-[160px]">${loc.contact}</span>
              </a>
              <a href="${mapsUrl}" target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 rounded-lg bg-zinc-950 hover:bg-zinc-800 border border-zinc-800 text-white text-[11px] font-bold tracking-wide transition-all shrink-0 flex items-center gap-1.5 shadow-xs group cursor-pointer">
                <span class="text-white font-bold">Directions</span>
                <svg class="h-3 w-3 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>
          </div>
        `;

        var marker = L.marker([loc.lat, loc.lng], { icon: customIcon }).addTo(map);
        marker.bindPopup(popupContent);
        markerMap[loc.name.toLowerCase()] = marker;
      });

      // Reset Map View Button
      var resetBtn = document.getElementById("reset-map-view");
      if (resetBtn) {
        resetBtn.addEventListener("click", function () {
          map.flyTo(defaultCenter, defaultZoom, { duration: 1.2 });
          map.closePopup();
        });
      }

      // 4. Tab Switcher Logic
      var tabShowrooms = document.getElementById("tab-showrooms");
      var tabWarehouses = document.getElementById("tab-warehouses");
      var panelShowrooms = document.getElementById("panel-showrooms");
      var panelWarehouses = document.getElementById("panel-warehouses");

      if (tabShowrooms && tabWarehouses && panelShowrooms && panelWarehouses) {
        tabShowrooms.addEventListener("click", function () {
          tabShowrooms.classList.add("bg-white", "text-brand-black", "shadow-sm");
          tabShowrooms.classList.remove("text-zinc-500");
          tabWarehouses.classList.remove("bg-white", "text-brand-black", "shadow-sm");
          tabWarehouses.classList.add("text-zinc-500");

          panelShowrooms.classList.remove("hidden");
          panelWarehouses.classList.add("hidden");
        });

        tabWarehouses.addEventListener("click", function () {
          tabWarehouses.classList.add("bg-white", "text-brand-black", "shadow-sm");
          tabWarehouses.classList.remove("text-zinc-500");
          tabShowrooms.classList.remove("bg-white", "text-brand-black", "shadow-sm");
          tabShowrooms.classList.add("text-zinc-500");

          panelWarehouses.classList.remove("hidden");
          panelShowrooms.classList.add("hidden");
        });
      }

      // 5. Card Click $\to$ Focus Node on Map
      document.querySelectorAll(".showroom-card, .warehouse-card").forEach(function (card) {
        card.addEventListener("click", function (e) {
          if (e.target.closest("a")) return; // Don't intercept direct phone links

          var lat = parseFloat(card.getAttribute("data-lat"));
          var lng = parseFloat(card.getAttribute("data-lng"));
          var name = (card.getAttribute("data-name") || "").toLowerCase();

          if (lat && lng) {
            // Always scroll to map section first, then fly to location
            var mapSection = document.getElementById("showrooms");
            if (mapSection) {
              mapSection.scrollIntoView({ behavior: "smooth", block: "start" });
            }
            // Brief delay so scroll starts before flyTo kicks in
            setTimeout(function () {
              map.flyTo([lat, lng], 14, { duration: 1.4, easeLinearity: 0.4 });
            }, 300);
            var targetMarker = markerMap[name];
            if (targetMarker) {
              setTimeout(function () {
                targetMarker.openPopup();
              }, 1700);
            }
            // Briefly highlight the card that was clicked
            card.style.transition = "box-shadow 0.2s";
            card.style.boxShadow = "0 0 0 2.5px #30c18a";
            setTimeout(function () { card.style.boxShadow = ""; }, 1500);
          }
        });
      });

      // 6. Contact Form Logic -> ZYLO_SCRIPT_URL
      var contactForm = document.getElementById("contact-form");
      var successToast = document.getElementById("contact-success-toast");
      var submitBtn = document.getElementById("submit-contact-btn");
      var ZYLO_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbxV4hgMILSHCIhruPry9mgb-8buA1bdFKTCNgaKYIuhfd445MqVV2Kpc8UiyI_WzKz_Ig/exec";

      if (contactForm && successToast) {
        contactForm.addEventListener("submit", async function (e) {
          e.preventDefault();

          var firstName = (document.getElementById("first-name") || {}).value || "";
          var lastName = (document.getElementById("last-name") || {}).value || "";
          var email = (document.getElementById("email") || {}).value || "";
          var phone = (document.getElementById("phone") || {}).value || "";
          var preferredContact = (document.getElementById("preferred-contact") || {}).value || "Email";
          var subject = (document.getElementById("subject") || {}).value || "";
          var message = (document.getElementById("message") || {}).value || "";

          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = `
              <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white inline-block" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              Sending Message...
            `;
          }

          try {
            var payload = new URLSearchParams({
              orderRef: "INQUIRY-" + Math.floor(1000 + Math.random() * 9000),
              type: "Contact Form Submission",
              fullName: (firstName + " " + lastName).trim(),
              email: email,
              phone: phone,
              preferredContact: preferredContact,
              subject: subject,
              message: message,
              product: "Contact Inquiry: " + subject,
              total: "N/A (Inquiry)",
              timestamp: new Date().toISOString()
            });

            await fetch(ZYLO_SCRIPT_URL, {
              method: "POST",
              mode: "no-cors",
              headers: { "Content-Type": "application/x-www-form-urlencoded" },
              body: payload.toString()
            });

            successToast.classList.remove("hidden");
            contactForm.reset();
          } catch (err) {
            successToast.classList.remove("hidden");
            contactForm.reset();
          } finally {
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.innerHTML = "Send Message";
            }
            setTimeout(function () {
              successToast.classList.add("hidden");
            }, 7000);
          }
        });
      }
    });
  </script>
</Layout>
