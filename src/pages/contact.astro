---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact Us — ZYLO AI Philippines"
  description="Reach ZYLO AI customer service hotline, contact form, showrooms and warehouses across the Philippines, plus product care, warranty, and after-sales support."
>
  <!-- Leaflet CSS for Map -->
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
    crossorigin=""
  />

  <!-- Top Breadcrumb Bar -->
  <div class="mx-auto max-w-[1280px] px-4 sm:px-6 pt-5 md:pt-10 pb-3">
    <a
      href="/"
      class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-zinc-500 hover:text-brand-black transition-colors min-h-[44px] py-2"
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Back to Home
    </a>
  </div>

  <!-- Main Split Layout Container -->
  <section class="border-t border-zinc-200/80 bg-white">
    <div class="mx-auto grid max-w-[1280px] gap-8 px-4 sm:px-6 py-6 md:py-10 lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-14">
      
      <!-- Sticky Sidebar Navigation (On this page) -->
      <aside class="lg:sticky lg:top-[6rem] lg:self-start lg:max-h-[calc(100vh-8rem)] lg:overflow-y-auto lg:pr-2 z-20">
        <nav aria-label="On this page navigation" class="grid gap-2 sm:gap-3.5 bg-zinc-50 lg:bg-transparent p-3.5 lg:p-0 rounded-2xl border lg:border-none border-zinc-200">
          <p class="text-[10px] sm:text-[11px] font-mono tracking-[0.25em] uppercase text-zinc-400 font-bold px-1">
            On this page
          </p>
          <ul class="grid gap-1 font-semibold text-xs sm:text-sm">
            <li>
              <a
                href="#showrooms"
                class="contact-nav-link flex items-center py-2.5 pl-3.5 border-l-2 border-brand-mint text-brand-black font-bold transition-all min-h-[44px]"
                data-section="showrooms"
              >
                Showrooms &amp; Warehouses
              </a>
            </li>
            <li>
              <a
                href="#customer-service"
                class="contact-nav-link flex items-center py-2.5 pl-3.5 border-l-2 border-transparent text-zinc-500 hover:text-brand-black hover:border-zinc-300 transition-all min-h-[44px]"
                data-section="customer-service"
              >
                Customer Service
              </a>
            </li>
            <li>
              <a
                href="#faq"
                class="contact-nav-link flex items-center py-2.5 pl-3.5 border-l-2 border-transparent text-zinc-500 hover:text-brand-black hover:border-zinc-300 transition-all min-h-[44px]"
                data-section="faq"
              >
                FAQs
              </a>
            </li>
            <li>
              <a
                href="#care-support"
                class="contact-nav-link flex items-center py-2.5 pl-3.5 border-l-2 border-transparent text-zinc-500 hover:text-brand-black hover:border-zinc-300 transition-all min-h-[44px]"
                data-section="care-support"
              >
                Care &amp; Support
              </a>
            </li>
          </ul>
        </nav>
      </aside>

      <!-- Right Main Content Body -->
      <div class="grid min-w-0 gap-12 sm:gap-16">
        
        <!-- SECTION 1: Showrooms & Warehouses -->
        <section id="showrooms" class="scroll-mt-24 md:scroll-mt-28">
          <div class="grid gap-2.5 pb-5 text-center md:pb-8">
            <p class="text-[10px] sm:text-[11px] font-mono tracking-[0.3em] uppercase text-brand-mint font-bold">
              ZYLO Near You
            </p>
            <h2 class="text-2xl sm:text-4xl font-extrabold text-brand-black tracking-tight leading-tight">
              Showrooms &amp; Warehouses
            </h2>
          </div>

          <!-- Interactive Map Container -->
          <div class="relative overflow-hidden rounded-3xl h-[380px] sm:h-[500px] md:h-[560px] mb-6 sm:mb-8 shadow-xl border border-zinc-200 bg-emerald-50/20 group">
            <div id="philippines-map" class="w-full h-full z-10"></div>

            <!-- Top Left Floating Badge -->
            <div class="absolute top-3 left-14 sm:top-4 sm:left-16 z-[500] max-w-[calc(100%-4.5rem)] px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl bg-white/95 backdrop-blur-md text-brand-black text-[11px] sm:text-xs font-bold flex items-center gap-2 shadow-md border border-zinc-200/90 shrink-0">
              <span class="relative flex h-2.5 w-2.5 shrink-0">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
              </span>
              <span class="truncate">12 Showrooms &amp; 5 Warehouses Nationwide</span>
            </div>

            <!-- Reset Zoom Button -->
            <button
              type="button"
              id="reset-map-view"
              class="absolute bottom-3 right-3 sm:bottom-4 sm:right-4 z-[500] min-h-[44px] px-3.5 py-2 rounded-xl bg-white/95 backdrop-blur-md text-zinc-700 text-xs font-semibold hover:bg-white hover:text-brand-black transition-all shadow-md border border-zinc-200/90 flex items-center gap-1.5 cursor-pointer touch-manipulation"
            >
              <svg class="h-4 w-4 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
              </svg>
              <span>Reset Map</span>
            </button>
          </div>

          <!-- Tab Switcher: Showrooms vs Warehouses -->
          <div class="flex justify-center md:justify-end pb-6 sm:pb-8">
            <div role="tablist" aria-label="Choose showrooms or warehouses" class="inline-flex rounded-full border border-zinc-200 bg-zinc-100 p-1 shadow-inner w-full sm:w-auto">
              <button
                type="button"
                id="tab-showrooms"
                role="tab"
                aria-selected="true"
                class="tab-btn flex-1 sm:flex-none min-h-[44px] rounded-full px-5 py-2.5 text-xs sm:text-sm font-bold transition-all bg-white text-brand-black shadow-sm cursor-pointer touch-manipulation"
              >
                Showrooms (12)
              </button>
              <button
                type="button"
                id="tab-warehouses"
                role="tab"
                aria-selected="false"
                class="tab-btn flex-1 sm:flex-none min-h-[44px] rounded-full px-5 py-2.5 text-xs sm:text-sm font-semibold transition-all text-zinc-500 hover:text-brand-black cursor-pointer touch-manipulation"
              >
                Warehouses (5)
              </button>
            </div>
          </div>

          <!-- SHOWROOMS GRID PANEL -->
          <div id="panel-showrooms" class="grid gap-3.5 sm:gap-4 sm:grid-cols-2">
            
            <!-- 1. SM Mall of Asia -->
            <article data-lat="14.5352" data-lng="120.9822" data-name="SM Mall of Asia" class="showroom-card flex flex-col sm:flex-row items-start sm:items-center gap-3.5 p-3.5 sm:p-4 rounded-2xl border border-zinc-200 bg-white hover:border-brand-mint/50 hover:shadow-md transition-all group cursor-pointer touch-manipulation">
              <div class="w-full sm:w-24 h-14 sm:h-16 shrink-0 rounded-xl bg-zinc-100 border border-zinc-200/80 flex flex-row sm:flex-col items-center justify-center gap-2 sm:gap-1 p-1.5 group-hover:bg-zinc-200/60 transition-colors">
                <svg class="h-4 w-4 sm:h-5 sm:w-5 text-zinc-400 stroke-[1.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0h4m-4 0V11m0 0V5" />
                </svg>
                <span class="text-[9px] font-mono uppercase text-zinc-400 font-semibold tracking-tighter">Showroom</span>
              </div>
              <div class="grid gap-1 min-w-0 flex-1 w-full">
                <div class="flex items-center justify-between gap-2">
                  <h3 class="text-sm font-bold tracking-tight text-brand-black group-hover:text-brand-mint transition-colors truncate">
                    SM Mall of Asia
                  </h3>
                  <span class="text-[10px] font-semibold text-brand-mint uppercase tracking-wider shrink-0">3rd Floor</span>
                </div>
                <p class="text-xs text-zinc-600 truncate leading-snug">
                  J.W. Diokno Blvd., Mall of Asia Complex, Pasay
                </p>
                <div class="pt-1.5 border-t border-zinc-100 flex items-center justify-between text-xs min-h-[36px]">
                  <a href="tel:09655112944" class="font-semibold text-zinc-700 hover:text-brand-mint inline-flex items-center gap-1.5 py-1">
                    <svg class="h-3.5 w-3.5 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                    <span class="truncate">Anne Galicha — 0965 511 2944</span>
                  </a>
                </div>
              </div>
            </article>

            <!-- 2. SM North EDSA -->
            <article data-lat="14.6565" data-lng="121.0289" data-name="SM North EDSA" class="showroom-card flex flex-col sm:flex-row items-start sm:items-center gap-3.5 p-3.5 sm:p-4 rounded-2xl border border-zinc-200 bg-white hover:border-brand-mint/50 hover:shadow-md transition-all group cursor-pointer touch-manipulation">
              <div class="w-full sm:w-24 h-14 sm:h-16 shrink-0 rounded-xl bg-zinc-100 border border-zinc-200/80 flex flex-row sm:flex-col items-center justify-center gap-2 sm:gap-1 p-1.5 group-hover:bg-zinc-200/60 transition-colors">
                <svg class="h-4 w-4 sm:h-5 sm:w-5 text-zinc-400 stroke-[1.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0h4m-4 0V11m0 0V5" />
                </svg>
