          </p>
          <div class="flex flex-col sm:flex-row justify-center gap-3.5 w-full sm:w-auto pt-2">
            <a
              href="tel:09103102418"
              class="w-full sm:w-auto min-h-[44px] px-6 py-3 rounded-xl bg-brand-mint text-brand-black font-extrabold text-xs uppercase tracking-wider hover:bg-emerald-300 transition-colors cursor-pointer flex items-center justify-center touch-manipulation"
            >
              Request Service
            </a>
            <a
              href="#showrooms"
              class="w-full sm:w-auto min-h-[44px] px-6 py-3 rounded-xl border border-zinc-700 text-white font-bold text-xs uppercase tracking-wider hover:border-zinc-500 transition-colors cursor-pointer flex items-center justify-center touch-manipulation"
            >
              Find a Showroom
            </a>
          </div>
        </div>
      </section>
    </div>
  </section>

  <!-- Leaflet JS Library -->
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

  <!-- Custom Map CSS -->
  <style is:global>
    /* Reset Leaflet Default divIcon Square Box */
    .custom-node-wrapper.leaflet-div-icon {
      background: transparent !important;
      border: none !important;
      border-radius: 50% !important;
      box-shadow: none !important;
    }

    /* Perfect Round Green Map Nodes Matching ZYLO Theme */
    .ph-map-node, .ph-map-node-wh {
      position: relative;
      width: 18px;
      height: 18px;
      background: radial-gradient(circle at 35% 35%, #6ee7b7, #10b981 60%, #047857);
      border: 2.5px solid #ffffff;
      border-radius: 50% !important;
      box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.25), 0 4px 12px rgba(16, 185, 129, 0.45);
      transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.25s ease;
      cursor: pointer;
    }
    .ph-map-node::after, .ph-map-node-wh::after {
      content: '';
      position: absolute;
      inset: -4px;
      border-radius: 50% !important;
      background: rgba(16, 185, 129, 0.35);
      z-index: -1;
      animation: pulseNode 2s infinite;
    }
    @keyframes pulseNode {
      0% { transform: scale(1); opacity: 0.8; }
      50% { transform: scale(1.7); opacity: 0; }
      100% { transform: scale(1); opacity: 0; }
    }
    .ph-map-node:hover, .ph-map-node-wh:hover {
      transform: scale(1.4);
      box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.35), 0 6px 16px rgba(16, 185, 129, 0.7);
    }

    /* Custom Leaflet Popup Card — High End Clean Light Aesthetic */
    .leaflet-popup-content-wrapper {
      background: #ffffff !important;
      border-radius: 18px !important;
      padding: 14px 16px !important;
      box-shadow: 0 16px 36px -6px rgba(0, 0, 0, 0.16), 0 0 1px rgba(0, 0, 0, 0.1) !important;
      border: 1px solid rgba(228, 228, 231, 0.95) !important;
      font-family: inherit !important;
    }
    .leaflet-popup-content {
      margin: 0 !important;
      line-height: 1.35 !important;
    }
    .leaflet-popup-content a {
      color: inherit !important;
      text-decoration: none !important;
    }
    .leaflet-popup-tip-container {
      margin-top: -1px;
    }
    .leaflet-popup-tip {
      background: #ffffff !important;
      box-shadow: 0 6px 12px rgba(0, 0, 0, 0.12) !important;
    }
    .leaflet-container a.leaflet-popup-close-button {
      top: 12px !important;
      right: 12px !important;
      padding: 2px 6px !important;
      color: #9ca3af !important;
      font-size: 15px !important;
      font-weight: 500 !important;
      border-radius: 50% !important;
      transition: all 0.2s ease !important;
    }
    .leaflet-container a.leaflet-popup-close-button:hover {
      color: #000000 !important;
      background: #f4f4f5 !important;
    }
  </style>

  <!-- Client JavaScript for Map & Interactions -->
  <script is:inline>
    document.addEventListener("DOMContentLoaded", function () {
      // 1. Showroom & Warehouse Location Data
      var locations = [
        // SHOWROOMS
        { id: "moa", type: "showroom", name: "SM Mall of Asia", floor: "3rd Floor, New Entertainment Mall", address: "J.W. Diokno Blvd., Pasay, Metro Manila", contact: "Anne Galicha (0965 511 2944)", lat: 14.5352, lng: 120.9822 },
        { id: "sm-north", type: "showroom", name: "SM North EDSA", floor: "Ground Floor, Interior Zone", address: "CPP 105B-106A, Interior Zone, Quezon City", contact: "Jenny Domingo (0912 415 5682)", lat: 14.6565, lng: 121.0289 },
        { id: "clark", type: "showroom", name: "Clark Cityfront Mall", floor: "3rd Floor", address: "Manuel A. Roxas Highway, Angeles, Pampanga", contact: "Justine Sendiong (0961 072 2942)", lat: 15.1684, lng: 120.5404 },
        { id: "san-fernando", type: "showroom", name: "Robinsons San Fernando", floor: "3rd Floor", address: "MacArthur Highway, San Fernando, La Union", contact: "Rasheed Manzano (0992 526 9168)", lat: 16.6093, lng: 120.3137 },
        { id: "naga", type: "showroom", name: "Robinsons Place Naga", floor: "2nd Floor", address: "Roxas Avenue corner Almeda Highway, Naga, Camarines Sur", contact: "Mary Mace Dominggo (0946 535 1460)", lat: 13.6266, lng: 123.1855 },
        { id: "feliz", type: "showroom", name: "Ayala Malls Feliz", floor: "4th Floor", address: "Amang Rodriguez Ave cor J.P. Rizal St, Pasig City", contact: "Marvin Cariaga (0966 064 6673)", lat: 14.6022, lng: 121.0978 },
        { id: "cebu", type: "showroom", name: "Ayala Center Cebu", floor: "3rd Floor", address: "Cebu Business Park, Cardinal Rosales Ave, Cebu City", contact: "Arlene Luciño (0920 201 1550)", lat: 10.3170, lng: 123.9054 },
        { id: "gensan", type: "showroom", name: "SM General Santos", floor: "2nd Floor", address: "Santiago Blvd cor San Miguel St, General Santos City", contact: "Maureen Yap (0917 133 6226)", lat: 6.1140, lng: 125.1721 },
        { id: "davao", type: "showroom", name: "SM Ecoland, Davao City", floor: "2nd Floor", address: "Quimpo Blvd cor Tulip Dr, Ecoland, Davao City", contact: "Justine Sendiong (0961 072 2942)", lat: 7.0532, lng: 125.5828 },
        { id: "tuguegarao", type: "showroom", name: "SM Tuguegarao", floor: "2nd Floor", address: "Brgy. Caritan, Tuguegarao City, Cagayan", contact: "Justine Sendiong (0961 072 2942)", lat: 17.6160, lng: 121.7269 },
        { id: "bacolod", type: "showroom", name: "SM City Bacolod", floor: "2nd Floor", address: "Rizal St, Reclamation Area, Bacolod City", contact: "Christy Dolor (0929 171 5860)", lat: 10.6649, lng: 122.9595 },
        { id: "alabang", type: "showroom", name: "Festival Mall Alabang", floor: "2nd Floor", address: "Filinvest Corporate City, Commerce Ave, Muntinlupa", contact: "Justine Sendiong (0961 072 2942)", lat: 14.4193, lng: 121.0414 },

        // WAREHOUSES
        { id: "wh-valenzuela", type: "warehouse", name: "Valenzuela Warehouse", floor: "KPC Warehouse 3", address: "Dulalia St., Valenzuela City, Metro Manila", contact: "Dannice Caraballe (0905 165 6289)", lat: 14.7011, lng: 120.9830 },
        { id: "wh-iloilo", type: "warehouse", name: "Iloilo Warehouse", floor: "Farmcon Building", address: "2012 Democracia St., Jaro, Iloilo City", contact: "Rommel Rodriguez (0910 243 0211)", lat: 10.7202, lng: 122.5621 },
        { id: "wh-bacolod", type: "warehouse", name: "Bacolod Warehouse", floor: "Gonzaga Logistics Hub", address: "82 Gonzaga St., Bacolod City, Negros Occidental", contact: "Christian Galande (0995 064 2281)", lat: 10.6765, lng: 122.9509 },
        { id: "wh-cebu", type: "warehouse", name: "Cebu Warehouse", floor: "Visayas Central Logistics", address: "Mandaue City, Cebu", contact: "Cebu Hub", lat: 10.3236, lng: 123.9223 },
        { id: "wh-davao", type: "warehouse", name: "Davao Warehouse", floor: "Mindanao Central Hub", address: "Davao City, Davao del Sur", contact: "Davao Hub", lat: 7.0731, lng: 125.6128 }
      ];

      // Default Philippines Zoom Center
      var defaultCenter = [12.8797, 121.7740];
      var defaultZoom = 6;

      // 2. Initialize Leaflet Map with smooth mobile touch options
      if (typeof L === "undefined") return;

      var map = L.map("philippines-map", {
        center: defaultCenter,
        zoom: defaultZoom,
        zoomControl: true,
        scrollWheelZoom: false,
        touchZoom: true,
        tap: true
      });

      // Use CartoDB Voyager tiles for clean vector appearance matching ZYLO theme
      L.tileLayer("https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png", {
        attribution: '&copy; <a href="https://carto.com/">CARTO</a> &copy; <a href="https://openstreetmap.org">OpenStreetMap</a>',
        subdomains: "abcd",
        maxZoom: 19
      }).addTo(map);

      // Store Marker Instance Map
      var markerMap = {};

      // 3. Create Compact Round Green Pin Markers & Clean Light Popups
      locations.forEach(function (loc) {
        var isWarehouse = loc.type === "warehouse";

        var customIcon = L.divIcon({
          className: "custom-node-wrapper",
          html: '<div class="ph-map-node"></div>',
          iconSize: [16, 16],
          iconAnchor: [8, 8],
          popupAnchor: [0, -10]
        });

        var mapsUrl = "https://www.google.com/maps?q=" + loc.lat + "," + loc.lng + "(" + encodeURIComponent(loc.name) + ")";
        var phoneOnly = loc.contact.replace(/[^0-9+]/g, '');

        // Crisp Light Mint Directions Button Popup Card
        var popupContent = `
          <div class="grid gap-2 min-w-[250px] sm:min-w-[290px] max-w-[320px] p-0.5">
            <!-- Top Micro Row -->
            <div class="flex items-center justify-between gap-2 pr-6">
              <span class="text-zinc-500 text-[11px] font-semibold">
                ${loc.floor}
              </span>
            </div>

            <!-- Title -->
            <h4 class="text-sm font-bold text-zinc-900 tracking-tight leading-snug">
              ${loc.name}
            </h4>

            <!-- Address with Location Pin Icon -->
            <div class="flex items-start gap-1.5 text-xs text-zinc-500 leading-snug">
              <svg class="h-3.5 w-3.5 text-zinc-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span>${loc.address}</span>
            </div>

            <!-- Bottom Contact & Directions Row (Crisp Light Mint Button) -->
            <div class="pt-2 border-t border-zinc-100 mt-1 flex items-center justify-between gap-2 text-xs">
              <a href="tel:${phoneOnly}" class="font-semibold text-zinc-700 hover:text-emerald-600 inline-flex items-center gap-1.5 transition-colors group">
                <svg class="h-3.5 w-3.5 text-zinc-400 group-hover:text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <span class="truncate max-w-[160px]">${loc.contact}</span>
              </a>
              <a href="${mapsUrl}" target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 rounded-lg bg-zinc-950 hover:bg-zinc-800 border border-zinc-800 text-white text-[11px] font-bold tracking-wide transition-all shrink-0 flex items-center gap-1.5 shadow-xs group cursor-pointer">
                <span class="text-white font-bold">Directions</span>
                <svg class="h-3 w-3 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>
          </div>
        `;

        var marker = L.marker([loc.lat, loc.lng], { icon: customIcon }).addTo(map);
        marker.bindPopup(popupContent);
        markerMap[loc.name.toLowerCase()] = marker;
      });

      // Reset Map View Button
      var resetBtn = document.getElementById("reset-map-view");
      if (resetBtn) {
        resetBtn.addEventListener("click", function () {
          map.flyTo(defaultCenter, defaultZoom, { duration: 1.2 });
          map.closePopup();
        });
      }

      // 4. Tab Switcher Logic
      var tabShowrooms = document.getElementById("tab-showrooms");
      var tabWarehouses = document.getElementById("tab-warehouses");
      var panelShowrooms = document.getElementById("panel-showrooms");
      var panelWarehouses = document.getElementById("panel-warehouses");

      if (tabShowrooms && tabWarehouses && panelShowrooms && panelWarehouses) {
        tabShowrooms.addEventListener("click", function () {
          tabShowrooms.classList.add("bg-white", "text-brand-black", "shadow-sm");
          tabShowrooms.classList.remove("text-zinc-500");
          tabWarehouses.classList.remove("bg-white", "text-brand-black", "shadow-sm");
          tabWarehouses.classList.add("text-zinc-500");

          panelShowrooms.classList.remove("hidden");
          panelWarehouses.classList.add("hidden");
        });

        tabWarehouses.addEventListener("click", function () {
          tabWarehouses.classList.add("bg-white", "text-brand-black", "shadow-sm");
          tabWarehouses.classList.remove("text-zinc-500");
          tabShowrooms.classList.remove("bg-white", "text-brand-black", "shadow-sm");
          tabShowrooms.classList.add("text-zinc-500");

          panelWarehouses.classList.remove("hidden");
          panelShowrooms.classList.add("hidden");
        });
      }

      // 5. Card Click $\to$ Focus Node on Map
      document.querySelectorAll(".showroom-card, .warehouse-card").forEach(function (card) {
        card.addEventListener("click", function (e) {
          if (e.target.closest("a")) return; // Don't intercept direct phone links

          var lat = parseFloat(card.getAttribute("data-lat"));
          var lng = parseFloat(card.getAttribute("data-lng"));
          var name = (card.getAttribute("data-name") || "").toLowerCase();

          if (lat && lng) {
            map.flyTo([lat, lng], 13, { duration: 1.2 });
            var targetMarker = markerMap[name];
            if (targetMarker) {
              setTimeout(function () {
                targetMarker.openPopup();
              }, 1200);
            }
            // Smooth scroll to map on mobile
            if (window.innerWidth < 1024) {
              document.getElementById("showrooms")?.scrollIntoView({ behavior: "smooth" });
            }
          }
        });
      });

      // 6. Contact Form Logic
      var contactForm = document.getElementById("contact-form");
      var successToast = document.getElementById("contact-success-toast");

      if (contactForm && successToast) {
        contactForm.addEventListener("submit", function (e) {
          e.preventDefault();
          successToast.classList.remove("hidden");
          contactForm.reset();
          setTimeout(function () {
            successToast.classList.add("hidden");
          }, 6000);
        });
      }
    });
  </script>
</Layout>
