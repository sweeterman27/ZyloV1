            <!-- 6. Ayala Malls Feliz -->
            <article data-lat="14.6022" data-lng="121.0978" data-name="Ayala Malls Feliz" class="showroom-card flex flex-col sm:flex-row items-start sm:items-center gap-3.5 p-3.5 sm:p-4 rounded-2xl border border-zinc-200 bg-white hover:border-brand-mint/50 hover:shadow-md transition-all group cursor-pointer touch-manipulation">
