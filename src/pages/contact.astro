                <div class="pt-1.5 border-t border-zinc-100 flex items-center justify-between text-xs min-h-[36px]">
                  <a href="tel:09124155682" class="font-semibold text-zinc-700 hover:text-brand-mint inline-flex items-center gap-1.5 py-1">
                    <svg class="h-3.5 w-3.5 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                    <span class="truncate">Jenny Domingo — 0912 415 5682</span>
                  </a>
                </div>
              </div>
            </article>

            <!-- 3. Clark Cityfront Mall -->
            <article data-lat="15.1684" data-lng="120.5404" data-name="Clark Cityfront Mall" class="showroom-card flex flex-col sm:flex-row items-start sm:items-center gap-3.5 p-3.5 sm:p-4 rounded-2xl border border-zinc-200 bg-white hover:border-brand-mint/50 hover:shadow-md transition-all group cursor-pointer touch-manipulation">
              <div class="w-full sm:w-24 h-14 sm:h-16 shrink-0 rounded-xl bg-zinc-100 border border-zinc-200/80 flex flex-row sm:flex-col items-center justify-center gap-2 sm:gap-1 p-1.5 group-hover:bg-zinc-200/60 transition-colors">
                <svg class="h-4 w-4 sm:h-5 sm:w-5 text-zinc-400 stroke-[1.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0h4m-4 0V11m0 0V5" />
                </svg>
                <span class="text-[9px] font-mono uppercase text-zinc-400 font-semibold tracking-tighter">Showroom</span>
              </div>
              <div class="grid gap-1 min-w-0 flex-1 w-full">
                <div class="flex items-center justify-between gap-2">
                  <h3 class="text-sm font-bold tracking-tight text-brand-black group-hover:text-brand-mint transition-colors truncate">
                    Clark Cityfront Mall
                  </h3>
                  <span class="text-[10px] font-semibold text-brand-mint uppercase tracking-wider shrink-0">3rd Floor</span>
                </div>
                <p class="text-xs text-zinc-600 truncate leading-snug">
                  Manuel A. Roxas Highway, Angeles, Pampanga
                </p>
                <div class="pt-1.5 border-t border-zinc-100 flex items-center justify-between text-xs min-h-[36px]">
                  <a href="tel:09610722942" class="font-semibold text-zinc-700 hover:text-brand-mint inline-flex items-center gap-1.5 py-1">
                    <svg class="h-3.5 w-3.5 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                    <span class="truncate">Justine Sendiong — 0961 072 2942</span>
                  </a>
                </div>
              </div>
            </article>

            <!-- 4. Robinsons San Fernando -->
            <article data-lat="16.6093" data-lng="120.3137" data-name="Robinsons San Fernando" class="showroom-card flex flex-col sm:flex-row items-start sm:items-center gap-3.5 p-3.5 sm:p-4 rounded-2xl border border-zinc-200 bg-white hover:border-brand-mint/50 hover:shadow-md transition-all group cursor-pointer touch-manipulation">
