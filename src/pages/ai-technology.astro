---
import Layout from "../layouts/Layout.astro";

const techSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": "The AI Computer Vision & Digital Resistance Technology Behind ZYLO AI",
  "description": "Discover how ZYLO AI combines real-time posture mapping, computer vision joint tracking, and motorized digital resistance for optimal strength and form.",
  "name": "ZYLO AI Computer Vision & Fitness Motion Tracking",
  "publisher": {
    "@type": "Organization",
    "name": "ZYLO AI",
    "logo": "https://zylowebsite.pages.dev/favicon.svg"
  }
};
---

<Layout
  title="AI Motion Tracking & Digital Resistance Technology | ZYLO AI"
  description="Discover how ZYLO AI uses real-time computer vision, joint angle mapping, and motor-driven digital resistance to transform home fitness."
  canonical="/ai-technology"
  schema={techSchema}
>


  <!-- ─── SECTION 1: THE TECHNOLOGY OF ZYLO AI ──────────────────── -->
  <section class="bg-white py-12 lg:py-[80px] border-b border-brand-midGray/60">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      
      <!-- Top Section Header -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-start mb-12 lg:mb-16">
        <!-- Left Title -->
        <div class="lg:col-span-7">
          <h1 class="font-display font-extrabold text-2xl sm:text-3xl lg:text-3xl xl:text-4xl text-brand-black leading-[1.2] uppercase tracking-tight">
            THE TECHNOLOGY<br/>OF <span class="text-brand-mint">ZYLO AI</span>
          </h1>
        </div>
        
        <!-- Right Explainer Description -->
        <div class="lg:col-span-5 lg:pt-2">
          <p class="text-sm sm:text-base text-zinc-600 font-medium leading-relaxed">
            Advanced intelligence, precision tracking, and smart resistance—engineered to bring elite training and wellness performance into the home.
          </p>
        </div>
      </div>

      <!-- Feature Cards Carousel / Grid -->
      <div class="relative">
        <div 
          id="tech-cards-track"
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 transition-all duration-300"
        >
          {[
            {
              id: "motion-tracking",
              title: "AI Motion Tracking",
              desc: "42-point skeletal tracking for real-time posture and movement analysis.",
              iconPath: "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
            },
            {
              id: "digital-resistance",
              title: "Digital Resistance",
              desc: "Smooth, precise resistance that adapts to your strength and training style.",
              iconPath: "M4 6h16M4 12h16M4 18h16"
            },
            {
              id: "performance-analytics",
              title: "Smart Performance Analytics",
              desc: "Detailed workout data, body insights, and progress metrics after every session.",
              iconPath: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
            },
            {
              id: "auto-fold",
              title: "Compact Auto-Fold Design",
              desc: "A space-saving system that folds neatly for modern homes.",
              iconPath: "M4 5a1 1 0 011-1h14a1 1 0 011 1v14a1 1 0 01-1 1H5a1 1 0 01-1-1V5z"
            }
          ].map((card, idx) => (
            <div class="flex flex-col rounded-3xl bg-white border border-brand-midGray/80 overflow-hidden shadow-sm hover:shadow-md hover:border-brand-mint/60 transition-all duration-300 group">
              
              <!-- Top Image Container (Placeholder) -->
              <div class="relative aspect-[4/5] w-full bg-brand-lightGray border-b border-brand-midGray/60 flex flex-col items-center justify-center p-6 select-none overflow-hidden group-hover:bg-zinc-100/80 transition-colors">
                <div class="absolute inset-0 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:20px_20px] opacity-40"></div>
                
                <!-- Placeholder Icon & Badge -->
                <div class="relative z-10 flex flex-col items-center text-center gap-3">
                  <div class="w-16 h-16 rounded-2xl bg-white border border-zinc-200 shadow-sm flex items-center justify-center text-zinc-400 group-hover:border-brand-mint group-hover:text-brand-mint transition-colors">
                    <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                  </div>
                  <span class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Image Placeholder</span>
                </div>

                <span class="absolute top-4 left-4 text-[9px] font-mono text-zinc-400 uppercase tracking-widest bg-white/80 backdrop-blur px-2.5 py-1 rounded-md border border-zinc-200/60">
                  Feature 0{idx + 1}
                </span>
              </div>

              <!-- Bottom Content Area -->
              <div class="p-6 bg-white flex items-start gap-4">
                <!-- Custom Green Icon -->
                <div class="w-10 h-10 rounded-xl bg-brand-mint/10 border border-brand-mint/30 flex items-center justify-center text-brand-mint shrink-0 mt-0.5">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d={card.iconPath} />
                  </svg>
                </div>

                <!-- Text Block -->
                <div class="flex flex-col">
                  <h3 class="font-display font-bold text-base sm:text-lg text-brand-black leading-snug">
                    {card.title}
                  </h3>
                  <p class="text-xs text-zinc-500 font-medium leading-relaxed mt-1.5">
                    {card.desc}
                  </p>
                </div>
              </div>

            </div>
          ))}
        </div>

      </div>

    </div>
  </section>

  <!-- ─── SECTION 2: YOUR BODY. YOUR DATA. YOUR BEST VERSION. ─── -->
  <section class="bg-white py-12 lg:py-[80px] border-b border-brand-midGray/60">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      
      <!-- Section Title & Subhead -->
      <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
        <h2 class="font-display font-extrabold text-2xl sm:text-3xl lg:text-4xl text-brand-black leading-[1.2] uppercase tracking-tight">
          YOUR BODY. YOUR DATA. <span class="text-brand-mint">YOUR BEST VERSION.</span>
        </h2>
        <p class="text-xs sm:text-sm text-zinc-500 font-medium leading-relaxed mt-4 max-w-2xl mx-auto">
          Advanced AI technology scans, analyzes, and tracks your body in real time, delivering personalized insights that help you train smarter, move better, and achieve measurable results.
        </p>
      </div>

      <!-- Panoramic Body Scanner Visual Container -->
      <div class="relative w-full rounded-3xl overflow-hidden border border-brand-midGray/80 bg-zinc-950 shadow-xl group">
        <div class="relative aspect-[16/8] sm:aspect-[21/9] w-full overflow-hidden select-none">
          <img src="/assets/ai-technology/body-scanner.webp"
            alt="ZYLO AI Real-Time 3D Body Scanner & Data Hologram Analysis"
            class="w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-[1.02]"
            loading="lazy" decoding="async" />
          
          <!-- Subtle vignette gradient overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/60 via-transparent to-zinc-950/20 pointer-events-none"></div>

          <!-- Top Status Tag -->
          <div class="absolute top-4 left-4 sm:top-6 sm:left-6 z-10">
            <span class="inline-flex items-center gap-2 rounded-full bg-zinc-950/80 backdrop-blur-md px-3 py-1 sm:px-4 sm:py-1.5 text-[9px] sm:text-[10px] font-mono text-white uppercase tracking-widest border border-white/10">
              <span class="h-2 w-2 rounded-full bg-brand-mint animate-pulse"></span>
              Real-Time AI Scan Active
            </span>
          </div>

          <!-- Bottom Live Metric Badges -->
          <div class="absolute bottom-4 left-4 right-4 sm:bottom-6 sm:left-6 sm:right-6 z-10 flex flex-wrap items-center justify-between gap-3 pointer-events-none">
            <div class="flex items-center gap-2 sm:gap-3">
              <div class="rounded-xl bg-zinc-950/80 backdrop-blur-md border border-white/10 px-3 py-2 text-white">
                <span class="block text-[8px] sm:text-[9px] font-mono text-zinc-400 uppercase tracking-widest">Muscle Balance</span>
                <span class="font-display font-bold text-xs sm:text-sm text-brand-mint">82% Optimal</span>
              </div>
              <div class="rounded-xl bg-zinc-950/80 backdrop-blur-md border border-white/10 px-3 py-2 text-white">
                <span class="block text-[8px] sm:text-[9px] font-mono text-zinc-400 uppercase tracking-widest">Posture Score</span>
                <span class="font-display font-bold text-xs sm:text-sm text-brand-mint">76% Perfect</span>
              </div>
            </div>

            <div class="hidden md:flex items-center gap-3">
              <div class="rounded-xl bg-zinc-950/80 backdrop-blur-md border border-white/10 px-3 py-2 text-white">
                <span class="block text-[8px] sm:text-[9px] font-mono text-zinc-400 uppercase tracking-widest">Joint Alignment</span>
                <span class="font-display font-bold text-xs sm:text-sm text-brand-mint">92% Precision</span>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

</Layout>
