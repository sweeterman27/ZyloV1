const { article } = Astro.props;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": article.title,
  "description": article.excerpt || article.summary,
  "author": {
    "@type": "Person",
    "name": article.author
  },
  "publisher": {
    "@type": "Organization",
    "name": "ZYLO AI",
    "logo": {
      "@type": "ImageObject",
      "url": "https://zylowebsite.pages.dev/favicon.svg"
    }
  },
  "datePublished": article.date,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://zylowebsite.pages.dev/blog/${article.slug}`
  }
};
