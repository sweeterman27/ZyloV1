        <script>
          (function () {
            var pK1 = document.getElementById('mob-p-k1');
            var pS1 = document.getElementById('mob-p-s1');
            var tK1 = document.getElementById('mob-toggle-k1');
            var tS1 = document.getElementById('mob-toggle-s1');
            var pill = document.getElementById('mob-toggle-pill');
            if (!pK1 || !pS1) return;

            var activeIndex = 0; // 0 = K1, 1 = S1

            function selectProduct(index) {
              activeIndex = index;
              if (index === 0) {
                pK1.style.opacity = '1';
                pK1.style.transform = 'translateY(0) scale(1)';
                pK1.style.filter = 'blur(0px)';
                pK1.style.pointerEvents = '';

                pS1.style.opacity = '0';
                pS1.style.transform = 'translateY(16px) scale(0.96)';
                pS1.style.filter = 'blur(4px)';
                pS1.style.pointerEvents = 'none';

                if (pill) pill.style.transform = 'translateX(0%)';
                if (tK1) { tK1.style.color = '#ffffff'; tK1.style.fontWeight = '700'; }
                if (tS1) { tS1.style.color = '#71717a'; tS1.style.fontWeight = '600'; }
              } else {
                pS1.style.opacity = '1';
                pS1.style.transform = 'translateY(0) scale(1)';
                pS1.style.filter = 'blur(0px)';
                pS1.style.pointerEvents = '';

                pK1.style.opacity = '0';
                pK1.style.transform = 'translateY(16px) scale(0.96)';
                pK1.style.filter = 'blur(4px)';
                pK1.style.pointerEvents = 'none';

                if (pill) pill.style.transform = 'translateX(100%)';
                if (tS1) { tS1.style.color = '#ffffff'; tS1.style.fontWeight = '700'; }
                if (tK1) { tK1.style.color = '#71717a'; tK1.style.fontWeight = '600'; }
              }
            }

            if (tK1) tK1.addEventListener('click', function() { selectProduct(0); });
            if (tS1) tS1.addEventListener('click', function() { selectProduct(1); });

            // Touch swipe gesture support
            var touchStartX = 0;
            var touchStartY = 0;
            var vp = document.getElementById('mob-showcase-vp');
            if (vp) {
              vp.addEventListener('touchstart', function(e) {
                if (e.touches.length === 1) {
                  touchStartX = e.touches[0].clientX;
                  touchStartY = e.touches[0].clientY;
                }
              }, { passive: true });
              vp.addEventListener('touchend', function(e) {
                if (e.changedTouches.length === 1) {
                  var diffX = e.changedTouches[0].clientX - touchStartX;
                  var diffY = e.changedTouches[0].clientY - touchStartY;
                  // Horizontal swipe detection
                  if (Math.abs(diffX) > 40 && Math.abs(diffX) > Math.abs(diffY)) {
                    if (diffX < 0 && activeIndex === 0) {
                      selectProduct(1); // Swipe left -> S1 PRO
                    } else if (diffX > 0 && activeIndex === 1) {
                      selectProduct(0); // Swipe right -> K1
                    }
                  }
                }
              }, { passive: true });
            }

            selectProduct(0);
          })();
        </script>

