---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="ZYLO AI — World's Most Advanced AI Smart Home Gym"
  description="Experience the world's most advanced AI-powered home gym. Personalized workouts, real-time posture scan, form coaching, and adaptive digital resistance."
  canonical="/"
>
  <!-- Hero Section with Full-Bleed Video/Photo Background -->
  <section
    class="relative w-full overflow-hidden bg-zinc-950 min-h-[84dvh] sm:min-h-[88dvh] lg:min-h-[calc(100vh-4rem)] flex items-end pb-0 pt-4 sm:pt-8 lg:pt-[80px]"
    aria-labelledby="hero-heading"
  >
    <!-- Background Media Overlay (Hero Carousel Slides) -->
    <div
      id="carousel-container"
      class="absolute -inset-x-1 inset-y-0 w-[calc(100%+8px)] -left-1 h-full select-none pointer-events-none z-0 overflow-hidden"
    >
      <!-- Slide 1 (Active Video) -->
      <div
        class="carousel-slide absolute inset-0 w-full h-full opacity-100 transition-opacity duration-700 ease-in-out"
      >
        <!-- Mobile Video (< lg) -->
        <video
          src="/assets/homepage/hero/Zylo%20Hero%201%20-%20mobile.mp4"
          autoplay
          loop
          muted
          playsinline
          preload="auto"
          class="w-full h-full object-cover object-center lg:hidden"
        ></video>
        <!-- Desktop Video (lg+) -->
        <video
          src="/assets/homepage/hero/Zylo%20Hero%201.mp4"
          autoplay
          loop
          muted
          playsinline
          preload="auto"
          class="hidden lg:block w-full h-full object-cover object-[68%_center]"
        ></video>
      </div>

      <!-- Slide 2 (Video) -->
      <div
        class="carousel-slide absolute inset-0 w-full h-full opacity-0 pointer-events-none transition-opacity duration-700 ease-in-out"
      >
        <!-- Mobile Video (< lg) -->
        <video
          src="/assets/homepage/hero/Zylo%20Hero%202%20-%20mobile.mp4"
          autoplay
          loop
          muted
          playsinline
          preload="none"
          class="w-full h-full object-cover object-center lg:hidden"
        ></video>
        <!-- Desktop Video (lg+) -->
        <video
          src="/assets/homepage/hero/Zylo%20Hero%202.mp4"
          autoplay
          loop
          muted
          playsinline
          preload="none"
          class="hidden lg:block w-full h-full object-cover object-[68%_center]"
        ></video>
      </div>

      <!-- Slide 3 (Hero Photo: Zylo Hero 3.webp) -->
      <div
        class="carousel-slide absolute inset-0 w-full h-full opacity-0 pointer-events-none transition-opacity duration-700 ease-in-out"
      >
        <img src="/assets/homepage/hero/Zylo%20Hero%203.webp"
          width="1920"
          height="960"
          alt="ZYLO AI Smart Home Gym training"
          class="w-full h-full object-cover object-[78%_center] lg:object-[72%_center]"
          loading="lazy" decoding="async" />
      </div>

      <!-- ── Ultra-Soft Seamless Left Gradient Scrim (Blended wide gradual fade for desktop text) ── -->
      <div
        class="hidden lg:block absolute inset-y-0 left-0 w-[62%] bg-gradient-to-r from-white/95 via-white/75 via-[48%] to-transparent pointer-events-none z-10"
      >
      </div>

      <!-- Mobile Centered Dark Scrim Overlay (Bottom-focused fade ensuring top ZYLO AI watermark stays bright & clear) -->
      <div
        class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/60 via-[48%] to-transparent lg:hidden pointer-events-none z-10"
      >
      </div>
    </div>

    <!-- Hero Content Container (Anchored at the very bottom) -->
    <div
      class="relative z-20 mx-auto max-w-7xl px-5 sm:px-8 w-full h-full flex flex-col justify-end items-center lg:items-start pb-2 sm:pb-3 lg:pb-3 pt-0"
    >
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 w-full items-end">
        <!-- ZLEEP Centered Mobile Content Stack -->
        <div
          class="col-span-1 lg:col-span-6 flex flex-col justify-end items-center lg:items-start text-center lg:text-left py-0 relative mt-0 sm:mt-1 lg:mt-1"
        >
          <div class="flex flex-col items-center lg:items-start w-full">

            <h1
              id="hero-heading"
              class="font-display text-2xl font-extrabold text-white lg:text-zinc-950 sm:text-3xl lg:text-3xl xl:text-4xl leading-[1.25] mb-4 sm:mb-5 max-w-md lg:max-w-lg mx-auto lg:mx-0 text-center lg:text-left tracking-tight transition-opacity duration-300 drop-shadow-sm lg:drop-shadow-none"
            >
              Your AI Coach at Home for <span class="text-emerald-400 lg:text-emerald-600 font-extrabold">300+ Workouts</span>, 400+ Movements, &amp; Smarter Training
            </h1>

            <p
              id="hero-subheading"
              class="text-xs sm:text-sm font-medium text-zinc-200 lg:text-zinc-600 max-w-xs sm:max-w-md mx-auto lg:mx-0 text-center lg:text-left mb-4 sm:mb-5 leading-relaxed transition-opacity duration-300"
            >
              Personalized workouts, real-time posture scan &amp; adaptive digital resistance in one ultra-compact mirror.
            </p>

            <!-- Headline CTA: Side by Side Container -->
            <div class="flex flex-row items-center justify-center lg:justify-start gap-3 sm:gap-4 w-full">
              <!-- Primary CTA: Shop ZYLO K1 -->
              <a
                href="/products/zylo-k1"
                class="group inline-flex items-center justify-center gap-2 px-4 sm:px-5 py-2.5 border border-white/20 lg:border-brand-black bg-brand-black hover:bg-neutral-800 text-white text-xs tracking-wider uppercase transition-all duration-300 shadow-sm cursor-pointer whitespace-nowrap"
              >
                <span class="h-1.5 w-1.5 rounded-full bg-brand-mint shrink-0"></span>
                <span>Shop ZYLO K1</span>
                <svg
                  class="h-3 w-3 text-brand-mint group-hover:translate-x-1 transition-transform duration-300"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Right Column: Empty spacer -->
        <div class="hidden lg:block lg:col-span-6 h-auto"></div>
      </div>
    </div>

    <!-- Left & Right Arrow Navigators -->
    <button
      type="button"
      id="hero-prev-btn"
      class="absolute left-2 sm:left-6 top-1/2 -translate-y-1/2 z-30 p-2 text-emerald-400 hover:text-emerald-300 lg:text-emerald-500 bg-transparent border-none flex items-center justify-center transition-all duration-300 hover:scale-125 active:scale-95 focus:outline-none cursor-pointer group"
      aria-label="Previous slide"
    >
      <svg class="h-7 w-7 sm:h-9 sm:w-9 text-emerald-400 lg:text-emerald-500 group-hover:text-emerald-300 transition-transform duration-300 group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <button
      type="button"
      id="hero-next-btn"
      class="absolute right-2 sm:right-6 top-1/2 -translate-y-1/2 z-30 p-2 text-emerald-400 hover:text-emerald-300 lg:text-emerald-500 bg-transparent border-none flex items-center justify-center transition-all duration-300 hover:scale-125 active:scale-95 focus:outline-none cursor-pointer group"
      aria-label="Next slide"
    >
      <svg class="h-7 w-7 sm:h-9 sm:w-9 text-emerald-400 lg:text-emerald-500 group-hover:text-emerald-300 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    <!-- Carousel Pill Indicators (Universal View: Sleek Thinner Pill Capsule with Dynamic Filling Progress Bar) -->
    <div
      class="absolute bottom-3 sm:bottom-4 lg:bottom-6 left-1/2 -translate-x-1/2 z-30 flex items-center gap-2 sm:gap-2.5 px-3 py-1.5 rounded-full bg-zinc-950/85 backdrop-blur-md border border-white/20 shadow-xl shadow-black/60"
      aria-label="Carousel Progress"
    >
      <button
        type="button"
        class="carousel-dot group relative h-[3.5px] sm:h-[4px] w-8 sm:w-10 rounded-full bg-white/20 overflow-hidden transition-all duration-300 focus:outline-none cursor-pointer"
        aria-label="Go to slide 1">
        <span class="dot-progress absolute inset-y-0 left-0 bg-brand-mint shadow-[0_0_10px_rgba(52,211,153,0.9)] rounded-full w-0"></span>
      </button>
      <button
        type="button"
        class="carousel-dot group relative h-[3.5px] sm:h-[4px] w-4 sm:w-5 rounded-full bg-white/20 overflow-hidden transition-all duration-300 focus:outline-none cursor-pointer"
        aria-label="Go to slide 2">
        <span class="dot-progress absolute inset-y-0 left-0 bg-brand-mint shadow-[0_0_10px_rgba(52,211,153,0.9)] rounded-full w-0"></span>
      </button>
      <button
        type="button"
        class="carousel-dot group relative h-[3.5px] sm:h-[4px] w-4 sm:w-5 rounded-full bg-white/20 overflow-hidden transition-all duration-300 focus:outline-none cursor-pointer"
        aria-label="Go to slide 3">
        <span class="dot-progress absolute inset-y-0 left-0 bg-brand-mint shadow-[0_0_10px_rgba(52,211,153,0.9)] rounded-full w-0"></span>
      </button>
    </div>
  </section>

  <!-- Section 2: Complete AI Workout Library -->
  <section
    class="py-12 lg:py-[80px] bg-[#F8FAFC] w-full"
    aria-labelledby="library-heading"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="text-center mb-8 sm:mb-16 max-w-2xl mx-auto">
        <h2
          id="library-heading"
          class="font-display text-xl sm:text-4xl font-semibold sm:font-extrabold text-brand-black tracking-tight mb-2 sm:mb-4 max-w-[280px] sm:max-w-none mx-auto leading-snug sm:leading-tight"
        >
          Your Complete AI Workout Library
        </h2>
        <p class="font-display text-xs sm:text-lg text-zinc-500 font-medium max-w-[280px] sm:max-w-none mx-auto leading-relaxed mb-6 sm:mb-8">
          Your workout adapts to how you move, train, and progress.
        </p>
          <!-- MOBILE: Clean Vertical 2×4 grid — Icon + Title side-by-side Top, Dedicated Media Container Bottom -->
      <div class="grid grid-cols-2 gap-3.5 md:hidden">
        <!-- Card 1: Strength -->
        <div
          class="group relative overflow-hidden rounded-2xl border border-zinc-200/80 bg-white p-3.5 sm:p-4 flex flex-col justify-between h-auto w-full hover:shadow-md transition-all duration-200 cursor-pointer"
        >
          <div class="w-full">
            <div class="flex items-center gap-2.5 mb-2">
              <div
                class="w-7 h-7 rounded-lg bg-[#ebf7f4] flex items-center justify-center shrink-0 border border-emerald-100/70"
              >
                <img src="assets/REVAMPED/revamp website_/home page/assets/barbel.webp"
                  alt="Strength icon"
                  class="h-3.5 w-3.5 object-contain"
                decoding="async" loading="lazy" />
              </div>
              <h3 class="font-display text-sm font-bold text-brand-black leading-tight">
                Strength
              </h3>
            </div>
            <p class="text-[10px] text-zinc-500 leading-snug text-left">
              Build muscle &amp; get stronger with AI.
            </p>
          </div>
          <div
            class="w-full aspect-[16/10] rounded-xl overflow-hidden relative mt-2.5"
          >
            <img src="/assets/REVAMPED/revamp%20website_/home%20page/assets/png%20file-w/zylo/GIFs/deadlift-anim.webp"
              data-gif="/assets/REVAMPED/revamp%20website_/home%20page/assets/png%20file-w/zylo/GIFs/deadlift-anim.webp"
              alt="Strength athlete"
              class="workout-gif w-full h-full object-cover object-center absolute inset-0"
              loading="lazy" decoding="async" />
          </div>
        </div>

        <!-- Card 2: Cardio -->
        <div
          class="group relative overflow-hidden rounded-2xl border border-zinc-200/80 bg-white p-3.5 sm:p-4 flex flex-col justify-between h-auto w-full hover:shadow-md transition-all duration-200 cursor-pointer"
        >
          <div class="w-full">
            <div class="flex items-center gap-2.5 mb-2">
              <div
                class="w-7 h-7 rounded-lg bg-[#ebf7f4] flex items-center justify-center shrink-0 border border-emerald-100/70"
              >
                <img src="assets/REVAMPED/revamp website_/home page/assets/heart-rate.webp"
                  alt="Cardio icon"
                  class="h-3.5 w-3.5 object-contain"
                decoding="async" loading="lazy" />
              </div>
              <h3 class="font-display text-sm font-bold text-brand-black leading-tight">
                Cardio
              </h3>
            </div>
            <p class="text-[10px] text-zinc-500 leading-snug text-left">
              Smart calorie &amp; endurance tracking.
            </p>
          </div>
          <div
            class="w-full aspect-[16/10] rounded-xl overflow-hidden relative mt-2.5"
          >
            <img src="/assets/REVAMPED/revamp%20website_/home%20page/assets/png%20file-w/zylo/GIFs/jogging-anim.webp"
              data-gif="/assets/REVAMPED/revamp%20website_/home%20page/assets/png%20file-w/zylo/GIFs/jogging-anim.webp"
              alt="Cardio athlete"
              class="workout-gif w-full h-full object-cover object-center absolute inset-0"
              loading="lazy" decoding="async" />
          </div>
        </div>

        <!-- Card 3: Yoga -->
        <div
          class="group relative overflow-hidden rounded-2xl border border-zinc-200/80 bg-white p-3.5 sm:p-4 flex flex-col justify-between h-auto w-full hover:shadow-md transition-all duration-200"
        >
          <div class="w-full">
            <div class="flex items-center gap-2.5 mb-2">
              <div
                class="w-7 h-7 rounded-lg bg-[#ebf7f4] flex items-center justify-center shrink-0 border border-emerald-100/70"
              >
                <img src="assets/REVAMPED/revamp website_/home page/assets/lotus-2.webp"
                  alt="Yoga icon"
                  class="h-3.5 w-3.5 object-contain"
                decoding="async" loading="lazy" />
              </div>
              <h3 class="font-display text-sm font-bold text-brand-black leading-tight">
                Yoga
              </h3>
            </div>
            <p class="text-[10px] text-zinc-500 leading-snug text-left">
              Flexibility &amp; mind-body balance.
            </p>
          </div>
          <div
            class="w-full aspect-[16/10] rounded-xl overflow-hidden relative mt-2.5"
          >
            <img src="/assets/REVAMPED/revamp%20website_/home%20page/assets/png%20file-w/zylo/GIFs/meditation-anim.webp"
              data-gif="/assets/REVAMPED/revamp%20website_/home%20page/assets/png%20file-w/zylo/GIFs/meditation-anim.webp"
              alt="Yoga athlete"
              class="workout-gif w-full h-full object-cover object-center absolute inset-0"
              loading="lazy" decoding="async" />
          </div>
        </div>

        <!-- Card 4: Pilates -->
        <div
          class="group relative overflow-hidden rounded-2xl border border-zinc-200/80 bg-white p-3.5 sm:p-4 flex flex-col justify-between h-auto w-full hover:shadow-md transition-all duration-200"
        >
          <div class="w-full">
            <div class="flex items-center gap-2.5 mb-2">
              <div
                class="w-7 h-7 rounded-lg bg-[#ebf7f4] flex items-center justify-center shrink-0 border border-emerald-100/70"
              >
                <img src="assets/REVAMPED/revamp website_/home page/assets/pilates.webp"
                  alt="Pilates icon"
                  class="h-3.5 w-3.5 object-contain"
                decoding="async" loading="lazy" />
              </div>
              <h3 class="font-display text-sm font-bold text-brand-black leading-tight">
                Pilates
              </h3>
            </div>
            <p class="text-[10px] text-zinc-500 leading-snug text-left">
              Core strength &amp; posture control.
            </p>
          </div>
          <div
            class="w-full aspect-[16/10] rounded-xl overflow-hidden relative mt-2.5"
          >
            <img src="/assets/REVAMPED/revamp%20website_/home%20page/assets/png%20file-w/zylo/GIFs/pilates-anim.webp"
              data-gif="/assets/REVAMPED/revamp%20website_/home%20page/assets/png%20file-w/zylo/GIFs/pilates-anim.webp"
              alt="Pilates athlete"
              class="workout-gif w-full h-full object-cover object-center absolute inset-0"
              loading="lazy" decoding="async" />
          </div>
        </div>

        <!-- Card 5: Boxing -->
        <div
          class="group relative overflow-hidden rounded-2xl border border-zinc-200/80 bg-white p-3.5 sm:p-4 flex flex-col justify-between h-auto w-full hover:shadow-md transition-all duration-200 cursor-pointer"
        >
          <div class="w-full">
            <div class="flex items-center gap-2.5 mb-2">
              <div
                class="w-7 h-7 rounded-lg bg-[#ebf7f4] flex items-center justify-center shrink-0 border border-emerald-100/70"
              >
                <img src="assets/REVAMPED/revamp website_/home page/assets/boxing-gloves.webp"
                  alt="Boxing icon"
                  class="h-3.5 w-3.5 object-contain"
                decoding="async" loading="lazy" />
              </div>
              <h3 class="font-display text-sm font-bold text-brand-black leading-tight">
                Boxing
              </h3>
            </div>
            <p class="text-[10px] text-zinc-500 leading-snug text-left">
              Power, speed &amp; agility training.
            </p>
          </div>
          <div
            class="w-full aspect-[16/10] rounded-xl overflow-hidden relative mt-2.5"
          >
            <img src="/assets/REVAMPED/revamp%20website_/home%20page/assets/png%20file-w/zylo/GIFs/boxing-anim.webp"
              data-gif="/assets/REVAMPED/revamp%20website_/home%20page/assets/png%20file-w/zylo/GIFs/boxing-anim.webp"
              alt="Boxing athlete"
              class="workout-gif w-full h-full object-cover object-center absolute inset-0"
              loading="lazy" decoding="async" />
          </div>
        </div>

        <!-- Card 6: Mobility -->
        <div
          class="group relative overflow-hidden rounded-2xl border border-zinc-200/80 bg-white p-3.5 sm:p-4 flex flex-col justify-between h-auto w-full hover:shadow-md transition-all duration-200"
        >
          <div class="w-full">
            <div class="flex items-center gap-2.5 mb-2">
              <div
                class="w-7 h-7 rounded-lg bg-[#ebf7f4] flex items-center justify-center shrink-0 border border-emerald-100/70"
              >
                <img src="assets/REVAMPED/revamp website_/home page/assets/yoga-2.webp"
                  alt="Mobility icon"
                  class="h-3.5 w-3.5 object-contain"
                decoding="async" loading="lazy" />
              </div>
              <h3 class="font-display text-sm font-bold text-brand-black leading-tight">
                Mobility
              </h3>
            </div>
            <p class="text-[10px] text-zinc-500 leading-snug text-left">
              Guided routines to improve movement.
            </p>
          </div>
          <div
            class="w-full aspect-[16/10] rounded-xl overflow-hidden relative mt-2.5"
          >
            <img src="/assets/REVAMPED/revamp%20website_/home%20page/assets/png%20file-w/zylo/GIFs/worlds-greatest-anim.webp"
              data-gif="/assets/REVAMPED/revamp%20website_/home%20page/assets/png%20file-w/zylo/GIFs/worlds-greatest-anim.webp"
              alt="Mobility athlete"
              class="workout-gif w-full h-full object-cover object-center absolute inset-0"
              loading="lazy" decoding="async" />
          </div>
        </div>

        <!-- Card 7: Stretch -->
        <div
          class="group relative overflow-hidden rounded-2xl border border-zinc-200/80 bg-white p-3.5 sm:p-4 flex flex-col justify-between h-auto w-full hover:shadow-md transition-all duration-200"
        >
          <div class="w-full">
            <div class="flex items-center gap-2.5 mb-2">
              <div
                class="w-7 h-7 rounded-lg bg-[#ebf7f4] flex items-center justify-center shrink-0 border border-emerald-100/70"
              >
                <img src="assets/REVAMPED/revamp website_/home page/assets/yoga-3.webp"
                  alt="Stretch icon"
                  class="h-3.5 w-3.5 object-contain"
                decoding="async" loading="lazy" />
              </div>
              <h3 class="font-display text-sm font-bold text-brand-black leading-tight">
                Stretch
              </h3>
            </div>
            <p class="text-[10px] text-zinc-500 leading-snug text-left">
              Reduce tightness &amp; improve flex.
            </p>
          </div>
          <div
            class="w-full aspect-[16/10] rounded-xl overflow-hidden relative mt-2.5"
          >
            <img src="/assets/REVAMPED/revamp%20website_/home%20page/assets/png%20file-w/zylo/GIFs/stretching-anim.webp"
              data-gif="/assets/REVAMPED/revamp%20website_/home%20page/assets/png%20file-w/zylo/GIFs/stretching-anim.webp"
              alt="Stretch athlete"
              class="workout-gif w-full h-full object-cover object-center absolute inset-0"
              loading="lazy" decoding="async" />
          </div>
        </div>

        <!-- Card 8: Recovery -->
        <div
          class="group relative overflow-hidden rounded-2xl border border-zinc-200/80 bg-white p-3.5 sm:p-4 flex flex-col justify-between h-auto w-full hover:shadow-md transition-all duration-200 cursor-pointer"
        >
          <div class="w-full">
            <div class="flex items-center gap-2.5 mb-2">
              <div
                class="w-7 h-7 rounded-lg bg-[#ebf7f4] flex items-center justify-center shrink-0 border border-emerald-100/70"
              >
                <img src="/assets/REVAMPED/revamp%20website_/home%20page/assets/recovery-2.webp"
                  alt="Recovery icon"
                  class="h-3.5 w-3.5 object-contain"
                decoding="async" loading="lazy" />
              </div>
              <h3 class="font-display text-sm font-bold text-brand-black leading-tight">
                Recovery
              </h3>
            </div>
            <p class="text-[10px] text-zinc-500 leading-snug text-left">
              Active recovery &amp; relaxation.
            </p>
          </div>
          <div
            class="w-full aspect-[16/10] rounded-xl overflow-hidden relative mt-2.5"
          >
            <img src="/assets/REVAMPED/revamp%20website_/home%20page/assets/png%20file-w/zylo/GIFs/resting-anim.webp"
              data-gif="/assets/REVAMPED/revamp%20website_/home%20page/assets/png%20file-w/zylo/GIFs/resting-anim.webp"
              alt="Recovery athlete"
              class="workout-gif w-full h-full object-cover object-center absolute inset-0"
              loading="lazy" decoding="async" />
          </div>
        </div>
      </div>
      </div>

      <!-- DESKTOP: Clean Vertical 4-Column Card Layout (Icon + Title side-by-side Top, Dedicated Media Container Bottom) -->
      <div class="hidden md:grid grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
        <!-- Card 1: Strength -->
        <div
