  <script>
    // Gallery Swapper Logic
    // Gallery Thumbnail Switcher
    const mainImage = (document.getElementById("k1-main-gallery-img") || document.getElementById("k1-main-image")) as HTMLImageElement;
    const galleryThumbs = document.querySelectorAll("[data-gallery-thumb]");

    if (mainImage && galleryThumbs.length > 0) {
      galleryThumbs.forEach((thumb) => {
        thumb.addEventListener("click", () => {
          const newSrc = thumb.getAttribute("data-img-src");
          if (newSrc) {
            mainImage.style.opacity = "0.3";
            setTimeout(() => {
              mainImage.src = newSrc;
              mainImage.style.opacity = "1";
            }, 100);

            galleryThumbs.forEach((t) => {
              t.classList.remove("border-brand-mint", "ring-2", "ring-brand-mint/20");
              t.classList.add("border-zinc-200");
            });
            thumb.classList.remove("border-zinc-200");
            thumb.classList.add("border-brand-mint", "ring-2", "ring-brand-mint/20");
          }
        });
      });
    }

    // Pulley Stance Buttons
    const pulleyBtns = document.querySelectorAll(".pulley-btn");
    const stanceTitle = document.getElementById("pulley-stance-title");
    const stanceDesc = document.getElementById("pulley-stance-desc");

    const stanceData: Record<string, { title: string; desc: string }> = {
      standard: { title: "Standard Dual Arm Alignment", desc: "Optimal for chest presses, lat pulldowns, and bicep curls." },
      wide: { title: "Wide Angle Alignment", desc: "Maximizes range of motion for cable flys and lateral raises." },
      narrow: { title: "Narrow Alignment", desc: "Concentrates resistance vectors for tricep pushdowns and straight arm pullovers." }
    };

    pulleyBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        pulleyBtns.forEach(b => {
          b.classList.remove("bg-brand-black", "text-white");
          b.classList.add("bg-white", "text-zinc-600", "border", "border-zinc-200");
        });
        btn.classList.add("bg-brand-black", "text-white");
        btn.classList.remove("bg-white", "text-zinc-600", "border", "border-zinc-200");

        const stance = btn.getAttribute("data-stance");
        if (stance && stanceData[stance]) {
          if (stanceTitle) stanceTitle.textContent = stanceData[stance].title;
          if (stanceDesc) stanceDesc.textContent = stanceData[stance].desc;
        }
      });
    });

    // Mobile Mode Pill Buttons & Carousel Bi-Directional Scroll Sync
    const mobileCarouselK1 = document.getElementById("mobile-modes-carousel");
    const modePillBtnsK1 = document.querySelectorAll<HTMLButtonElement>(".mode-pill-btn");

    if (mobileCarouselK1 && modePillBtnsK1.length > 0) {
      function setActivePill(activeBtn: HTMLButtonElement) {
        modePillBtnsK1.forEach((b) => {
          b.classList.remove("bg-brand-black", "text-white", "shadow-xs");
          b.classList.add("bg-zinc-100", "text-zinc-600");
        });
        activeBtn.classList.add("bg-brand-black", "text-white", "shadow-xs");
        activeBtn.classList.remove("bg-zinc-100", "text-zinc-600");

        // Scroll pill into view inside pill header strip
        activeBtn.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
      }

      // 1. Click Pill -> Scroll Carousel to Card
      modePillBtnsK1.forEach((btn) => {
        btn.addEventListener("click", () => {
          const targetId = btn.getAttribute("data-mode-target");
          if (targetId) {
            const targetElem = document.getElementById(targetId);
            if (targetElem) {
              targetElem.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
            }
          }
          setActivePill(btn);
        });
      });

      // 2. Swipe/Scroll Carousel -> Update & Scroll Active Pill
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
              const cardId = entry.target.id;
              const matchingPill = document.querySelector<HTMLButtonElement>(`[data-mode-target="${cardId}"]`);
              if (matchingPill) {
                setActivePill(matchingPill);
              }
            }
          });
        },
        {
          root: mobileCarouselK1,
          threshold: 0.5
        }
      );

      const modeCards = mobileCarouselK1.querySelectorAll("[id^='mode-snap-']");
      modeCards.forEach((card) => observer.observe(card));
    }

    // Smart Scroll-Triggered Floating CTA Bar (Shows strictly AFTER scrolling past hero buttons)
    const heroCta = document.getElementById("hero-cta-container");
    const floatingCta = document.getElementById("mobile-floating-cta");

    if (heroCta && floatingCta) {
      const checkScroll = () => {
        const rect = heroCta.getBoundingClientRect();
        // Show floating bar ONLY when the bottom of hero buttons passes above top of screen
        if (rect.bottom <= 0) {
          floatingCta.classList.remove("translate-y-full", "opacity-0", "pointer-events-none");
          floatingCta.classList.add("translate-y-0", "opacity-100", "pointer-events-auto");
        } else {
          floatingCta.classList.remove("translate-y-0", "opacity-100", "pointer-events-auto");
          floatingCta.classList.add("translate-y-full", "opacity-0", "pointer-events-none");
        }
      };

      window.addEventListener("scroll", checkScroll, { passive: true });
      checkScroll();
    }
  </script>
  <!-- Mobile Floating Sticky CTA Bar (Scroll-Triggered via JS) -->
  <div
    id="mobile-floating-cta"
    class="sm:hidden fixed bottom-0 left-0 right-0 z-50 p-2.5 px-3 bg-white/95 backdrop-blur-md border-t border-zinc-200/90 shadow-[0_-4px_25px_rgba(0,0,0,0.15)] flex items-center justify-center translate-y-full opacity-0 pointer-events-none transition-all duration-300 ease-out"
  >
    <div class="grid grid-cols-2 gap-2 w-full max-w-md mx-auto">
      <button
        type="button"
        class="add-to-cart-btn flex-1 inline-flex items-center justify-center rounded-xl bg-brand-black py-3 text-[11px] font-extrabold tracking-wider text-white uppercase cursor-pointer shadow-xs active:scale-[0.98] transition-transform"
        data-product-id="k1"
        data-product-name="ZYLO K1 AI Home Gym"
        data-product-subtitle="Compact Strength Mirror System"
        data-product-price="PHP 398,000"
        data-product-image="/assets/products/k1.webp"
      >
        Add to Cart
      </button>
      <a
        href="/contact#showrooms"
        class="flex-1 inline-flex items-center justify-center text-center rounded-xl border border-zinc-300 bg-white py-3 text-[11px] font-extrabold tracking-wider text-brand-black uppercase hover:bg-zinc-50 active:scale-[0.98] transition-transform"
      >
        Book Showroom Demo
      </a>
    </div>
  </div>
  <script>
    (function () {
      // ─── Cart Logic ───────────────────────────────────────────────────
      const cartBtns = document.querySelectorAll(".add-to-cart-btn");
      cartBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = btn.getAttribute("data-product-id") || "k1";
          const name = btn.getAttribute("data-product-name") || "ZYLO K1 AI Home Gym";
          const subtitle = btn.getAttribute("data-product-subtitle") || "Compact Strength Mirror System";
          const price = btn.getAttribute("data-product-price") || "PHP 398,000";
          const image = btn.getAttribute("data-product-image") || "/assets/products/k1.webp";

          let currentItems = [];
          try {
            currentItems = JSON.parse(localStorage.getItem("zylo_cart_items") || "[]");
          } catch (e) {
            currentItems = [];
          }

          const existingIndex = currentItems.findIndex((item: any) => item.id === id);
          if (existingIndex > -1) {
            currentItems[existingIndex].quantity = (currentItems[existingIndex].quantity || 1) + 1;
          } else {
            currentItems.push({ id, name, subtitle, price, image, quantity: 1 });
          }

          localStorage.setItem("zylo_cart_items", JSON.stringify(currentItems));
          window.dispatchEvent(new CustomEvent("zylo-cart-updated"));
          window.dispatchEvent(new CustomEvent("zylo-show-toast", { detail: `${name} added to cart 🛍️` }));

          const originalText = btn.textContent;
          btn.textContent = "✓ Added to Cart";
          btn.classList.add("bg-emerald-700");
          setTimeout(() => {
            btn.textContent = originalText;
            btn.classList.remove("bg-emerald-700");
          }, 1800);
        });
      });

      // ─── Scroll-Triggered Count-Up: 280+ Movements & 140+ Classes ────
      const statsBar = document.getElementById("k1-movements-stats-bar");
      const movementsEl = document.getElementById("k1-movements-count");
      const classesEl = document.getElementById("k1-classes-count");

      if (statsBar && movementsEl && classesEl) {
        let animFrameId: number | null = null;
        let hasAnimated = false;

        function easeOutCubic(t: number): number {
          return 1 - Math.pow(1 - t, 3);
        }

        function animateCountUp() {
          if (hasAnimated) return;
          hasAnimated = true;

          const MOVEMENTS_TARGET = 280;
          const CLASSES_TARGET = 140;
          const DURATION = 2200; // ms
          const startTime = performance.now();

          function tick(now: number) {
            const elapsed = now - startTime;
            const progress = Math.min(elapsed / DURATION, 1);
            const eased = easeOutCubic(progress);

            movementsEl!.textContent = Math.round(eased * MOVEMENTS_TARGET).toString();
            classesEl!.textContent = Math.round(eased * CLASSES_TARGET).toString();

            if (progress < 1) {
              animFrameId = requestAnimationFrame(tick);
            }
          }

          animFrameId = requestAnimationFrame(tick);
        }

        function resetCounters() {
          hasAnimated = false;
          if (animFrameId) cancelAnimationFrame(animFrameId);
          movementsEl!.textContent = "0";
          classesEl!.textContent = "0";
        }

        if ("IntersectionObserver" in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  animateCountUp();
                } else {
                  resetCounters();
                }
              });
            },
            { threshold: 0.4 }
          );
          observer.observe(statsBar);
        } else {
          // Fallback: just show the final numbers immediately
          movementsEl.textContent = "280";
          classesEl.textContent = "140";
        }
      }
    })();
  </script>
</Layout>
