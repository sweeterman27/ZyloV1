---
import Layout from "../../layouts/Layout.astro";

const productK1Schema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "ZYLO K1 AI Smart Home Gym",
  "image": "https://zylowebsite.pages.dev/assets/products/k1.webp",
  "description": "The flagship ZYLO K1 AI Smart Home Gym featuring 4K interactive display, digital motorized resistance, real-time posture tracking, and 3D motion analysis.",
  "brand": {
    "@type": "Brand",
    "name": "ZYLO AI"
  },
  "offers": {
    "@type": "Offer",
    "url": "https://zylowebsite.pages.dev/products/zylo-k1",
    "priceCurrency": "PHP",
    "price": "149000",
    "availability": "https://schema.org/InStock",
    "itemCondition": "https://schema.org/NewCondition"
  }
};
---

<Layout
  title="ZYLO K1 AI Smart Home Gym — Flagship All-in-One Fitness | ZYLO AI"
  description="Order the ZYLO K1 AI Smart Home Gym. Features digital motorized resistance up to 100kg, real-time AI form coaching, 4K screen, and zero subscription fees."
  image="/assets/products/k1.webp"
  canonical="/products/zylo-k1"
  schema={productK1Schema}
>


  <!-- Top Breadcrumb Bar -->
  <nav class="bg-brand-lightGray border-b border-brand-midGray/40 py-3" aria-label="Breadcrumb">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 flex items-center gap-2 text-xs font-bold tracking-wide text-zinc-500">
      <a href="/products" class="hover:text-brand-black transition-colors">Products</a>
      <span class="text-zinc-300">/</span>
      <span class="text-brand-black font-extrabold">ZYLO K1 Smart Home Gym</span>
    </div>
  </nav>

  <!-- Main Product Detail Showcase Section -->
  <section class="bg-white py-12 lg:py-[80px]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      
      <!-- 2-Column Product Detail Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-stretch">
        
        <!-- Left Column: Product Image Gallery -->
        <div class="flex flex-col justify-between h-full gap-4">
          <!-- Main Display Box -->
          <div 
            class="relative flex-1 w-full overflow-hidden border border-zinc-200 bg-white shadow-md flex items-center justify-center p-1 sm:p-2 group min-h-[350px] sm:min-h-[440px]"
          >
            <img id="k1-main-gallery-img"
              src="/assets/products/product%20page/k1/k1-featured-photos/feature%201.webp"
              alt="ZYLO K1 AI Smart Home Gym"
              class="w-full h-full object-contain p-3 sm:p-5 transition-all duration-500 group-hover:scale-[1.03]"
            decoding="async" loading="lazy" />
          </div>

          <!-- Thumbnail Selector Strip (6 items: feature 1.webp to feature6.webp) -->
          <div class="grid grid-cols-6 gap-2">
            {[
              "/assets/products/product%20page/k1/k1-featured-photos/feature%201.webp",
              "/assets/products/product%20page/k1/k1-featured-photos/feature%202.webp",
              "/assets/products/product%20page/k1/k1-featured-photos/feature3.webp",
              "/assets/products/product%20page/k1/k1-featured-photos/feature4.webp",
              "/assets/products/product%20page/k1/k1-featured-photos/feature5.webp",
              "/assets/products/product%20page/k1/k1-featured-photos/feature6.webp"
            ].map((imgUrl, idx) => (
              <button
                type="button"
                data-gallery-thumb
                data-img-src={imgUrl}
                class={`aspect-square rounded-xl border-2 overflow-hidden bg-white p-1 transition-all duration-200 cursor-pointer ${idx === 0 ? "border-brand-mint ring-2 ring-brand-mint/20" : "border-zinc-200 hover:border-zinc-400"}`}
                aria-label={`View ZYLO K1 photo ${idx + 1}`}
              >
                <img src={imgUrl}
                  alt={`ZYLO K1 Thumbnail ${idx + 1}`}
                  class="w-full h-full object-contain"
                  loading="lazy" decoding="async" />
              </button>
            ))}
          </div>
        </div>

        <!-- Right Column: Specs & Buying Summary -->
        <div class="flex flex-col justify-between">
          <div>
            <!-- Changed Name -->
            <h1 class="font-display font-extrabold text-3xl sm:text-4xl text-brand-black mt-3 leading-tight">
              ZYLO K1 Smart Home Gym
            </h1>
            <!-- Sub description -->
            <p class="text-xs font-bold text-zinc-400 uppercase tracking-widest mt-1">
              AI-Powered Performance System
            </p>

            <!-- Price Strip -->
            <div class="mt-6 flex items-baseline gap-4 border-y border-brand-midGray/60 py-4">
              <span class="text-3xl font-black text-brand-black">₱398,000</span>
              <span class="text-base font-semibold text-zinc-400 line-through">₱498,000</span>
            </div>

            <!-- Dimensions Line Callout -->
            <div class="mt-6 grid grid-cols-2 gap-4 rounded-2xl bg-brand-lightGray p-4 border border-brand-midGray/60 font-mono text-xs text-neutral-600">
              <div>
                <span class="block font-bold text-zinc-400 uppercase text-[9px] tracking-wider mb-1">Folded Dimensions</span>
                <span class="font-bold text-brand-black">71.5 &times; 42.5 &times; 185 cm</span>
              </div>
              <div>
                <span class="block font-bold text-zinc-400 uppercase text-[9px] tracking-wider mb-1">Unfolded Dimensions</span>
                <span class="font-bold text-brand-black">71.5 &times; 135.5 &times; 185 cm</span>
              </div>
            </div>

            <!-- Product Description (Exact Text requested) -->
            <p class="mt-6 text-sm leading-relaxed text-zinc-600 font-medium">
              The ZYLO AI K1 Smart Home Gym combines AI coaching, real-time form correction, up to 100 kg of digital resistance, and smart progress tracking in one compact, foldable system. It delivers personalized full-body training with no subscription fees.
            </p>

            <!-- Key Features Bullet List -->
            <div class="mt-8">
              <h3 class="text-xs font-extrabold uppercase tracking-widest text-brand-black mb-3">Main Features</h3>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {[
                  "Real-Time AI Coach System",
                  "42-Point Motion Tracking",
                  "Digital Resistance up to 100 kg",
                  "43\" 4K Smart Touch Mirror Display",
                  "300+ Workouts, 400+ Movements",
                  "Subscription-Free Lifetime Access",
                  "Auto-Fold Compact Design",
                  "Full-Body Fitness Reports"
                ].map((feat) => (
                  <li class="flex items-center gap-2.5 text-xs font-semibold text-zinc-700">
                    <div class="h-4 w-4 rounded-full bg-brand-mint/15 flex items-center justify-center text-brand-mint shrink-0">
                      <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                    </div>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- CTAs -->
          <div class="mt-10 flex flex-col sm:flex-row gap-4">
            <button
              type="button"
              class="order-modal-trigger btn-spring flex-1 inline-flex items-center justify-center gap-2 rounded-2xl bg-brand-black py-4 text-xs font-bold tracking-widest text-white uppercase cursor-pointer"
              data-select-product="k1"
            >
              Order Now
            </button>
            <a
              href="/about#contact"
              class="btn-spring inline-flex items-center justify-center rounded-2xl border border-zinc-300 bg-white px-8 py-4 text-xs font-bold tracking-widest text-brand-black uppercase hover:bg-zinc-50"
            >
              Book Showroom Demo
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Video Player Section (White Background Header, Zero Bottom Black Bar) -->
  <section class="bg-white pt-12 lg:pt-[80px] text-zinc-900 w-full overflow-hidden" style="padding-bottom: 0px !important;" aria-label="Product Experience Video">
    <div class="w-full px-0">
      <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-10 px-4">
        <h2 class="font-display font-extrabold text-2xl sm:text-4xl tracking-tight text-zinc-900 uppercase">
          Experience K1 Smart Home Gym
        </h2>
        <p class="text-xs sm:text-sm text-zinc-600 font-semibold mt-3">
          See how AI motion tracking &amp; digital resistance guide your form in real-time.
        </p>
      </div>

      <!-- Native Video Player Container (Edge-to-Edge 100% Full-Bleed Width - Borderless) -->
      <div class="relative aspect-video w-full max-w-none overflow-hidden border-none bg-zinc-900 group">
        
        <video
          id="k1-avp-video"
          class="w-full h-full object-cover"
          src="/assets/products/product%20page/k1/K1 AVP.mp4"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
        ></video>

        <!-- Audio Toggle Button -->
        <button
          id="k1-audio-btn"
          type="button"
          aria-label="Toggle audio"
          class="absolute bottom-5 right-5 z-10 flex items-center gap-2 rounded-xl bg-brand-black/80 backdrop-blur-sm border border-white/10 px-3.5 py-2.5 text-white transition-all duration-200 hover:bg-brand-mint hover:text-brand-black hover:border-brand-mint group/btn"
        >
          <!-- Muted icon (shown by default) -->
          <svg id="k1-icon-muted" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2" />
          </svg>
          <!-- Unmuted icon (hidden by default) -->
          <svg id="k1-icon-unmuted" class="h-4 w-4 shrink-0 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072M12 6v12m-3.536-9.536A5 5 0 004.929 12a5 5 0 004.535 4.929" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
          </svg>
          <span id="k1-audio-label" class="text-[10px] font-mono font-bold uppercase tracking-widest">Sound Off</span>
        </button>
      </div>
    </div>
  </section>

  <script>
    const video = document.getElementById("k1-avp-video") as HTMLVideoElement | null;
    const btn = document.getElementById("k1-audio-btn");
    const iconMuted = document.getElementById("k1-icon-muted");
    const iconUnmuted = document.getElementById("k1-icon-unmuted");
    const label = document.getElementById("k1-audio-label");

    if (video && btn) {
      btn.addEventListener("click", () => {
        video.muted = !video.muted;
        if (video.muted) {
          iconMuted?.classList.remove("hidden");
          iconUnmuted?.classList.add("hidden");
          if (label) label.textContent = "Sound Off";
        } else {
          iconMuted?.classList.add("hidden");
          iconUnmuted?.classList.remove("hidden");
          if (label) label.textContent = "Sound On";
        }
      });
    }
  </script>
<!-- ─── K1 FEATURE HIGHLIGHTS (BESPOKE K1 SHOWCASE) ─── -->
  <section class="bg-zinc-50 py-12 lg:py-[80px] border-b border-zinc-100" aria-label="K1 Feature Highlights">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 flex flex-col gap-3 sm:gap-5">

      <!-- Mobile Horizontal Touch Carousel (< lg) | Desktop 12-Column Bento Grid (lg+) -->
      <div class="flex lg:grid overflow-x-auto lg:overflow-visible snap-x snap-mandatory lg:snap-none gap-3.5 sm:gap-5 pb-4 lg:pb-0 -mx-4 px-4 sm:-mx-6 sm:px-6 lg:mx-0 lg:px-0 lg:grid-cols-12 scrollbar-none">

        <!-- TILE 1: AI-DRIVEN COACHING (Mobile Swipe Card / 4 cols on lg) -->
        <div class="w-[82vw] xs:w-[80vw] sm:w-[360px] lg:w-auto shrink-0 snap-center lg:col-span-4 relative rounded-2xl sm:rounded-3xl bg-white border border-zinc-200/80 shadow-sm overflow-hidden min-h-[210px] flex items-center group hover:border-brand-mint/40 transition-colors">
          <img src="/assets/products/product%20page/k1/k1-features/AI-DRIVEN.webp"
            alt="AI-Driven Coaching"
            class="absolute inset-0 w-full h-full object-cover object-[75%_center] pointer-events-none group-hover:scale-105 transition-transform duration-700"
            loading="lazy" decoding="async" />
          <div class="absolute inset-0 bg-gradient-to-r from-white via-white/85 via-50% to-transparent pointer-events-none z-10"></div>
          <div class="relative z-20 p-5 sm:p-6 max-w-[68%] sm:max-w-[65%] h-full flex flex-col justify-center">
            <div class="h-8 w-8 rounded-full bg-brand-mint/10 flex items-center justify-center mb-2 shrink-0">
              <svg class="h-4.5 w-4.5 text-brand-mint" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <h3 class="font-display font-black text-base sm:text-lg text-brand-black uppercase leading-tight tracking-tight">
              AI-DRIVEN<br/>COACHING
            </h3>
            <span class="h-0.5 w-7 bg-brand-mint block my-2 shrink-0"></span>
            <p class="text-[11px] font-bold text-zinc-400 tracking-wide">for Better Results</p>
          </div>
        </div>

        <!-- TILE 2: COMPACT & READY ANYTIME (Mobile Swipe Card / 3 cols on lg) -->
        <div class="w-[82vw] xs:w-[80vw] sm:w-[360px] lg:w-auto shrink-0 snap-center lg:col-span-3 relative rounded-2xl sm:rounded-3xl bg-white border border-zinc-200/80 shadow-sm overflow-hidden min-h-[210px] flex items-center group hover:border-brand-mint/40 transition-colors">
          <img src="/assets/products/product%20page/k1/k1-features/AUTO-FOLD%20%26%20COMPACT%20FRAME.png"
            alt="Compact Folded Machine"
            class="absolute inset-0 w-full h-full object-cover object-[95%_center] pointer-events-none group-hover:scale-105 transition-transform duration-700"
            loading="lazy" decoding="async" />
          <div class="absolute inset-0 bg-gradient-to-r from-white via-white/85 via-50% to-transparent pointer-events-none z-10"></div>
          <div class="relative z-20 p-5 sm:p-6 max-w-[70%] h-full flex flex-col justify-center">
            <h3 class="font-display font-black text-sm sm:text-base text-brand-black uppercase leading-tight tracking-tight">
              COMPACT &amp;<br/>READY ANYTIME
            </h3>
            <span class="h-0.5 w-7 bg-brand-mint block my-2 shrink-0"></span>
            <p class="text-[9px] font-bold uppercase tracking-wider text-zinc-400">Folds Down to</p>
            <p class="font-display font-black text-3xl sm:text-4xl text-brand-mint leading-none my-0.5">3.2 ft²</p>
            <p class="text-[11px] font-bold text-zinc-400 tracking-wide mt-1">Smart. Compact.<br/>Space-saving.</p>
          </div>
        </div>

        <!-- TILE 3: 6-DIMENSIONAL FITNESS ASSESSMENT (Mobile Swipe Card / 5 cols on lg) -->
        <div class="w-[82vw] xs:w-[80vw] sm:w-[360px] lg:w-auto shrink-0 snap-center lg:col-span-5 relative rounded-2xl sm:rounded-3xl bg-white border border-zinc-200/80 shadow-sm overflow-hidden min-h-[210px] flex items-center group hover:border-brand-mint/40 transition-colors">
          <img src="/assets/products/product%20page/k1/k1-features/6-DIMENSIONAL-ASSESTMENT.webp"
            alt="6D Fitness Assessment"
            class="absolute inset-0 w-full h-full object-cover object-right pointer-events-none group-hover:scale-105 transition-transform duration-700"
            loading="lazy" decoding="async" />
          <div class="absolute inset-0 bg-gradient-to-r from-white via-white/90 via-55% to-transparent pointer-events-none z-10"></div>
          <div class="relative z-20 p-5 sm:p-6 max-w-[82%] sm:max-w-[78%] h-full flex flex-col justify-center">
            <div class="h-8 w-8 rounded-full bg-brand-mint/10 flex items-center justify-center mb-2 shrink-0">
              <svg class="h-4.5 w-4.5 text-brand-mint" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
              </svg>
            </div>
            <h3 class="font-display font-black text-xs sm:text-sm text-brand-black uppercase leading-tight tracking-tight">
              6-DIMENSIONAL<br/>FITNESS ASSESSMENT
            </h3>
            <p class="text-[10px] font-bold text-zinc-400 mb-2">for Smarter Workouts</p>

            <div class="grid grid-cols-2 gap-1.5 max-w-[340px] sm:max-w-[360px]">
              {[
                "Cardiovascular Function",
                "Body Composition",
                "Muscular Endurance",
                "Flexibility",
                "Posture & Body Alignment",
                "Core Stability"
              ].map((tag) => (
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-white/95 backdrop-blur-md border border-zinc-200/80 text-[8px] sm:text-[8.5px] font-mono font-bold text-zinc-700 shadow-2xs whitespace-nowrap truncate">
                  <span class="h-1 w-1 rounded-full bg-brand-mint shrink-0"></span>
                  <span class="truncate">{tag}</span>
                </span>
              ))}
            </div>
          </div>
        </div>

        <!-- TILE 4: REAL-TIME FEEDBACK (Mobile Swipe Card / 5 cols on lg) -->
        <div class="w-[82vw] xs:w-[80vw] sm:w-[360px] lg:w-auto shrink-0 snap-center lg:col-span-5 relative rounded-2xl sm:rounded-3xl bg-white border border-zinc-200/80 shadow-sm overflow-hidden min-h-[210px] sm:min-h-[225px] flex items-center group hover:border-brand-mint/40 transition-colors">
          <img src="/assets/products/product%20page/k1/k1-features/REAL-TIME-FEEDBACK.webp"
            alt="Real-Time Feedback"
            class="absolute inset-0 w-full h-full object-cover object-[95%_top] pointer-events-none group-hover:scale-105 transition-transform duration-700"
            loading="lazy" decoding="async" />
          <div class="absolute inset-0 bg-gradient-to-r from-white via-white/85 via-45% to-transparent pointer-events-none z-10"></div>
          <div class="relative z-20 p-5 sm:p-6 max-w-[68%] sm:max-w-[60%] h-full flex flex-col justify-center">
            <div class="h-8 w-8 rounded-full bg-brand-mint/10 flex items-center justify-center mb-2 shrink-0">
              <svg class="h-4.5 w-4.5 text-brand-mint" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="font-display font-black text-base sm:text-lg text-brand-black uppercase leading-tight tracking-tight">
              REAL-TIME<br/>FEEDBACK
            </h3>
            <span class="h-0.5 w-7 bg-brand-mint block my-2 shrink-0"></span>
            <p class="text-[11px] font-bold text-zinc-400 tracking-wide">for Safer Workouts</p>
          </div>
        </div>

        <!-- TILE 5: COVERS 320+ MOVEMENTS (Mobile Swipe Card / 3 cols on lg) -->
        <div class="w-[82vw] xs:w-[80vw] sm:w-[360px] lg:w-auto shrink-0 snap-center lg:col-span-3 relative rounded-2xl sm:rounded-3xl bg-white border border-zinc-200/80 shadow-sm overflow-hidden min-h-[210px] flex items-center group hover:border-brand-mint/40 transition-colors">
          <img src="/assets/products/product%20page/k1/k1-features/300+%20WORKOUT%20ROUTINES.webp"
            alt="Covers 320+ Movements"
            class="absolute inset-0 w-full h-full object-cover object-right pointer-events-none group-hover:scale-105 transition-transform duration-700"
            loading="lazy" decoding="async" />
          <div class="absolute inset-0 bg-gradient-to-r from-white via-white/85 via-50% to-transparent pointer-events-none z-10"></div>
          <div class="relative z-20 p-5 sm:p-6 max-w-[68%] sm:max-w-[65%] h-full flex flex-col justify-center">
            <div class="h-8 w-8 rounded-full bg-brand-mint/10 flex items-center justify-center mb-2 shrink-0">
              <svg class="h-4.5 w-4.5 text-brand-mint" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
            <p class="font-display font-black text-xs text-brand-black uppercase leading-none">COVERS</p>
            <p class="font-display font-black text-3xl sm:text-4xl text-brand-mint leading-tight my-0.5">320+</p>
            <p class="font-display font-black text-xs text-brand-black uppercase leading-none mb-1">MOVEMENTS</p>
          </div>
        </div>

        <!-- TILE 6: ₱0 FEES CARD (Mobile Swipe Card / 4 cols on lg) -->
        <div class="w-[82vw] xs:w-[80vw] sm:w-[360px] lg:w-auto shrink-0 snap-center lg:col-span-4 relative rounded-2xl sm:rounded-3xl bg-white border border-zinc-200/80 shadow-sm overflow-hidden min-h-[210px] flex items-center group hover:border-brand-mint/40 transition-colors p-5">
          <div class="relative z-10 w-full h-full flex flex-row items-center justify-between gap-2">
            <div class="flex flex-col justify-center shrink-0 max-w-[62%]">
              <div class="h-8 w-8 rounded-full bg-brand-mint/10 border border-brand-mint/20 flex items-center justify-center mb-2 shrink-0">
                <svg class="h-4.5 w-4.5 text-brand-mint" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h3 class="font-display font-black text-base sm:text-lg text-brand-black uppercase leading-tight tracking-tight mb-2">
                <span class="text-brand-mint">₱0</span> FEES
              </h3>
              <ul class="space-y-1">
                {[
                  "No subscriptions.",
                  "No hidden costs.",
                  "Yours forever."
                ].map((item) => (
                  <li class="flex items-center gap-1.5 text-[10px] font-bold text-zinc-600">
                    <svg class="h-3.5 w-3.5 text-brand-mint shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
