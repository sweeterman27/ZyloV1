      <!-- Telemetry Live Count-up & Scroll Reset Script -->
      <script>
        (function() {
          function initTelemetryAnimation() {
            const section = document.getElementById('telemetry-section');
            if (!section) return;

            const countElements = section.querySelectorAll('[data-count-target]');
            const curvePaths = section.querySelectorAll('.telemetry-curve-path');
            let animationFrameId = null;

            // Prepare SVG path dash lengths
            curvePaths.forEach(path => {
              try {
                const length = path.getTotalLength();
                path.style.strokeDasharray = length;
                path.style.strokeDashoffset = length;
              } catch(e) {}
            });

            function resetValues() {
              if (animationFrameId) {
                cancelAnimationFrame(animationFrameId);
                animationFrameId = null;
              }
              countElements.forEach(el => {
                el.textContent = '0';
              });
              curvePaths.forEach(path => {
                try {
                  const length = path.getTotalLength();
                  path.style.transition = 'none';
                  path.style.strokeDashoffset = length;
                } catch(e) {}
              });
            }

            function animateValues() {
              resetValues();
              const duration = 1400; // 1.4s duration
              const startTime = performance.now();

              // Trigger SVG drawing animation
              curvePaths.forEach(path => {
                try {
                  path.style.transition = 'stroke-dashoffset 1.4s cubic-bezier(0.16, 1, 0.3, 1)';
                  path.style.strokeDashoffset = '0';
                } catch(e) {}
              });

              function step(currentTime) {
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);
                // Ease out cubic
                const easeOut = 1 - Math.pow(1 - progress, 3);

                countElements.forEach(el => {
                  const target = parseInt(el.getAttribute('data-count-target') || '0', 10);
                  const current = Math.floor(target * easeOut);
                  el.textContent = current.toLocaleString();
                });

                if (progress < 1) {
                  animationFrameId = requestAnimationFrame(step);
                }
              }

              animationFrameId = requestAnimationFrame(step);
            }

            const observer = new IntersectionObserver((entries) => {
              entries.forEach(entry => {
                if (entry.isIntersecting) {
                  animateValues();
                } else {
                  resetValues();
                }
              });
            }, { threshold: 0.2 });

            observer.observe(section);
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initTelemetryAnimation);
          } else {
            initTelemetryAnimation();
          }
        })();
      </script>

