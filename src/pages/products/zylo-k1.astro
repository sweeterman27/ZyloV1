  <script>
    // Gallery Swapper Logic
    // Gallery Thumbnail Switcher
    const mainImage = (document.getElementById("k1-main-gallery-img") || document.getElementById("k1-main-image")) as HTMLImageElement;
    const galleryThumbs = document.querySelectorAll("[data-gallery-thumb]");

    if (mainImage && galleryThumbs.length > 0) {
      galleryThumbs.forEach((thumb) => {
        thumb.addEventListener("click", () => {
          const newSrc = thumb.getAttribute("data-img-src");
          if (newSrc) {
            mainImage.style.opacity = "0.3";
            setTimeout(() => {
              mainImage.src = newSrc;
              mainImage.style.opacity = "1";
            }, 100);

            galleryThumbs.forEach((t) => {
              t.classList.remove("border-brand-mint", "ring-2", "ring-brand-mint/20");
              t.classList.add("border-zinc-200");
            });
            thumb.classList.remove("border-zinc-200");
            thumb.classList.add("border-brand-mint", "ring-2", "ring-brand-mint/20");
          }
        });
      });
    }

    // Pulley Stance Buttons
    const pulleyBtns = document.querySelectorAll(".pulley-btn");
    const stanceTitle = document.getElementById("pulley-stance-title");
    const stanceDesc = document.getElementById("pulley-stance-desc");

    const stanceData: Record<string, { title: string; desc: string }> = {
      standard: { title: "Standard Dual Arm Alignment", desc: "Optimal for chest presses, lat pulldowns, and bicep curls." },
      wide: { title: "Wide Angle Alignment", desc: "Maximizes range of motion for cable flys and lateral raises." },
      narrow: { title: "Narrow Alignment", desc: "Concentrates resistance vectors for tricep pushdowns and straight arm pullovers." }
    };

    pulleyBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        pulleyBtns.forEach(b => {
          b.classList.remove("bg-brand-black", "text-white");
          b.classList.add("bg-white", "text-zinc-600", "border", "border-zinc-200");
        });
        btn.classList.add("bg-brand-black", "text-white");
        btn.classList.remove("bg-white", "text-zinc-600", "border", "border-zinc-200");

        const stance = btn.getAttribute("data-stance");
        if (stance && stanceData[stance]) {
          if (stanceTitle) stanceTitle.textContent = stanceData[stance].title;
          if (stanceDesc) stanceDesc.textContent = stanceData[stance].desc;
        }
      });
    });
  </script>
