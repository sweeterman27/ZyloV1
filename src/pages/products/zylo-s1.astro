---
import Layout from "../../layouts/Layout.astro";

const productS1Schema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "ZYLO S1 PRO AI Smart Home Gym",
  "image": "https://zylowebsite.pages.dev/assets/products/s1%20pro.webp",
  "description": "Compact ultra-versatile ZYLO S1 PRO AI Smart Home Gym featuring motorized digital resistance, fold-away design, and real-time AI form coaching.",
  "brand": {
    "@type": "Brand",
    "name": "ZYLO AI"
  },
  "offers": {
    "@type": "Offer",
    "url": "https://zylowebsite.pages.dev/products/zylo-s1",
    "priceCurrency": "PHP",
    "price": "99000",
    "availability": "https://schema.org/InStock",
    "itemCondition": "https://schema.org/NewCondition"
  }
};
---

<Layout
  title="ZYLO S1 PRO AI Smart Home Gym â€” Compact Powerhouse | ZYLO AI"
  description="Order the ZYLO S1 PRO AI Smart Home Gym. Ultra-compact, space-saving design with digital resistance, AI movement tracking, and instant setup."
  image="/assets/products/s1%20pro.webp"
  canonical="/products/zylo-s1"
  schema={productS1Schema}
>


  <!-- Top Breadcrumb Bar -->
  <nav class="bg-brand-lightGray border-b border-brand-midGray/40 py-3" aria-label="Breadcrumb">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 flex items-center gap-2 text-xs font-bold tracking-wide text-zinc-500">
      <a href="/products" class="hover:text-brand-black transition-colors">Products</a>
      <span class="text-zinc-300">/</span>
      <span class="text-brand-black font-extrabold">ZYLO S1 Pro Smart Home Gym</span>
    </div>
  </nav>

  <!-- Main Product Detail Showcase Section -->
  <section class="bg-white py-12 lg:py-[80px]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      
      <!-- 2-Column Product Detail Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-stretch">
        
        <!-- Left Column: Product Image Gallery -->
        <div class="flex flex-col justify-between h-full gap-4">
          <!-- Main Display Box -->
          <div 
            class="relative flex-1 w-full overflow-hidden border border-zinc-200 bg-white shadow-md flex items-center justify-center p-1 sm:p-2 group min-h-[350px] sm:min-h-[440px]"
          >
            <img id="s1-main-image"
              src="/assets/products/product%20page/S1/photo/3.webp"
              alt="S1 PRO Home Gym Photo Preview"
              class="w-full h-full object-contain p-3 sm:p-5 transition-all duration-500 group-hover:scale-[1.03]"
            decoding="async" loading="lazy" />
          </div>

          <!-- Thumbnail Selector Strip (5 items: 3.webp to 7.webp) -->
          <div class="grid grid-cols-5 gap-2">
            {[
              "/assets/products/product%20page/S1/photo/3.webp",
              "/assets/products/product%20page/S1/photo/4.webp",
              "/assets/products/product%20page/S1/photo/5.webp",
              "/assets/products/product%20page/S1/photo/6.webp",
              "/assets/products/product%20page/S1/photo/7.webp"
            ].map((imgUrl, idx) => (
              <button
                type="button"
                data-gallery-thumb
                data-img-src={imgUrl}
                class={`aspect-square rounded-xl border-2 overflow-hidden bg-white p-1 transition-all duration-200 cursor-pointer ${idx === 0 ? "border-brand-mint ring-2 ring-brand-mint/20" : "border-zinc-200 hover:border-zinc-400"}`}
                aria-label={`View S1 PRO photo ${idx + 1}`}
              >
                <img src={imgUrl}
                  alt={`S1 PRO Thumbnail ${idx + 1}`}
                  class="w-full h-full object-contain"
                  loading="lazy" decoding="async" />
              </button>
            ))}
          </div>
        </div>

        <!-- Right Column: Specs & Buying Summary -->
        <div class="flex flex-col justify-between">
          <div>
            <h1 class="font-display font-extrabold text-3xl sm:text-4xl text-brand-black mt-3 leading-tight">
              ZYLO S1 Pro Smart Home Gym
            </h1>
            <p class="text-xs font-bold text-zinc-400 uppercase tracking-widest mt-1">
              Full-Body Fitness Gym System
            </p>

            <!-- Price Strip -->
            <div class="mt-6 flex items-baseline gap-4 border-y border-brand-midGray/60 py-4">
              <span class="text-3xl font-black text-brand-black">â‚±249,000</span>
              <span class="text-base font-semibold text-zinc-400 line-through">â‚±299,000</span>
            </div>

            <!-- Product Description -->
            <p class="mt-6 text-sm leading-relaxed text-zinc-600 font-medium">
              ZYLO S1 Pro is a professional-grade, space-efficient smart gym engineered to replace over 23 traditional gym machines by utilizing motorized digital resistance and real-time motion tracking. Featuring 200lbs of precision weight, 185-angle adjustable arms, and a foldable 3.2 sq. ft. footprint, it provides a comprehensive, data-driven workout experience with zero subscription fees.
            </p>

            <!-- Interactive Accordion Dropdowns (Dimensions, Features, Warranty, Shipping) -->
            <div class="mt-6 divide-y divide-zinc-200/80 border-y border-zinc-200/80">
              
              <!-- 1. DIMENSIONS -->
              <details class="group py-3.5" open>
                <summary class="flex items-center justify-between font-display font-extrabold text-xs sm:text-sm text-brand-black uppercase tracking-wider cursor-pointer list-none select-none">
                  <span class="flex items-center gap-2">
                    <svg class="h-4 w-4 text-zinc-400 group-open:text-brand-mint transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
                    </svg>
                    Dimensions
                  </span>
                  <span class="h-6 w-6 rounded-full bg-zinc-100 group-open:bg-brand-mint/15 flex items-center justify-center text-zinc-500 group-open:text-brand-mint transition-colors shrink-0">
                    <svg class="h-3.5 w-3.5 transform group-open:rotate-180 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                  </span>
                </summary>
                <div class="pt-3 text-xs text-zinc-600 space-y-3 font-medium">
                  <div class="grid grid-cols-2 gap-3 rounded-2xl bg-zinc-50 p-3.5 border border-zinc-200/60 font-mono">
                    <div>
                      <span class="block font-bold text-zinc-400 uppercase text-[9px] tracking-wider mb-1">Compact Footprint</span>
                      <span class="font-bold text-brand-black text-xs">3.2 sq. ft. Foldable</span>
                    </div>
                    <div>
                      <span class="block font-bold text-zinc-400 uppercase text-[9px] tracking-wider mb-1">Precision Tension</span>
                      <span class="font-bold text-brand-black text-xs">200 lbs Digital Motor</span>
                    </div>
                  </div>
                  <div class="flex items-center justify-between text-[11px] text-zinc-500 px-1 font-mono">
                    <span>Adjustable Arms: <strong class="text-brand-black">185Â° Multi-Angle</strong></span>
                    <span>Equipment Replacement: <strong class="text-brand-black">23+ Machines</strong></span>
                  </div>
                </div>
              </details>

              <!-- 2. FEATURES -->
              <details class="group py-3.5">
                <summary class="flex items-center justify-between font-display font-extrabold text-xs sm:text-sm text-brand-black uppercase tracking-wider cursor-pointer list-none select-none">
                  <span class="flex items-center gap-2">
                    <svg class="h-4 w-4 text-zinc-400 group-open:text-brand-mint transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Features
                  </span>
                  <span class="h-6 w-6 rounded-full bg-zinc-100 group-open:bg-brand-mint/15 flex items-center justify-center text-zinc-500 group-open:text-brand-mint transition-colors shrink-0">
                    <svg class="h-3.5 w-3.5 transform group-open:rotate-180 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                  </span>
                </summary>
                <div class="pt-3 text-xs text-zinc-600 font-medium">
                  <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                    {[
                      "Real-Time AI Coach System",
                      "42-Point Motion Tracking",
                      "Digital Resistance up to 200 lbs",
                      "185-Angle Adjustable Arms",
                      "Replaces Over 23 Gym Machines",
                      "Foldable 3.2 sq. ft. Footprint",
                      "Subscription-Free Lifetime Access",
                      "Integrated Bench & Bar System"
                    ].map((feat) => (
                      <li class="flex items-center gap-2 text-xs font-semibold text-zinc-700">
                        <div class="h-4 w-4 rounded-full bg-brand-mint/15 flex items-center justify-center text-brand-mint shrink-0">
                          <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                          </svg>
                        </div>
                        <span>{feat}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </details>

              <!-- 3. WARRANTY -->
              <details class="group py-3.5">
                <summary class="flex items-center justify-between font-display font-extrabold text-xs sm:text-sm text-brand-black uppercase tracking-wider cursor-pointer list-none select-none">
                  <span class="flex items-center gap-2">
                    <svg class="h-4 w-4 text-zinc-400 group-open:text-brand-mint transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                    Warranty
                  </span>
                  <span class="h-6 w-6 rounded-full bg-zinc-100 group-open:bg-brand-mint/15 flex items-center justify-center text-zinc-500 group-open:text-brand-mint transition-colors shrink-0">
                    <svg class="h-3.5 w-3.5 transform group-open:rotate-180 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                  </span>
                </summary>
                <div class="pt-3 text-xs text-zinc-600 space-y-2 font-medium">
                  <div class="flex items-start gap-2.5">
                    <div class="h-4 w-4 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 mt-0.5 font-bold">âœ“</div>
                    <span><strong>Lifetime Service Warranty:</strong> Includes technical cable tension inspection, motor calibration, and labor support.</span>
                  </div>
                  <div class="flex items-start gap-2.5">
                    <div class="h-4 w-4 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 mt-0.5 font-bold">âœ“</div>
                    <span><strong>1-Year Parts &amp; Motor Warranty:</strong> Full replacement coverage for digital resistance motors, cables, and core electronic modules.</span>
                  </div>
                </div>
              </details>

              <!-- 4. SHIPPING -->
              <details class="group py-3.5">
                <summary class="flex items-center justify-between font-display font-extrabold text-xs sm:text-sm text-brand-black uppercase tracking-wider cursor-pointer list-none select-none">
                  <span class="flex items-center gap-2">
                    <svg class="h-4 w-4 text-zinc-400 group-open:text-brand-mint transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                    </svg>
                    Shipping
                  </span>
                  <span class="h-6 w-6 rounded-full bg-zinc-100 group-open:bg-brand-mint/15 flex items-center justify-center text-zinc-500 group-open:text-brand-mint transition-colors shrink-0">
                    <svg class="h-3.5 w-3.5 transform group-open:rotate-180 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                  </span>
                </summary>
                <div class="pt-3 text-xs text-zinc-600 space-y-2 font-medium">
                  <div class="flex items-start gap-2.5">
                    <div class="h-4 w-4 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 mt-0.5 font-bold">âœ“</div>
                    <span><strong>Free Door-to-Door Delivery:</strong> Complimentary logistics across Metro Manila and select Luzon urban areas.</span>
                  </div>
                  <div class="flex items-start gap-2.5">
                    <div class="h-4 w-4 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 mt-0.5 font-bold">âœ“</div>
                    <span><strong>White-Glove Installation:</strong> Professional bench &amp; bar assembly, system calibration, and live demonstration upon delivery.</span>
                  </div>
                  <div class="flex items-start gap-2.5">
                    <div class="h-4 w-4 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 mt-0.5 font-bold">âœ“</div>
                    <span><strong>Fast Dispatch:</strong> Delivered within 2â€“5 business days with scheduled appointment slot.</span>
                  </div>
                </div>
              </details>

            </div>
          </div>

          <!-- CTAs -->
          <div id="hero-cta-container" class="mt-10 flex flex-col sm:flex-row gap-4">
            <button
              type="button"
              class="add-to-cart-btn btn-spring flex-1 inline-flex items-center justify-center gap-2 rounded-2xl bg-brand-black py-4 text-xs font-bold tracking-widest text-white uppercase cursor-pointer"
              data-product-id="s1"
              data-product-name="ZYLO S1 Pro Smart Home Gym"
              data-product-subtitle="Full-Body Bench System"
              data-product-price="PHP 149,990"
              data-product-image="/assets/products/product page/S1/photo/3.webp"
            >
              Add to Cart
            </button>
            <a
              href="/contact#showrooms"
              class="btn-spring inline-flex items-center justify-center rounded-2xl border border-zinc-300 bg-white px-8 py-4 text-xs font-bold tracking-widest text-brand-black uppercase hover:bg-zinc-50"
            >
              Book Showroom Demo
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Video Player Section (White Background Header, Zero Bottom Black Bar) -->
  <section class="bg-white pt-12 lg:pt-[80px] text-zinc-900 w-full overflow-hidden" style="padding-bottom: 0px !important;" aria-label="Product Experience Video">
    <div class="w-full px-0">
      <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-10 px-4">
        <h2 class="font-display font-extrabold text-2xl sm:text-4xl tracking-tight text-zinc-900 uppercase">
          Experience S1 PRO Home Gym
        </h2>
        <p class="text-xs sm:text-sm text-zinc-600 font-semibold mt-3">
          See how AI motion tracking &amp; digital resistance guide your form in real-time.
        </p>
      </div>

      <!-- Native Video Player Container (Edge-to-Edge 100% Full-Bleed Width - Borderless) -->
      <div class="relative aspect-video w-full max-w-none overflow-hidden border-none bg-zinc-900 group">
        
        <video
          id="s1-avp-video"
          class="w-full h-full object-cover"
          src="/assets/products/product%20page/S1/S1%20Pro%20Avp.mp4"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
        ></video>

        <!-- Audio Toggle Button -->
        <button
          id="s1-audio-btn"
          type="button"
          aria-label="Toggle audio"
          class="absolute bottom-5 right-5 z-10 flex items-center gap-2 rounded-xl bg-brand-black/80 backdrop-blur-sm border border-white/10 px-3.5 py-2.5 text-white transition-all duration-200 hover:bg-brand-mint hover:text-brand-black hover:border-brand-mint group/btn"
        >
          <!-- Muted icon (shown by default) -->
          <svg id="s1-icon-muted" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2" />
          </svg>
          <!-- Unmuted icon (hidden by default) -->
          <svg id="s1-icon-unmuted" class="h-4 w-4 shrink-0 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072M12 6v12m-3.536-9.536A5 5 0 004.929 12a5 5 0 004.535 4.929" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
          </svg>
          <span id="s1-audio-label" class="text-[10px] font-mono font-bold uppercase tracking-widest">Sound Off</span>
        </button>
      </div>
    </div>
  </section>

  <script>
    const videoS1 = document.getElementById("s1-avp-video") as HTMLVideoElement | null;
    const btnS1 = document.getElementById("s1-audio-btn");
    const iconMutedS1 = document.getElementById("s1-icon-muted");
    const iconUnmutedS1 = document.getElementById("s1-icon-unmuted");
    const labelS1 = document.getElementById("s1-audio-label");

    if (videoS1 && btnS1) {
      btnS1.addEventListener("click", () => {
        videoS1.muted = !videoS1.muted;
        if (videoS1.muted) {
          iconMutedS1?.classList.remove("hidden");
          iconUnmutedS1?.classList.add("hidden");
          if (labelS1) labelS1.textContent = "Sound Off";
        } else {
          iconMutedS1?.classList.add("hidden");
          iconUnmutedS1?.classList.remove("hidden");
          if (labelS1) labelS1.textContent = "Sound On";
        }
      });
    }
  </script>




  <!-- Included Accessories Section -->
  <section class="bg-white py-12 lg:py-[80px] border-b border-brand-midGray/60" aria-label="S1 PRO Included Accessories">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-10">
        <h3 class="font-display font-bold text-xs sm:text-sm text-zinc-400 uppercase tracking-widest">
          INCLUDED ACCESSORIES &amp; SYSTEM ADD-ONS
        </h3>
        <p class="text-xs sm:text-sm text-zinc-500 font-medium mt-1.5">
          Everything included for a complete AI-guided training setup.
        </p>
      </div>

      <div class="grid grid-cols-3 sm:grid-cols-3 lg:grid-cols-4 gap-2 sm:gap-6">
        {[
          { name: "Pro-Grip Smart Handles (Pair)", img: "/assets/products/product%20page/S1/accessories/grip.webp" },
          { name: "Reinforced Ankle Straps (Pair)", img: "/assets/products/product%20page/S1/accessories/ankle%20strap.webp" },
          { name: "Smart Barbell (Long Bar)", img: "/assets/products/product%20page/S1/accessories/bar.webp" },
          { name: "Smart Heart Rate Armband", img: "/assets/products/product%20page/S1/accessories/Heart%20Rate%20Armband.webp" },
          { name: "High-Density Floor Mat", img: "/assets/products/product%20page/k1/k1-accessories/High-Density%20Yoga%20Mat.webp" },
          { name: "Instructional Manual & Power Toolkit", img: "/assets/products/product%20page/S1/accessories/Instructional-manual.png" },
          { name: "Smart Adjustable Bench", img: "/assets/products/product%20page/S1/accessories/bench.webp" }
        ].map((item) => (
          <div class="flex flex-col items-center justify-between rounded-xl sm:rounded-2xl bg-brand-lightGray border border-zinc-200/80 p-2 sm:p-4 transition-all duration-300 hover:shadow-md hover:border-brand-mint/50 group">
            {item.img ? (
              <div class={`w-full aspect-[4/3] rounded-lg sm:rounded-xl bg-white border border-zinc-200/60 flex items-center justify-center mb-1.5 sm:mb-3 overflow-hidden group-hover:border-brand-mint/60 transition-colors ${item.img.includes("Yoga%20Mat") ? "p-0" : "p-1 sm:p-2"}`}>
                <img src={item.img}
                  alt={item.name}
                  loading="lazy" class={item.img.includes("Yoga%20Mat") ? "w-full h-full object-contain object-right scale-[1.03] translate-x-1 group-hover:scale-[1.06] transition-transform duration-300" : "w-full h-full object-contain group-hover:scale-[1.05] transition-transform duration-300"}
                decoding="async" />
              </div>
            ) : (
              <div class="w-full aspect-[4/3] rounded-lg sm:rounded-xl bg-zinc-200/70 border border-dashed border-zinc-300 flex flex-col items-center justify-center text-zinc-400 group-hover:border-brand-mint/60 transition-colors mb-1.5 sm:mb-3 overflow-hidden">
                <svg class="h-6 w-6 text-zinc-400 mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                </svg>
                <span class="text-[9px] font-bold uppercase tracking-wider text-zinc-400">Placeholder</span>
              </div>
            )}
            
            <div class="w-full text-center flex flex-col items-center min-w-0 overflow-hidden">
              <h3 class="font-display font-bold text-brand-black text-center leading-none uppercase tracking-tight block w-full truncate" style="font-size: clamp(7.5px, 0.7vw, 10px) !important; white-space: nowrap !important;">
                {item.name}
              </h3>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- â”€â”€â”€ FEATURE BENTO GRID (ASYMMETRICAL 12-COLUMN 1:1 REFERENCE) â”€â”€â”€ -->
  <section class="bg-zinc-50 py-12 lg:py-[80px] border-b border-zinc-100" aria-label="S1 PRO Feature Highlights">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 flex flex-col gap-4 sm:gap-5">

      <!-- Mobile Horizontal Touch Carousel (< lg) | Desktop 12-Column Bento Grid (lg+) -->
