  <script>
    (function () {
      const cartBtns = document.querySelectorAll(".add-to-cart-btn");
      cartBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = btn.getAttribute("data-product-id") || "s1";
          const name = btn.getAttribute("data-product-name") || "ZYLO S1 Pro Smart Home Gym";
          const subtitle = btn.getAttribute("data-product-subtitle") || "Full-Body Bench System";
          const price = btn.getAttribute("data-product-price") || "PHP 149,990";
          const image = btn.getAttribute("data-product-image") || "/assets/products/product page/S1/photo/3.webp";

          let currentItems = [];
          try {
            currentItems = JSON.parse(localStorage.getItem("zylo_cart_items") || "[]");
          } catch (e) {
            currentItems = [];
          }

          const existingIndex = currentItems.findIndex((item: any) => item.id === id);
          if (existingIndex > -1) {
            currentItems[existingIndex].quantity = (currentItems[existingIndex].quantity || 1) + 1;
          } else {
            currentItems.push({ id, name, subtitle, price, image, quantity: 1 });
          }

          localStorage.setItem("zylo_cart_items", JSON.stringify(currentItems));
          window.dispatchEvent(new CustomEvent("zylo-cart-updated"));
          window.dispatchEvent(new CustomEvent("zylo-show-toast", { detail: `${name} added to cart ðŸ›ï¸` }));

          const originalText = btn.textContent;
          btn.textContent = "âœ“ Added to Cart";
          btn.classList.add("bg-emerald-700");
          setTimeout(() => {
            btn.textContent = originalText;
            btn.classList.remove("bg-emerald-700");
          }, 1800);
        });
      });
    })();
  </script>
