  <script>
    (function () {
      const mainImg = (document.getElementById("s1-main-image") || document.getElementById("s1-main-gallery-img")) as HTMLImageElement;
      const thumbs = document.querySelectorAll("[data-gallery-thumb]");

      if (mainImg && thumbs.length > 0) {
        thumbs.forEach((thumb) => {
          thumb.addEventListener("click", () => {
            const newSrc = thumb.getAttribute("data-img-src");
            if (newSrc) {
              mainImg.style.opacity = "0.3";
              setTimeout(() => {
                mainImg.src = newSrc;
                mainImg.style.opacity = "1";
              }, 100);

              thumbs.forEach((t) => {
                t.classList.remove("border-brand-mint", "ring-2", "ring-brand-mint/20");
                t.classList.add("border-zinc-200");
              });
              thumb.classList.remove("border-zinc-200");
              thumb.classList.add("border-brand-mint", "ring-2", "ring-brand-mint/20");
            }
          });
        });
      }
    })();
  </script>
