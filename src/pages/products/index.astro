  <script>
    // Category Filter Tabs Logic
    const filterTabs = document.querySelectorAll(".catalog-filter-btn");
    const gymsContainer = document.getElementById("catalog-gyms-container");
    const accessoriesContainer = document.getElementById("catalog-accessories-container");
    const compareContainer = document.getElementById("catalog-compare-container");

    filterTabs.forEach(tab => {
      tab.addEventListener("click", () => {
        const filter = tab.getAttribute("data-filter-tab");
        
        // Update active tab button styling
        filterTabs.forEach(t => {
          t.classList.remove("bg-brand-black", "text-white", "shadow-sm");
          t.classList.add("bg-brand-lightGray", "text-zinc-600");
        });
        tab.classList.remove("bg-brand-lightGray", "text-zinc-600");
        tab.classList.add("bg-brand-black", "text-white", "shadow-sm");

        // Handle section visibility
        if (filter === "accessories") {
          if (gymsContainer) gymsContainer.style.display = "none";
          if (accessoriesContainer) accessoriesContainer.style.display = "block";
        } else {
          // Default: "gyms"
          if (gymsContainer) gymsContainer.style.display = "block";
          if (accessoriesContainer) accessoriesContainer.style.display = "none";
        }
      });
    });

    // Accessories Modal Logic — image container click opens modal
    const accessoryImageTriggers = document.querySelectorAll(".accessory-image-trigger");
    const modals = document.querySelectorAll(".custom-modal");
    const closeBtns = document.querySelectorAll(".modal-close-btn");

    accessoryImageTriggers.forEach(trigger => {
      trigger.addEventListener("click", () => {
        const targetId = trigger.getAttribute("data-modal-target");
        if (targetId) openModal(targetId);
      });
    });

    closeBtns.forEach(btn => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const modalId = btn.getAttribute("data-modal-id");
        if (modalId) closeModal(modalId);
      });
    });

    modals.forEach(modal => {
      modal.addEventListener("click", (e) => {
        if (e.target === modal) closeModal(modal.id);
      });
    });

    // Quick Add-to-Cart (+) Button — adds directly, no modal
    function addToCart(id: string, name: string, subtitle: string, price: string, image: string) {
      let currentItems: any[] = [];
      try {
        currentItems = JSON.parse(localStorage.getItem("zylo_cart_items") || "[]");
      } catch (err) {
        currentItems = [];
      }
      const existingIndex = currentItems.findIndex((item: any) => item.id === id);
      if (existingIndex > -1) {
        currentItems[existingIndex].quantity = (currentItems[existingIndex].quantity || 1) + 1;
      } else {
        currentItems.push({ id, name, subtitle, price, image, quantity: 1 });
      }
      localStorage.setItem("zylo_cart_items", JSON.stringify(currentItems));
      window.dispatchEvent(new CustomEvent("zylo-cart-updated"));
      window.dispatchEvent(new CustomEvent("zylo-show-toast", { detail: `${name} added to cart 🛒` }));
    }

    // Quick cart buttons (+ icon on card)
    const quickCartBtns = document.querySelectorAll(".quick-cart-btn");
    quickCartBtns.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const id = btn.getAttribute("data-product-id") || "accessory";
        const name = btn.getAttribute("data-product-name") || "ZYLO Accessory";
        const subtitle = btn.getAttribute("data-product-subtitle") || "ZYLO System Accessory";
        const price = btn.getAttribute("data-product-price") || "₱0";
        const image = btn.getAttribute("data-product-image") || "";

        addToCart(id, name, subtitle, price, image);

        // Visual feedback: swap + icon to checkmark briefly
        const svg = btn.querySelector("svg");
        if (svg) {
          svg.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />`;
          btn.classList.add("bg-brand-mint", "border-brand-mint", "text-zinc-900");
          btn.classList.remove("bg-white");
          setTimeout(() => {
            svg.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-6-6h12" />`;
            btn.classList.remove("bg-brand-mint", "border-brand-mint", "text-zinc-900");
            btn.classList.add("bg-white");
          }, 1000);
        }
      });
    });

    // Add-to-cart inside detail modal (the full modal card button)
    const cartBtns = document.querySelectorAll(".add-to-cart-btn");
    cartBtns.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const id = btn.getAttribute("data-product-id") || "accessory";
        const name = btn.getAttribute("data-product-name") || "ZYLO Accessory";
        const subtitle = btn.getAttribute("data-product-subtitle") || "ZYLO System Accessory";
        const price = btn.getAttribute("data-product-price") || "₱0";
        const image = btn.getAttribute("data-product-image") || "";

        addToCart(id, name, subtitle, price, image);

        const originalText = btn.textContent;
        btn.textContent = "✓ Added!";
        btn.classList.add("bg-emerald-700");
        setTimeout(() => {
          btn.textContent = originalText;
          btn.classList.remove("bg-emerald-700");
          closeModal(`modal-${id}`);
        }, 900);
      });
    });

    // Mobile Product Toggle (K1 vs S1 Pro)
    const mobileToggleK1 = document.getElementById("mobile-toggle-k1");
    const mobileToggleS1 = document.getElementById("mobile-toggle-s1");
    const cardK1 = document.getElementById("product-card-k1");
    const cardS1 = document.getElementById("product-card-s1");

    if (mobileToggleK1 && mobileToggleS1 && cardK1 && cardS1) {
      mobileToggleK1.addEventListener("click", () => {
        cardK1.classList.remove("hidden");
        cardK1.classList.add("block");

        cardS1.classList.remove("block");
        cardS1.classList.add("hidden", "sm:block");

        mobileToggleK1.className = "flex-1 py-2.5 px-3 rounded-xl text-xs font-bold uppercase tracking-wider transition-all duration-200 bg-brand-black text-white shadow-sm cursor-pointer";
        mobileToggleS1.className = "flex-1 py-2.5 px-3 rounded-xl text-xs font-bold uppercase tracking-wider transition-all duration-200 text-zinc-600 hover:text-brand-black cursor-pointer";
      });

      mobileToggleS1.addEventListener("click", () => {
        cardS1.classList.remove("hidden");
        cardS1.classList.add("block");

        cardK1.classList.remove("block");
        cardK1.classList.add("hidden", "sm:block");

        mobileToggleS1.className = "flex-1 py-2.5 px-3 rounded-xl text-xs font-bold uppercase tracking-wider transition-all duration-200 bg-brand-black text-white shadow-sm cursor-pointer";
        mobileToggleK1.className = "flex-1 py-2.5 px-3 rounded-xl text-xs font-bold uppercase tracking-wider transition-all duration-200 text-zinc-600 hover:text-brand-black cursor-pointer";
      });
    }

    function openModal(id: string) {
      const modal = document.getElementById(id);
      if (modal) {
        modal.classList.remove("opacity-0", "pointer-events-none");
        const dialog = modal.querySelector("div");
        if (dialog) dialog.classList.replace("scale-95", "scale-100");
      }
    }

    function closeModal(id: string) {
      const modal = document.getElementById(id);
      if (modal) {
        modal.classList.add("opacity-0", "pointer-events-none");
        const dialog = modal.querySelector("div");
        if (dialog) dialog.classList.replace("scale-100", "scale-95");
      }
    }
  </script>
</Layout>
