---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="ZYLO AI Gallery — Real Customer Homes & Smart Gym Installations"
  description="Explore photos of ZYLO AI K1 and S1 smart home gym installations in luxury homes, private studios, and modern apartments."
  canonical="/gallery"
>
  <!-- ─── PAGE HERO ─── -->
  <section class="bg-white py-12 sm:py-[80px] border-b border-zinc-100">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-mint/10 border border-brand-mint/30 text-[10px] font-mono text-brand-mint font-bold uppercase tracking-widest mb-4">
          <span class="h-2 w-2 rounded-full bg-brand-mint animate-pulse"></span>
          Visual Showcase
        </span>
        <h1 class="font-display font-extrabold text-3xl sm:text-5xl text-brand-black leading-tight tracking-tight uppercase mb-4">
          ZYLO AI Gallery
        </h1>
        <p class="text-sm sm:text-base text-zinc-500 font-sans leading-relaxed">
          A curated look at the ZYLO AI Smart Home Gym — in premium homes, executive spaces, and real training environments across the Philippines.
        </p>
      </div>
    </div>
  </section>


  <!-- ─── FEATURED HERO PLACEHOLDER ─── -->
  <section class="bg-white py-12 sm:py-[80px]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

      <!-- Section label -->
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3">
          <span class="h-px w-8 bg-brand-mint block"></span>
          <span class="text-[10px] font-mono uppercase tracking-widest text-zinc-400">Featured</span>
        </div>
      </div>

      <!-- Featured 2-up grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-4">
        <!-- Large featured tile -->
        <div class="relative group rounded-2xl overflow-hidden bg-zinc-100 aspect-[4/3] flex items-center justify-center">
          <div class="absolute inset-0 bg-gradient-to-br from-zinc-200 to-zinc-100"></div>
          <!-- Placeholder icon -->
          <div class="relative z-10 flex flex-col items-center gap-3 text-zinc-300">
            <svg class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span class="text-xs font-mono uppercase tracking-widest">Photo Coming Soon</span>
          </div>
          <!-- Hover overlay -->
          <div class="absolute inset-0 bg-brand-black/0 group-hover:bg-brand-black/30 transition-all duration-300 rounded-2xl"></div>
          <!-- Caption chip -->
          <div class="absolute bottom-4 left-4 right-4 opacity-0 group-hover:opacity-100 transition-all duration-300 translate-y-2 group-hover:translate-y-0">
            <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white/90 backdrop-blur-sm text-[10px] font-mono font-bold uppercase tracking-widest text-brand-black">
              <span class="h-1.5 w-1.5 rounded-full bg-brand-mint"></span>
              ZYLO AI — Product Design
            </span>
          </div>
        </div>

        <!-- Right column: 2 stacked tiles -->
        <div class="flex flex-col gap-4">
          {[
            "In-Home Setup — Executive Residence",
            "ZYLO AI Training Session"
          ].map((caption) => (
            <div class="relative group rounded-2xl overflow-hidden bg-zinc-100 flex-1 min-h-[180px] flex items-center justify-center">
              <div class="absolute inset-0 bg-gradient-to-br from-zinc-200 to-zinc-100"></div>
              <div class="relative z-10 flex flex-col items-center gap-2 text-zinc-300">
                <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <span class="text-[10px] font-mono uppercase tracking-widest">Photo Coming Soon</span>
              </div>
              <div class="absolute inset-0 bg-brand-black/0 group-hover:bg-brand-black/30 transition-all duration-300 rounded-2xl"></div>
              <div class="absolute bottom-3 left-3 right-3 opacity-0 group-hover:opacity-100 transition-all duration-300 translate-y-2 group-hover:translate-y-0">
                <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white/90 backdrop-blur-sm text-[10px] font-mono font-bold uppercase tracking-widest text-brand-black">
                  <span class="h-1.5 w-1.5 rounded-full bg-brand-mint"></span>
                  {caption}
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ─── MASONRY-STYLE GRID ─── -->
  <section class="bg-white py-12 sm:py-[80px]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

      <!-- Section label -->
      <div class="flex items-center gap-3 mb-6">
        <span class="h-px w-8 bg-brand-mint block"></span>
        <span class="text-[10px] font-mono uppercase tracking-widest text-zinc-400">All Photos</span>
      </div>

      <!-- 3-column grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          { aspect: "aspect-[4/5]", caption: "ZYLO AI Mirror — Living Room", tag: "Product Design" },
          { aspect: "aspect-square", caption: "AI Coaching Interface", tag: "AI Interface" },
          { aspect: "aspect-[4/3]", caption: "Core Training Session", tag: "Training" },
          { aspect: "aspect-[4/3]", caption: "Home Setup — Condominium", tag: "In Home" },
          { aspect: "aspect-[4/5]", caption: "ZYLO K1 — Detail Shot", tag: "Product Design" },
          { aspect: "aspect-square", caption: "Miss Universe PH Partnership", tag: "Events" },
          { aspect: "aspect-square", caption: "Smart Accessory Set", tag: "Product Design" },
          { aspect: "aspect-[4/3]", caption: "Private Gym — Executive Home", tag: "In Home" },
          { aspect: "aspect-[4/5]", caption: "Full-Body Training Mode", tag: "Training" },
          { aspect: "aspect-[4/3]", caption: "Motion Tracking — Squat Form", tag: "AI Interface" },
          { aspect: "aspect-square", caption: "Launch Event — Manila", tag: "Events" },
          { aspect: "aspect-[4/5]", caption: "ZYLO S1 — Side Profile", tag: "Product Design" },
        ].map((item) => (
          <div class={`relative group rounded-2xl overflow-hidden bg-zinc-100 ${item.aspect} flex items-center justify-center`}>
            <!-- Subtle gradient bg -->
            <div class="absolute inset-0 bg-gradient-to-br from-zinc-200 to-zinc-100"></div>
            <!-- Mint dot accent -->
            <div class="absolute top-3 right-3 h-2 w-2 rounded-full bg-brand-mint/40"></div>
            <!-- Placeholder icon -->
            <div class="relative z-10 flex flex-col items-center gap-2 text-zinc-300">
              <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span class="text-[9px] font-mono uppercase tracking-widest">Coming Soon</span>
            </div>
            <!-- Hover overlay -->
            <div class="absolute inset-0 bg-brand-black/0 group-hover:bg-brand-black/40 transition-all duration-300 rounded-2xl"></div>
            <!-- Caption on hover -->
            <div class="absolute bottom-3 left-3 right-3 opacity-0 group-hover:opacity-100 transition-all duration-300 translate-y-2 group-hover:translate-y-0 flex items-end justify-between gap-2">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/90 backdrop-blur-sm text-[9px] font-mono font-bold uppercase tracking-widest text-brand-black leading-none">
                {item.caption}
              </span>
              <span class="shrink-0 px-2 py-1 rounded-lg bg-brand-mint text-[8px] font-mono font-bold uppercase tracking-widest text-brand-black leading-none">
                {item.tag}
              </span>
            </div>
          </div>
        ))}
      </div>

      <!-- Load more -->
      <div class="mt-12 text-center">
        <button
          type="button"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-zinc-200 text-xs font-mono font-bold uppercase tracking-widest text-zinc-500 hover:border-brand-black hover:text-brand-black transition-all duration-200"
        >
          <span>Load More</span>
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
      </div>
    </div>
  </section>

  <!-- ─── SUBMIT / CTA STRIP ─── -->
  <section class="bg-brand-black py-12 lg:py-[80px]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <p class="text-[10px] font-mono uppercase tracking-widest text-brand-mint mb-1">Community Photos</p>
          <h2 class="font-display font-extrabold text-xl sm:text-2xl text-white uppercase tracking-tight">
            Train with ZYLO AI?<br class="hidden sm:block" /> Share your space.
          </h2>
        </div>
        <a
          href="/#contact"
          class="shrink-0 inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-brand-mint text-brand-black text-xs font-bold uppercase tracking-widest hover:bg-brand-mint/90 transition-colors"
        >
          <span>Submit Your Photo</span>
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</Layout>
