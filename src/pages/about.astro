---
import Layout from "../layouts/Layout.astro";

const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About ZYLO AI",
  "description": "Discover the story, engineering team, and mission behind ZYLO AI — pioneering smart home fitness technology.",
  "publisher": {
    "@type": "Organization",
    "name": "ZYLO AI",
    "url": "https://zylowebsite.pages.dev"
  }
};
---

<Layout
  title="About ZYLO AI — The Future of Home Fitness & Engineering"
  description="Learn how ZYLO AI is revolutionizing personal wellness through AI-driven computer vision, digital motorized resistance, and sleek home aesthetic design."
  canonical="/about"
  schema={aboutSchema}
>


  <!-- ─── 1. HERO ─────────────────────────────────────────────────── -->
  <section class="relative min-h-[85dvh] sm:min-h-[92dvh] bg-zinc-950 flex items-end overflow-hidden">
    <!-- Dark gradient & grid pattern background -->
    <div class="absolute inset-0 bg-zinc-950 flex items-center justify-center">
      <div class="absolute inset-0 bg-[radial-gradient(#27272a_1px,transparent_1px)] [background-size:24px_24px] opacity-60"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/80 to-transparent"></div>
    </div>

    <!-- Content anchored bottom-left -->
    <div class="relative z-10 w-full px-5 sm:px-10 lg:px-16 pb-12 sm:pb-24">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-mint/15 border border-brand-mint/30 text-[9px] sm:text-[10px] font-mono text-brand-mint font-bold uppercase tracking-widest mb-4">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-mint animate-pulse"></span>
          About ZYLO AI
        </span>
        <h1 class="font-display font-black text-3xl sm:text-6xl lg:text-7xl text-white leading-[1.05] tracking-tighter uppercase">
          Redefining How<br/>
          <em class="not-italic text-brand-mint">Filipinos</em> Train.
        </h1>
        <p class="mt-4 sm:mt-6 text-xs sm:text-base text-zinc-300 font-medium leading-relaxed max-w-xl">
          AI-powered smart wellness and fitness, built for the modern Filipino home.
        </p>
        <div class="mt-6 sm:mt-8 h-[2px] w-16 sm:w-20 bg-brand-mint opacity-80"></div>
      </div>
    </div>

    <!-- Scroll hint (hidden on tiny screens) -->
    <div class="hidden sm:flex absolute bottom-8 right-8 z-10 flex-col items-center gap-2 opacity-50">
      <span class="font-mono text-[9px] uppercase tracking-widest text-white rotate-90 origin-center translate-y-4">Scroll</span>
      <div class="w-[1px] h-12 bg-white mt-4"></div>
    </div>
  </section>

  <!-- ─── 2. STORY & VISION ────────────────────────────────────── -->
  <section class="bg-white py-10 sm:py-16 lg:py-[80px]">
    <div class="mx-auto max-w-7xl px-5 sm:px-10 lg:px-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-12 lg:gap-20 items-center">
        <!-- Left: Copy -->
        <div class="lg:col-span-5">
          <span class="inline-block font-mono text-[10px] font-bold uppercase tracking-[0.24em] text-emerald-600 mb-3">Our Story</span>
          <h2 class="font-display font-black text-2xl sm:text-4xl text-brand-black leading-tight tracking-tight uppercase">
            A New Chapter<br/>for Philippine Innovation
          </h2>
          <div class="mt-5 sm:mt-8 space-y-4 text-xs sm:text-sm text-zinc-600 font-medium leading-relaxed">
            <p>
              ZYLO AI is an AI-powered smart wellness and fitness brand created to redefine how Filipinos train, recover, and stay active at home.
            </p>
            <p>
              As part of <strong class="text-brand-black font-bold">ZK Summit Holdings Inc.</strong>'s strategic move toward AI-driven brands, ZYLO AI represents the group's next chapter in bringing intelligent, future-ready solutions to the Philippine market.
            </p>
            <p>
              From building lifestyle and wellness brands, ZK Summit Holdings Inc. is now moving toward a new direction where artificial intelligence becomes a core driver of innovation, convenience, and everyday quality of life.
            </p>
          </div>
        </div>

        <!-- Right: Visual Placeholder Box & Mobile Badge -->
        <div class="lg:col-span-7 relative">
          <div class="relative aspect-[4/3] rounded-2xl sm:rounded-3xl overflow-hidden bg-zinc-900 border border-zinc-800 shadow-md flex flex-col items-center justify-center p-6 text-center select-none">
            <!-- Radial Grid Pattern Overlay -->
            <div class="absolute inset-0 bg-[radial-gradient(#334155_1px,transparent_1px)] [background-size:20px_20px] opacity-40"></div>
            
            <!-- Center Placeholder Icon & Badge -->
            <div class="relative z-10 flex flex-col items-center gap-3">
              <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-zinc-950/90 border border-zinc-800 shadow-inner flex items-center justify-center text-brand-mint">
                <svg class="h-7 w-7 sm:h-8 sm:w-8 text-brand-mint" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
              <span class="text-xs sm:text-sm font-mono font-bold uppercase tracking-widest text-zinc-400">
                ZYLO AI About Visual Placeholder
              </span>
            </div>

            <!-- Corner accent -->
            <div class="absolute top-4 left-4 sm:top-6 sm:left-6 z-10">
              <span class="inline-flex items-center bg-zinc-950/85 backdrop-blur-sm text-white rounded-full px-3 py-1.5 text-[9px] sm:text-[10px] font-mono font-bold uppercase tracking-widest border border-white/10">
                ZK Summit Holdings Inc.
              </span>
            </div>
          </div>

          <!-- Responsive Stat Card (Visible on Mobile & Desktop) -->
          <div class="mt-4 sm:mt-0 sm:absolute sm:-bottom-6 sm:-left-6 bg-brand-black rounded-2xl p-4 sm:px-6 sm:py-5 shadow-xl flex items-center justify-between sm:block border border-zinc-800 z-20">
            <div>
              <p class="font-mono text-[9px] uppercase tracking-widest text-zinc-400 mb-0.5">Market Focus</p>
              <p class="font-display font-black text-lg sm:text-2xl text-white leading-none">Philippines</p>
            </div>
            <span class="text-[11px] sm:text-xs text-brand-mint font-bold sm:mt-1 bg-brand-mint/10 sm:bg-transparent px-2.5 py-1 sm:p-0 rounded-lg">AI-Driven Wellness</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── 3. CORE MISSION PILLARS ───────────────────────────────── -->
  <section class="bg-zinc-950 py-10 sm:py-16 lg:py-[80px] overflow-hidden">
    <div class="mx-auto max-w-7xl px-5 sm:px-10 lg:px-16">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 sm:gap-12 lg:gap-16 items-center">
        <div>
          <h2 class="font-display font-black text-2xl sm:text-4xl lg:text-5xl text-white leading-tight tracking-tight uppercase">
            Premium wellness.<br/>
            <span class="text-brand-mint">Smart technology.</span><br/>
            Human-centered design.
          </h2>
        </div>
        <div class="space-y-4 sm:space-y-6 text-xs sm:text-sm text-zinc-400 font-medium leading-relaxed border-t border-zinc-800 pt-6 sm:pt-0 sm:border-t-0 sm:border-l sm:pl-8 lg:pl-10">
          <p>
            Founded under <strong class="text-white font-bold">Zion Soothing Haven Inc.</strong>, ZYLO AI combines premium wellness, smart technology, and human-centered design into one intelligent home fitness ecosystem.
          </p>
          <p>
            Built for modern Filipino families, professionals, executives, and active individuals who value <strong class="text-zinc-200">privacy, performance, and long-term wellness</strong>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── 4. KEY METRICS STRIP ───────────────────────────────────── -->
  <section class="bg-zinc-50 border-y border-zinc-200/80 py-10 sm:py-16 lg:py-[80px]">
    <div class="mx-auto max-w-7xl px-5 sm:px-10 lg:px-16">
      <dl class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6 lg:gap-0 lg:divide-x lg:divide-zinc-200">
        {[
          { num: "42", unit: "Points", label: "Skeletal AI Tracking" },
          { num: "23+", unit: "Machines", label: "Replaced by One System" },
          { num: "200", unit: "lbs", label: "Digital Resistance Range" },
          { num: "100%", unit: "No Sub", label: "Lifetime Software Access" }
        ].map((stat) => (
          <div class="flex flex-col bg-white sm:bg-transparent rounded-2xl p-4 sm:p-0 border border-zinc-200/70 sm:border-0 shadow-2xs sm:shadow-none lg:px-10 first:pl-0 last:pr-0">
            <dt class="font-mono text-[9px] sm:text-[9.5px] uppercase tracking-wider text-zinc-500 font-bold mb-1.5">{stat.label}</dt>
            <dd class="font-display font-black text-2xl sm:text-5xl text-brand-black leading-none flex items-baseline gap-1">
              <span>{stat.num}</span>
              <span class="text-emerald-500 text-sm sm:text-2xl font-bold">{stat.unit}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ─── 5. AEKE TECHNOLOGY SECTION ─────────────────────────────── -->
  <section class="bg-white py-10 sm:py-16 lg:py-[80px]">
    <div class="mx-auto max-w-7xl px-5 sm:px-10 lg:px-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-12 lg:gap-20 items-center">
        
        <!-- Left: Copy & 2-Col Mobile Pill Grid -->
        <div class="lg:col-span-5 order-1">
          <span class="inline-block font-mono text-[10px] font-bold uppercase tracking-[0.24em] text-emerald-600 mb-2">AEKE Powered</span>
          <h2 class="font-display font-black text-2xl sm:text-4xl text-brand-black leading-tight tracking-tight uppercase">
            Powered by<br/>
            Award-Winning<br/>
            <span class="text-emerald-500">AEKE Innovation</span>
          </h2>
          <div class="mt-4 sm:mt-6 text-xs sm:text-sm text-zinc-600 font-medium leading-relaxed">
            <p>
              ZYLO AI features AI coaching, real-time form correction, 42-point skeletal tracking, digital resistance, smart body assessment, and personalized workout plans that adapt to every user's progress.
            </p>
          </div>

          <!-- Feature Pills Grid (2-Cols on Mobile for Clean Layout) -->
          <div class="mt-6 sm:mt-8 grid grid-cols-2 gap-2 sm:gap-3">
            {[
              "AI Coaching",
              "Form Correction",
              "42-Point Tracking",
              "Digital Resistance",
              "Body Assessment",
              "Adaptive Plans"
            ].map((feat) => (
              <div class="flex items-center gap-2 rounded-xl border border-zinc-200/90 bg-zinc-50 px-3 py-2.5">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 shrink-0"></span>
                <span class="font-display font-bold text-[10.5px] sm:text-xs text-brand-black truncate">{feat}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: Visual Placeholder Box -->
        <div class="lg:col-span-7 order-2 relative">
          <div class="relative aspect-[4/3] rounded-2xl sm:rounded-3xl overflow-hidden bg-zinc-900 border border-zinc-800 shadow-md flex flex-col items-center justify-center p-6 text-center select-none">
            <!-- Radial Grid Pattern Overlay -->
            <div class="absolute inset-0 bg-[radial-gradient(#334155_1px,transparent_1px)] [background-size:20px_20px] opacity-40"></div>
            
            <!-- Center Placeholder Icon & Badge -->
            <div class="relative z-10 flex flex-col items-center gap-3">
              <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-zinc-950/90 border border-zinc-800 shadow-inner flex items-center justify-center text-brand-mint">
                <svg class="h-7 w-7 sm:h-8 sm:w-8 text-brand-mint" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
              <span class="text-xs sm:text-sm font-mono font-bold uppercase tracking-widest text-zinc-400">
                AEKE Innovation Visual Placeholder
              </span>
            </div>

            <!-- Tech label overlay -->
            <div class="absolute bottom-4 left-4 right-4 sm:bottom-6 sm:left-6 sm:right-6 text-left z-10">
              <p class="font-mono text-[9px] uppercase tracking-widest text-brand-mint mb-1">AEKE Innovation</p>
              <p class="font-display font-bold text-sm sm:text-lg text-white leading-snug">42-Point Skeletal Tracking &amp; Real-Time Form Correction</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── 6. SHOWROOM & MANIFESTO SPOTLIGHT ───────────────────────── -->
  <section class="relative bg-zinc-950 py-12 sm:py-20 lg:py-[80px] overflow-hidden text-center">
    <!-- Decorative mint vertical line -->
    <div class="absolute left-0 top-0 h-full w-[2px] bg-gradient-to-b from-transparent via-brand-mint/40 to-transparent"></div>
    <div class="absolute right-0 top-0 h-full w-[2px] bg-gradient-to-b from-transparent via-brand-mint/20 to-transparent"></div>

    <div class="mx-auto max-w-4xl px-5 sm:px-10 lg:px-16 relative z-10">
      <span class="inline-block font-mono text-[9px] sm:text-[10px] font-bold uppercase tracking-[0.28em] text-brand-mint mb-4">Our Commitment</span>
      <blockquote class="font-display font-black text-2xl sm:text-4xl lg:text-5xl text-white leading-tight tracking-tight uppercase">
        "More than a home gym, ZYLO AI is a step toward the future of <span class="text-brand-mint">intelligent wellness</span>."
      </blockquote>
      <p class="mt-6 sm:mt-10 text-xs sm:text-sm text-zinc-400 font-medium leading-relaxed max-w-2xl mx-auto">
        It reflects ZK Summit Holdings Inc.'s commitment to introduce AI-powered brands that are not only advanced, but also <strong class="text-zinc-200">practical, premium, and relevant to the Filipino lifestyle</strong>.
      </p>
    </div>
  </section>

  <!-- ─── 7. CORPORATE HIERARCHY CARDS ───────────────────────────── -->
  <section class="bg-white border-b border-zinc-200/80 py-10 sm:py-16 lg:py-[80px]">
    <div class="mx-auto max-w-7xl px-5 sm:px-10 lg:px-16">
      <div class="flex flex-col lg:flex-row items-start lg:items-center gap-8 lg:gap-16">
        <div class="lg:w-1/3 shrink-0">
          <span class="block font-mono text-[9.5px] font-bold uppercase tracking-[0.22em] text-zinc-400 mb-1">Corporate Group</span>
          <h2 class="font-display font-black text-xl sm:text-2xl text-brand-black leading-snug uppercase">ZK Summit Holdings Inc.</h2>
          <div class="mt-2.5 h-[2px] w-10 bg-emerald-500"></div>
        </div>
        <div class="flex-1 grid grid-cols-1 sm:grid-cols-3 gap-3.5 sm:gap-6 w-full">
          {[
            { label: "Holding Company", value: "ZK Summit Holdings Inc.", desc: "Strategic innovation toward AI-driven brands." },
            { label: "Operating Brand", value: "Zion Soothing Haven Inc.", desc: "Founded ZYLO AI as its premier AI wellness venture." },
            { label: "Technology Partner", value: "AEKE", desc: "Award-winning smart gym innovation powering ZYLO AI." }
          ].map((item) => (
            <div class="bg-zinc-50 border border-zinc-200/80 rounded-2xl p-4 sm:p-5 hover:border-emerald-400/60 hover:bg-white transition-all duration-300 shadow-2xs">
              <p class="font-mono text-[8.5px] sm:text-[9px] font-bold uppercase tracking-widest text-zinc-400 mb-1">{item.label}</p>
              <p class="font-display font-bold text-xs sm:text-sm text-brand-black leading-snug mb-1.5">{item.value}</p>
              <p class="text-[11px] text-zinc-500 font-medium leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ─── 8. FINAL CALL TO ACTION ─────────────────────────────────── -->
  <section class="bg-brand-black py-12 sm:py-20 lg:py-[80px] text-center">
    <div class="mx-auto max-w-3xl px-5 sm:px-6">
      <span class="inline-block font-mono text-[9px] sm:text-[10px] font-bold uppercase tracking-[0.28em] text-brand-mint mb-4">The Future of Fitness is Here</span>
      <h2 class="font-display font-black text-3xl sm:text-5xl lg:text-6xl text-white leading-tight tracking-tighter uppercase">
        ZYLO AI.<br/>
        <span class="text-brand-mint">Train with Intelligence.</span>
      </h2>
      <p class="mt-4 sm:mt-8 text-xs sm:text-sm text-zinc-400 font-medium leading-relaxed max-w-md mx-auto">
        Experience the world's most advanced AI-powered home gym, built for Filipino homes.
      </p>

      <div class="mt-8 sm:mt-10 flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 sm:gap-4 max-w-md mx-auto">
        <a
          href="/products"
          class="btn-spring min-h-[48px] inline-flex items-center justify-center gap-2 rounded-xl bg-brand-mint px-6 py-3.5 text-xs font-bold tracking-widest uppercase text-brand-black hover:opacity-90 active:scale-[0.98] transition-all cursor-pointer"
        >
          <span>Explore Products</span>
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a
          href="/contact#showrooms"
          class="min-h-[48px] inline-flex items-center justify-center gap-2 rounded-xl border border-zinc-700 bg-zinc-900/60 hover:bg-zinc-800 px-6 py-3.5 text-xs font-bold tracking-widest uppercase text-zinc-300 hover:text-white active:scale-[0.98] transition-all cursor-pointer"
        >
          <span>Visit Showroom</span>
        </a>
      </div>
    </div>
  </section>

</Layout>
