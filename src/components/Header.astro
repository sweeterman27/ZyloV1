    <!-- Empty Bag Icon -->
    <div class="w-16 h-16 rounded-2xl bg-zinc-100 border border-zinc-200/80 flex items-center justify-center mx-auto mb-5 shrink-0 shadow-2xs text-zinc-400">
      <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
