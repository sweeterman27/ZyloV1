  id="cart-toast"
  class="fixed bottom-6 left-1/2 -translate-x-1/2 z-[99999] flex items-center gap-3 px-4 py-3 rounded-2xl bg-brand-black/95 backdrop-blur-md text-white border border-white/15 shadow-2xl transition-all duration-300 opacity-0 pointer-events-none translate-y-4 max-w-sm w-[92vw] sm:w-auto"
>
  <div class="h-8 w-8 rounded-xl bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-center shrink-0 text-brand-mint">
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
