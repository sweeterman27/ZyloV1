---
const rawPath = Astro.url.pathname;
// Normalize: remove trailing slash except for root "/"
const currentPath = rawPath === "/" ? "/" : rawPath.replace(/\/$/, "");
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-[9999] w-full border-b border-brand-midGray/60 bg-white/90 backdrop-blur-md transition-all duration-300 ease-out transform"
>
  <div
    class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8 w-full relative"
  >
    <!-- Mobile Hamburger Button (Left on Mobile) -->
    <div class="flex items-center md:hidden w-11 justify-start">
      <button
        type="button"
        id="mobile-menu-button"
        class="flex h-11 w-11 items-center justify-center rounded-xl border border-zinc-200 bg-zinc-50 text-brand-black hover:bg-zinc-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-mint transition-all shrink-0"
        aria-expanded="false"
        aria-controls="mobile-menu-drawer"
        aria-label="Toggle Navigation Menu"
      >
        <svg
          class="h-5 w-5 stroke-current"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
        </svg>
      </button>
    </div>

    <!-- Brand Logo (Centered on Mobile, Left on Desktop) -->
    <div class="flex flex-shrink-0 items-center absolute left-1/2 -translate-x-1/2 md:static md:translate-x-0">
      <a
        href="/"
        class="flex items-center focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-mint focus-visible:ring-offset-2 rounded"
        aria-label="ZYLO AI Home"
      >
        <img src="/assets/REVAMPED/revamp website_/home page/assets/ZYLO AI logo no sub.webp"
          alt="ZYLO AI Logo"
          class="h-6 w-auto object-contain"
          loading="eager"
          decoding="async" />
      </a>
    </div>

    <!-- Navigation Links (Center on Desktop) -->
    <nav
      class="hidden md:flex items-center space-x-1 lg:space-x-3"
      aria-label="Main Navigation"
    >
      <!-- Home Link -->
      <div class="relative flex flex-col items-center">
        <a
          href="/"
          class={`px-3 py-2 text-sm transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-mint ${
            currentPath === "/"
              ? "font-bold text-brand-black"
              : "font-semibold text-zinc-600 hover:text-brand-black"
          }`}
          aria-current={currentPath === "/" ? "page" : undefined}
        >
          Home
        </a>
        {
          currentPath === "/" && (
            <span class="absolute bottom-0 left-3 right-3 h-[3px] bg-brand-mint rounded-full" />
          )
        }
      </div>

      <!-- Product Link -->
      <div class="relative flex flex-col items-center">
        <a
          href="/products"
          class={`px-3 py-2 text-sm transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-mint ${
            currentPath.startsWith("/products") || currentPath.startsWith("/zylo-")
              ? "font-bold text-brand-black"
              : "font-semibold text-zinc-600 hover:text-brand-black"
          }`}
          aria-current={currentPath.startsWith("/products") ? "page" : undefined}
        >
          Product
        </a>
        {
          (currentPath.startsWith("/products") || currentPath.startsWith("/zylo-")) && (
            <span class="absolute bottom-0 left-3 right-3 h-[3px] bg-brand-mint rounded-full" />
          )
        }
      </div>

      <!-- AI Technology Link -->
      <div class="relative flex flex-col items-center">
        <a
          href="/ai-technology"
          class={`px-3 py-2 text-sm transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-mint ${
            currentPath === "/ai-technology"
              ? "font-bold text-brand-black"
              : "font-semibold text-zinc-600 hover:text-brand-black"
          }`}
          aria-current={currentPath === "/ai-technology" ? "page" : undefined}
        >
          AI Technology
        </a>
        {
          currentPath === "/ai-technology" && (
            <span class="absolute bottom-0 left-3 right-3 h-[3px] bg-brand-mint rounded-full" />
          )
        }
      </div>

      <!-- About Us Link -->
      <div class="relative flex flex-col items-center">
        <a
          href="/about"
          class={`px-3 py-2 text-sm transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-mint ${
            currentPath === "/about"
              ? "font-bold text-brand-black"
              : "font-semibold text-zinc-600 hover:text-brand-black"
          }`}
          aria-current={currentPath === "/about" ? "page" : undefined}
        >
          About Us
        </a>
        {
          currentPath === "/about" && (
            <span class="absolute bottom-0 left-3 right-3 h-[3px] bg-brand-mint rounded-full" />
          )
        }
      </div>

      <!-- Blog Link -->
      <div class="relative flex flex-col items-center">
        <a
          href="/blog"
          class={`px-3 py-2 text-sm transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-mint ${
            currentPath.startsWith("/blog")
              ? "font-bold text-brand-black"
              : "font-semibold text-zinc-600 hover:text-brand-black"
          }`}
          aria-current={currentPath.startsWith("/blog") ? "page" : undefined}
        >
          Blog
        </a>
        {
          currentPath.startsWith("/blog") && (
            <span class="absolute bottom-0 left-3 right-3 h-[3px] bg-brand-mint rounded-full" />
          )
        }
      </div>

      <!-- Gallery Link -->
      <div class="relative flex flex-col items-center">
        <a
          href="/gallery"
          class={`px-3 py-2 text-sm transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-mint ${
            currentPath === "/gallery"
              ? "font-bold text-brand-black"
              : "font-semibold text-zinc-600 hover:text-brand-black"
          }`}
          aria-current={currentPath === "/gallery" ? "page" : undefined}
        >
          Gallery
        </a>
        {
          currentPath === "/gallery" && (
            <span class="absolute bottom-0 left-3 right-3 h-[3px] bg-brand-mint rounded-full" />
          )
        }
      </div>

      <!-- Contact Us Link -->
      <div class="relative flex flex-col items-center">
        <a
          href="/contact"
          class={`px-3 py-2 text-sm transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-mint ${
            currentPath === "/contact"
              ? "font-bold text-brand-black"
              : "font-semibold text-zinc-600 hover:text-brand-black"
          }`}
          aria-current={currentPath === "/contact" ? "page" : undefined}
        >
          Contact Us
        </a>
        {
          currentPath === "/contact" && (
            <span class="absolute bottom-0 left-3 right-3 h-[3px] bg-brand-mint rounded-full" />
          )
        }
      </div>
    </nav>

    <!-- Utilities & CTA (Right - UNIVERSAL VIEW) -->
    <div class="flex items-center gap-1 sm:gap-3">
      <!-- Universal Header Action Icons (Search, Account, Cart) -->
      <div class="flex items-center gap-0.5 sm:gap-1">
        <!-- 1. Search Trigger (Opens Live Search Modal) -->
        <button
          type="button"
          class="search-modal-trigger flex h-9 w-9 items-center justify-center rounded-full text-zinc-700 hover:text-brand-black hover:bg-zinc-100 active:scale-95 focus:outline-none transition-all cursor-pointer"
          aria-label="Search site"
          title="Search"
        >
          <svg
            class="h-4.5 w-4.5 sm:h-5 sm:w-5 shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </button>

        <!-- 2. Account Link (Hidden on Mobile, Visible on Desktop) -->
        <a
          href="/account"
          class="hidden md:flex h-9 w-9 items-center justify-center rounded-full text-zinc-700 hover:text-brand-black hover:bg-zinc-100 active:scale-95 focus:outline-none transition-all cursor-pointer"
          aria-label="User Account"
          title="Account"
        >
          <svg
            class="h-4.5 w-4.5 sm:h-5 sm:w-5 shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
            ></path>
          </svg>
        </a>

        <!-- 3. Cart Link (Redirects to /cart with Live Badge Counter) -->
        <a
          href="/cart"
          id="header-cart-icon-link"
          class="flex h-9 w-9 items-center justify-center rounded-full text-zinc-700 hover:text-brand-black hover:bg-zinc-100 active:scale-95 focus:outline-none transition-all relative cursor-pointer"
          aria-label="Shopping Cart"
          title="Cart"
        >
          <svg
            class="h-4.5 w-4.5 sm:h-5 sm:w-5 shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
          </svg>
          <span
            id="cart-badge-count"
            class="hidden absolute -top-1 -right-1 h-4.5 min-w-[18px] px-1 items-center justify-center rounded-full bg-[#34d399] text-brand-black text-[10px] font-black leading-none shadow-xs transition-all duration-200"
          >0</span>
        </a>
      </div>

      <!-- Primary CTA: Visit Showroom (Desktop Only) -->
      <a
        href="/contact#showrooms"
        class="hidden lg:inline-flex btn-spring items-center justify-center gap-2 rounded-xl bg-brand-black px-4 py-2.5 text-xs font-bold text-white hover:bg-neutral-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-mint focus-visible:ring-offset-2 shrink-0 cursor-pointer"
      >
        <span class="relative flex h-2 w-2 shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
        </span>
        <span>Visit Showroom</span>
      </a>
    </div>
  </div>
</header>

<!-- Mobile Backdrop Scrim (Fixed to Viewport, Z-Index 9998) -->
<div
  id="mobile-backdrop"
  class="fixed inset-0 bg-brand-black/60 backdrop-blur-sm z-[9998] opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
></div>

<!-- Mobile Side-Over Drawer Panel (Fixed to Viewport, Z-Index 9999) -->
<div
  id="mobile-menu-drawer"
  class="fixed inset-y-0 left-0 w-[85%] max-w-sm bg-white z-[9999] -translate-x-full transition-transform duration-300 ease-out shadow-2xl flex flex-col justify-between p-6 sm:p-8 md:hidden overflow-y-auto"
>
  <!-- Drawer Header: Brand Logo + Close Button -->
  <div>
    <div class="flex items-center justify-between pb-6 border-b border-zinc-100">
      <a href="/" class="flex items-center">
        <img src="/assets/REVAMPED/revamp website_/home page/assets/ZYLO AI logo no sub.webp"
          alt="ZYLO AI Logo"
          class="h-6 w-auto object-contain"
        decoding="async" loading="lazy" />
      </a>
      <button
        type="button"
        id="mobile-close-button"
        class="flex h-10 w-10 items-center justify-center rounded-xl border border-zinc-200 bg-zinc-50 text-brand-black hover:bg-zinc-100 transition-colors"
        aria-label="Close Menu"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Navigation Links List (Sleek Professional Active Pill + Mint Dot Indicator) -->
    <nav class="mt-8 flex flex-col gap-2">
      <!-- 1. Home -->
      <a
        href="/"
        class={`flex items-center justify-between rounded-xl px-4 py-3.5 text-base transition-all duration-200 ${
          currentPath === "/"
            ? "bg-brand-black text-white font-bold shadow-sm"
            : "text-zinc-600 font-semibold hover:bg-zinc-100/80 hover:text-brand-black"
        }`}
      >
        <div class="flex items-center gap-2.5">
          {currentPath === "/" && (
            <span class="h-2 w-2 rounded-full bg-brand-mint shadow-[0_0_8px_#30c18a] shrink-0" />
          )}
          <span>Home</span>
        </div>
        <svg
          class={`h-4 w-4 ${currentPath === "/" ? "text-brand-mint" : "text-zinc-400"}`}
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      </a>

      <!-- 2. Products Section (Direct Link + Simple Clean Dropdown Chevron Icon) -->
      <div class="flex flex-col gap-1">
        <div
          class={`flex items-center justify-between rounded-xl px-4 py-3.5 text-base transition-all duration-200 ${
            (currentPath.startsWith("/products") || currentPath.startsWith("/zylo-"))
              ? "bg-brand-black text-white font-bold shadow-sm"
              : "text-zinc-600 font-semibold hover:bg-zinc-100/80 hover:text-brand-black"
          }`}
        >
          <!-- Left Link (Clicking Products text goes directly to /products overview) -->
          <a href="/products" class="flex-1 flex items-center gap-2.5">
            {(currentPath.startsWith("/products") || currentPath.startsWith("/zylo-")) && (
              <span class="h-2 w-2 rounded-full bg-brand-mint shadow-[0_0_8px_#30c18a] shrink-0" />
            )}
            <span>Products</span>
          </a>

          <!-- Right Simple Chevron Dropdown Icon Button -->
          <button
            type="button"
            id="mobile-products-toggle"
            class="p-1 -mr-1 cursor-pointer shrink-0 active:scale-95 transition-transform"
            aria-label="Toggle Products Sub-Menu"
          >
            <svg
              id="mobile-products-chevron"
              class={`h-4 w-4 transform transition-transform duration-300 ${(currentPath.startsWith("/products") || currentPath.startsWith("/zylo-")) ? "rotate-180 text-brand-mint" : "text-zinc-400 hover:text-brand-black"}`}
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
        </div>

        <!-- Sub-Menu (No Badges!) -->
        <div
          id="mobile-products-sub-menu"
          class={`ml-3 pl-3.5 border-l-2 border-emerald-400/50 flex flex-col gap-1 py-1 text-sm font-semibold ${
            (currentPath.startsWith("/products") || currentPath.startsWith("/zylo-")) ? "block" : "hidden"
          }`}
        >
          <a
            href="/products/zylo-k1"
            class={`flex items-center justify-between px-3.5 py-2.5 rounded-lg transition-colors ${
              currentPath.includes("zylo-k1")
                ? "bg-emerald-500/10 text-emerald-600 font-bold"
                : "text-zinc-600 hover:bg-zinc-100 hover:text-brand-black"
            }`}
          >
            <span>ZYLO K1 AI Home Gym</span>
          </a>
          <a
            href="/products/zylo-s1"
            class={`flex items-center justify-between px-3.5 py-2.5 rounded-lg transition-colors ${
              currentPath.includes("zylo-s1")
                ? "bg-emerald-500/10 text-emerald-600 font-bold"
                : "text-zinc-600 hover:bg-zinc-100 hover:text-brand-black"
            }`}
          >
            <span>ZYLO S1 Pro Smart Home Gym</span>
          </a>
        </div>
      </div>

      <!-- Other Links -->
      {[
        { href: "/ai-technology", label: "AI Technology", active: currentPath === "/ai-technology" },
        { href: "/about", label: "About Us", active: currentPath === "/about" },
        { href: "/blog", label: "Blog", active: currentPath.startsWith("/blog") },
        { href: "/gallery", label: "Gallery", active: currentPath === "/gallery" }
      ].map((link) => (
        <a
          href={link.href}
          class={`flex items-center justify-between rounded-xl px-4 py-3.5 text-base transition-all duration-200 ${
            link.active
              ? "bg-brand-black text-white font-bold shadow-sm"
              : "text-zinc-600 font-semibold hover:bg-zinc-100/80 hover:text-brand-black"
          }`}
        >
          <div class="flex items-center gap-2.5">
            {link.active && (
              <span class="h-2 w-2 rounded-full bg-brand-mint shadow-[0_0_8px_#30c18a] shrink-0" />
            )}
            <span>{link.label}</span>
          </div>
          <svg
            class={`h-4 w-4 ${link.active ? "text-brand-mint" : "text-zinc-400"}`}
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      ))}
    </nav>
  </div>

  <!-- Drawer Footer Actions -->
  <div class="mt-8 pt-6 border-t border-zinc-100 flex flex-col gap-4">
    <a
      href="/contact#showrooms"
      class="flex w-full items-center justify-center gap-2 rounded-2xl bg-brand-black py-3.5 text-sm font-bold text-white hover:bg-neutral-800 transition-colors shadow-md cursor-pointer"
    >
      <span class="relative flex h-2 w-2 shrink-0">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
      </span>
      <span>Visit Showroom</span>
    </a>

    <!-- Quick Contact Info & Secondary Actions -->
    <div class="grid grid-cols-2 gap-2 pt-1">
      <button
        type="button"
        class="account-modal-trigger flex items-center justify-center gap-2 rounded-xl border border-zinc-200 bg-zinc-50 py-3 text-xs font-bold text-zinc-700 hover:bg-zinc-100 transition-colors cursor-pointer"
      >
        <svg class="h-4 w-4 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <span>Account</span>
      </button>
      <button
        type="button"
        class="cart-empty-trigger flex items-center justify-center gap-2 rounded-xl border border-zinc-200 bg-zinc-50 py-3 text-xs font-bold text-zinc-700 hover:bg-zinc-100 transition-colors cursor-pointer"
      >
        <svg class="h-4 w-4 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
        <span>Cart</span>
      </button>
    </div>

    <div class="flex items-center justify-center gap-2 text-xs font-semibold text-zinc-400 pt-1">
      <span class="inline-block h-2 w-2 rounded-full bg-emerald-400"></span>
      <span>ZYLO AI Showroom • Manila</span>
    </div>
  </div>
</div>

<!-- ZYLO AI Order Modal Overlay (Concept Inspired by Reference Order Form) -->
<div
  id="order-modal"
  class="fixed inset-0 z-[10000] flex items-center justify-center bg-zinc-950/60 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300 p-4 overflow-y-auto"
  role="dialog"
  aria-modal="true"
>
  <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl relative my-8 transform transition-all duration-300 scale-95 border border-zinc-200/80 text-left">
    <!-- Close Button -->
    <button
      type="button"
      id="order-modal-close"
      class="absolute top-5 right-5 text-zinc-400 hover:text-brand-black transition-colors focus:outline-none p-2 rounded-xl hover:bg-zinc-100 cursor-pointer"
      aria-label="Close order form"
    >
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Modal Title -->
    <div class="mb-5 pr-8">
      <span class="text-[11px] font-mono font-bold uppercase tracking-widest text-brand-mint block mb-1">
        Place Your Order
      </span>
      <h2 class="font-display font-extrabold text-xl sm:text-2xl text-brand-black tracking-tight" id="modal-order-product-title">
        ZYLO K1 AI Smart Home Gym
      </h2>
    </div>

    <!-- Form & Calculator -->
    <form id="modal-order-form" class="space-y-4">
      
      <!-- Item Summary Box -->
      <div class="bg-zinc-50 border border-zinc-200/80 rounded-2xl p-4 sm:p-5 space-y-3">
        


        <div class="space-y-1.5 text-xs pt-1">
          <div class="flex justify-between items-center text-zinc-600 font-medium">
            <span>Configuration</span>
            <span id="modal-summary-config" class="font-bold text-brand-black">Compact AI Foldable</span>
          </div>

          <div class="flex justify-between items-center text-zinc-600 font-medium">
            <span>Unit Price</span>
            <span id="modal-summary-unit-price" class="font-bold text-brand-black">₱188,000</span>
          </div>

          <div class="flex justify-between items-center pt-1">
            <span class="text-zinc-600 font-medium">Quantity</span>
            <div class="flex items-center gap-3 bg-white border border-zinc-200 rounded-lg px-2 py-0.5">
              <button type="button" id="modal-qty-minus" class="w-5 h-5 rounded flex items-center justify-center text-zinc-500 hover:bg-zinc-100 font-bold cursor-pointer">-</button>
              <span id="modal-qty-val" class="font-bold text-brand-black text-xs w-4 text-center">1</span>
              <button type="button" id="modal-qty-plus" class="w-5 h-5 rounded flex items-center justify-center text-zinc-500 hover:bg-zinc-100 font-bold cursor-pointer">+</button>
            </div>
          </div>
        </div>

        <div class="border-t border-zinc-200/80 pt-2.5 flex justify-between items-center">
          <span class="font-display font-extrabold text-xs text-brand-black">Total</span>
          <span id="modal-order-total" class="font-display font-extrabold text-base text-brand-black">₱188,000</span>
        </div>

        <!-- Free Gifts Included -->
        <div class="mt-2.5 pt-2 border-t border-dashed border-zinc-200 space-y-1">
          <div class="flex items-center gap-1.5 text-[11px] font-bold text-brand-black">
            <svg class="w-3.5 h-3.5 text-brand-mint" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V6a2 2 0 10-2 2h2zm0 13C10.832 21 2 20 2 14.5 2 9 12 3 12 3s10 6 10 11.5C22 20 13.168 21 12 21z" />
            </svg>
            <span>Included Accessories (Free)</span>
          </div>
