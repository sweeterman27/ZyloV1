    class="text-[11px] font-extrabold text-brand-mint hover:text-white uppercase tracking-wider pl-2 border-l border-white/10 shrink-0 transition-colors"
  >
    View Cart →
  </a>
</div>

<script>
  (function () {
    const btn = document.getElementById("mobile-menu-button");
    const closeBtn = document.getElementById("mobile-close-button");
    const drawer = document.getElementById("mobile-menu-drawer");
    const backdrop = document.getElementById("mobile-backdrop");
    const siteHeader = document.getElementById("site-header");

    const accountModal = document.getElementById("account-modal");
    const accountModalClose = document.getElementById("account-modal-close");
    const accountModalContactBtn = document.getElementById("account-modal-contact-btn");
    const accountTriggers = document.querySelectorAll(".account-modal-trigger");

    const orderModal = document.getElementById("order-modal");
    const orderModalClose = document.getElementById("order-modal-close");
    const orderModalForm = document.getElementById("modal-order-form");
    const orderModalSuccess = document.getElementById("modal-order-success");
    const orderModalSuccessDone = document.getElementById("modal-success-done-btn");
    const orderTriggers = document.querySelectorAll(".order-modal-trigger");

    const cartEmptyModal = document.getElementById("cart-empty-modal");
    const cartEmptyModalClose = document.getElementById("cart-empty-modal-close");
    const cartEmptyOrderBtn = document.getElementById("cart-empty-order-btn");
    const cartTriggers = document.querySelectorAll(".cart-empty-trigger");

    // Universal Cart Badge Counter & Notification Manager
    function updateCartBadge() {
      const badge = document.getElementById("cart-badge-count");
      if (!badge) return;
      try {
        const items = JSON.parse(localStorage.getItem("zylo_cart_items") || "[]");
        const totalCount = items.reduce((sum: number, item: any) => sum + (item.quantity || 1), 0);
        if (totalCount > 0) {
          badge.textContent = String(totalCount);
          badge.classList.remove("hidden");
          badge.classList.add("flex");
        } else {
          badge.classList.add("hidden");
          badge.classList.remove("flex");
        }
      } catch(e) {
        badge.classList.add("hidden");
      }
    }

    let toastTimeout: any = null;
    function showCartToast(msg: string) {
      const toast = document.getElementById("cart-toast");
      const toastMsg = document.getElementById("cart-toast-msg");
      if (!toast || !toastMsg) return;
      toastMsg.textContent = msg;
      toast.classList.remove("opacity-0", "pointer-events-none", "translate-y-4");
      toast.classList.add("opacity-100", "translate-y-0");

      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.classList.remove("opacity-100", "translate-y-0");
        toast.classList.add("opacity-0", "pointer-events-none", "translate-y-4");
      }, 2800);
    }

    updateCartBadge();
    window.addEventListener("zylo-cart-updated", updateCartBadge);
    window.addEventListener("zylo-show-toast", (e: any) => {
      if (e.detail) showCartToast(e.detail);
    });
    window.addEventListener("storage", updateCartBadge);

    // Search Modal Elements & Engine
    const searchTriggers = document.querySelectorAll(".search-modal-trigger");
    const searchModal = document.getElementById("search-modal");
    const searchModalCard = document.getElementById("search-modal-card");
    const searchModalClose = document.getElementById("search-modal-close");
    const searchInput = document.getElementById("search-input") as HTMLInputElement;
    const searchDefault = document.getElementById("search-default-suggestions");
    const searchLive = document.getElementById("search-live-results");

    const searchableItems = [
      { title: "ZYLO K1 AI Home Gym", desc: "Compact strength mirror with 220 lbs digital resistance", url: "/products/zylo-k1", tag: "Product" },
      { title: "ZYLO S1 Pro Smart Home Gym", desc: "Full-body workout system with built-in bench & bar", url: "/products/zylo-s1", tag: "Product" },
      { title: "AI Real-Time Posture Scan", desc: "Form tracking and 3D movement analysis", url: "/ai-technology", tag: "AI Tech" },
      { title: "Adaptive Digital Resistance", desc: "Electromagnetic motor load up to 220 lbs", url: "/ai-technology#resistance", tag: "AI Tech" },
      { title: "Manila Fitness Showroom", desc: "Visit our physical demo center to try ZYLO AI in person", url: "/contact#showrooms", tag: "Showroom" },
      { title: "300+ AI Workouts Library", desc: "Strength, Cardio, Yoga, Pilates, Boxing, Mobility", url: "/#library-heading", tag: "Workouts" },
      { title: "Best Home Gym Equipment Philippines", desc: "Read our guide on smart fitness systems in PH", url: "/blog/best-home-gym-equipment-in-the-philippines", tag: "Blog" },
      { title: "Contact Sales & Inquiry", desc: "Get in touch with a ZYLO specialist", url: "/contact", tag: "Page" },
    ];

    function openSearchModal() {
      if (!searchModal || !searchModalCard) return;
      searchModal.classList.remove("opacity-0", "pointer-events-none");
      searchModal.classList.add("opacity-100");
      searchModalCard.classList.remove("scale-95");
      searchModalCard.classList.add("scale-100");
      document.body.style.overflow = "hidden";
      setTimeout(() => searchInput?.focus(), 150);
    }

    function closeSearchModal() {
      if (!searchModal || !searchModalCard) return;
      searchModal.classList.remove("opacity-100");
      searchModal.classList.add("opacity-0", "pointer-events-none");
      searchModalCard.classList.remove("scale-100");
      searchModalCard.classList.add("scale-95");
      document.body.style.overflow = "";
      if (searchInput) searchInput.value = "";
      if (searchDefault) searchDefault.classList.remove("hidden");
      if (searchLive) {
        searchLive.classList.add("hidden");
        searchLive.innerHTML = "";
      }
    }

    searchTriggers.forEach((btn) => btn.addEventListener("click", openSearchModal));
    searchModalClose?.addEventListener("click", closeSearchModal);
    searchModal?.addEventListener("click", (e) => {
      if (e.target === searchModal) closeSearchModal();
    });

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeSearchModal();
    });

    // Custom green clear (×) button
    document.getElementById("search-clear-btn")?.addEventListener("click", () => {
      if (searchInput) {
        searchInput.value = "";
        searchInput.focus();
      }
      document.getElementById("search-clear-btn")?.classList.add("hidden");
      if (searchDefault) searchDefault.classList.remove("hidden");
      if (searchLive) { searchLive.classList.add("hidden"); searchLive.innerHTML = ""; }
    });

    const searchClearBtn = document.getElementById("search-clear-btn");

    searchInput?.addEventListener("input", (e) => {
      const q = (e.target as HTMLInputElement).value.trim().toLowerCase();
      if (searchClearBtn) {
        if ((e.target as HTMLInputElement).value.length > 0) {
          searchClearBtn.classList.remove("hidden");
        } else {
          searchClearBtn.classList.add("hidden");
        }
      }
      if (!q) {
        if (searchDefault) searchDefault.classList.remove("hidden");
        if (searchLive) {
          searchLive.classList.add("hidden");
          searchLive.innerHTML = "";
        }
        return;
      }

      if (searchDefault) searchDefault.classList.add("hidden");
      if (searchLive) {
        searchLive.classList.remove("hidden");
        const matches = searchableItems.filter(item =>
          item.title.toLowerCase().includes(q) || item.desc.toLowerCase().includes(q) || item.tag.toLowerCase().includes(q)
        );

        if (matches.length === 0) {
          searchLive.innerHTML = `
            <div class="text-center py-8 text-zinc-500">
              <p class="text-xs font-medium mb-1">No results found for "${q}"</p>
              <p class="text-[11px] text-zinc-400">Try searching for "K1", "S1", "Posture", or "Showroom"</p>
            </div>
          `;
        } else {
          searchLive.innerHTML = matches.map(item => `
            <a href="${item.url}" class="flex items-center justify-between p-3 rounded-xl border border-zinc-200/80 hover:border-zinc-900 hover:bg-zinc-50 transition-all group">
              <div>
                <div class="text-xs font-bold text-zinc-900 group-hover:text-black">${item.title}</div>
                <div class="text-[11px] text-zinc-500 mt-0.5">${item.desc}</div>
              </div>
              <span class="px-2 py-0.5 rounded-md bg-zinc-100 text-[10px] font-mono text-zinc-600 shrink-0 ml-3">${item.tag}</span>
            </a>
          `).join("");
        }
      }
    });

    if (!btn || !drawer || !backdrop) return;

    function openDrawer() {
      btn?.setAttribute("aria-expanded", "true");
      drawer?.classList.remove("-translate-x-full");
      drawer?.classList.add("translate-x-0");
      backdrop?.classList.remove("opacity-0", "pointer-events-none");
      backdrop?.classList.add("opacity-100");
      document.body.style.overflow = "hidden";
    }

    function closeDrawer() {
      btn?.setAttribute("aria-expanded", "false");
      drawer?.classList.remove("translate-x-0");
      drawer?.classList.add("-translate-x-full");
      backdrop?.classList.remove("opacity-100");
      backdrop?.classList.add("opacity-0", "pointer-events-none");
      document.body.style.overflow = "";
    }
    const mobileProdToggle = document.getElementById("mobile-products-toggle");
    const mobileProdSubMenu = document.getElementById("mobile-products-sub-menu");
    const mobileProdChevron = document.getElementById("mobile-products-chevron");

    if (mobileProdToggle && mobileProdSubMenu && mobileProdChevron) {
      mobileProdToggle.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        const isHidden = mobileProdSubMenu.classList.contains("hidden");
        if (isHidden) {
          mobileProdSubMenu.classList.remove("hidden");
          mobileProdSubMenu.classList.add("block");
          mobileProdChevron.classList.add("rotate-180");
        } else {
          mobileProdSubMenu.classList.add("hidden");
          mobileProdSubMenu.classList.remove("block");
          mobileProdChevron.classList.remove("rotate-180");
        }
      });
    }

    function openAccountModal() {
      if (btn?.getAttribute("aria-expanded") === "true") closeDrawer();
      accountModal?.classList.remove("opacity-0", "pointer-events-none");
      accountModal?.classList.add("opacity-100");
      accountModal?.querySelector(".scale-95")?.classList.remove("scale-95");
      document.body.style.overflow = "hidden";
    }

    function closeAccountModal() {
      accountModal?.classList.remove("opacity-100");
      accountModal?.classList.add("opacity-0", "pointer-events-none");
      accountModal?.querySelector("div")?.classList.add("scale-95");
      document.body.style.overflow = "";
    }

    function openOrderModal(targetProduct?: string | null) {
      if (btn?.getAttribute("aria-expanded") === "true") closeDrawer();

      // Automatically configure form based on targetProduct or current page URL
      const currentPath = window.location.pathname.toLowerCase();
      const isS1 = targetProduct === "s1" || currentPath.includes("zylo-s1") || currentPath.includes("s1");

      const k1Accessories = [
        "B1 Adjustable Training Bench",
        "Multi-Function Crossbar",
        "Smart 8-Electrode Body Composition Scale",
        "Crossbar Safety Unloader",
        "Smart Training Grips",
        "Ankle Straps",
        "Heart Rate Armband",
        "Yoga Mat",
        "Backup Resistance Cords",
        "Camera Privacy Cover"
      ];
      const s1Accessories = [
        "Pro-Grip Smart Handles (Pair)",
        "Reinforced Ankle Straps (Pair)",
        "Smart Barbell (Long Bar)",
        "Smart Heart Rate Armband",
        "High-Density Floor Mat",
        "Instructional Manual & Power Toolkit",
        "Smart Adjustable Bench"
      ];

      if (isS1) {
        mUnitPrice = 248000;
        if (mProdTitle) mProdTitle.textContent = "ZYLO S1 Pro Smart Home Gym";
        if (mUnitPriceEl) mUnitPriceEl.textContent = fmtPhp(248000);
        if (mConfigEl) mConfigEl.textContent = "Dual Motor 100kg Digital Resistance";
      } else {
        mUnitPrice = 188000;
        if (mProdTitle) mProdTitle.textContent = "ZYLO K1 AI Home Gym";
        if (mUnitPriceEl) mUnitPriceEl.textContent = fmtPhp(188000);
        if (mConfigEl) mConfigEl.textContent = "Compact AI Foldable";
      }

      const modalGiftsList = document.getElementById("modal-free-gifts-list");
      const currentGifts = isS1 ? s1Accessories : k1Accessories;
      if (modalGiftsList) {
        modalGiftsList.innerHTML = currentGifts.map(item => `
          <div class="flex justify-between items-center text-[10px] text-zinc-600 pl-4">
            <span>1× ${item}</span>
            <span class="font-bold text-brand-mint shrink-0 ml-2">FREE</span>
          </div>
        `).join('');
      }

      calcModal();

      orderModal?.classList.remove("opacity-0", "pointer-events-none");
      orderModal?.classList.add("opacity-100");
      orderModal?.querySelector(".scale-95")?.classList.remove("scale-95");
      document.body.style.overflow = "hidden";
    }

    function closeOrderModal() {
      orderModal?.classList.remove("opacity-100");
      orderModal?.classList.add("opacity-0", "pointer-events-none");
      orderModal?.querySelector("div")?.classList.add("scale-95");
      document.body.style.overflow = "";
    }

    function openCartEmptyModal() {
      if (btn?.getAttribute("aria-expanded") === "true") closeDrawer();
      cartEmptyModal?.classList.remove("opacity-0", "pointer-events-none");
      cartEmptyModal?.classList.add("opacity-100");
      cartEmptyModal?.querySelector(".scale-95")?.classList.remove("scale-95");
      document.body.style.overflow = "hidden";
    }

    function closeCartEmptyModal() {
      cartEmptyModal?.classList.remove("opacity-100");
      cartEmptyModal?.classList.add("opacity-0", "pointer-events-none");
      cartEmptyModal?.querySelector("div")?.classList.add("scale-95");
      document.body.style.overflow = "";
    }

    accountTriggers.forEach((trig) => {
      trig.addEventListener("click", (e) => {
        e.preventDefault();
        openAccountModal();
      });
    });

    orderTriggers.forEach((trig) => {
      trig.addEventListener("click", (e) => {
        e.preventDefault();
        const targetProd = trig.getAttribute("data-select-product");
        openOrderModal(targetProd);
      });
    });

    cartTriggers.forEach((trig) => {
      trig.addEventListener("click", (e) => {
        e.preventDefault();
        openCartEmptyModal();
      });
    });

    accountModalClose?.addEventListener("click", closeAccountModal);
    accountModalContactBtn?.addEventListener("click", closeAccountModal);
    accountModal?.addEventListener("click", (e) => {
      if (e.target === accountModal) closeAccountModal();
    });

    orderModalClose?.addEventListener("click", closeOrderModal);
    orderModalSuccessDone?.addEventListener("click", closeOrderModal);
    orderModal?.addEventListener("click", (e) => {
      if (e.target === orderModal) closeOrderModal();
    });

    cartEmptyModalClose?.addEventListener("click", closeCartEmptyModal);
    cartEmptyOrderBtn?.addEventListener("click", () => {
      closeCartEmptyModal();
      openOrderModal();
    });
    cartEmptyModal?.addEventListener("click", (e) => {
      if (e.target === cartEmptyModal) closeCartEmptyModal();
    });

    // Modal Interactive Order Calculator Logic
    let mUnitPrice = 188000;
    let mQty = 1;

    const mProdBtns = document.querySelectorAll(".modal-prod-btn");
    const mPayBtns = document.querySelectorAll(".modal-pay-pill");
    const mQtyMinus = document.getElementById("modal-qty-minus");
    const mQtyPlus = document.getElementById("modal-qty-plus");
    const mQtyVal = document.getElementById("modal-qty-val");
    const mProdTitle = document.getElementById("modal-order-product-title");
    const mUnitPriceEl = document.getElementById("modal-summary-unit-price");
    const mConfigEl = document.getElementById("modal-summary-config");
    const mTotalEl = document.getElementById("modal-order-total");
    const mSubmitBtnText = document.getElementById("modal-submit-btn-text");

    function fmtPhp(num: number) {
      return "₱" + num.toLocaleString("en-PH");
    }

    function calcModal() {
      const tot = mUnitPrice * mQty;
      if (mQtyVal) mQtyVal.textContent = mQty.toString();
      if (mTotalEl) mTotalEl.textContent = fmtPhp(tot);
      if (mSubmitBtnText) mSubmitBtnText.textContent = `Complete Order (${fmtPhp(tot)})`;
    }



    mPayBtns.forEach((b) => {
      b.addEventListener("click", () => {
        mPayBtns.forEach((x) => {
          x.classList.remove("active", "border-2", "border-brand-black", "bg-brand-black/5", "text-brand-black");
          x.classList.add("border", "border-zinc-200", "bg-white", "text-zinc-600");
        });
        b.classList.add("active", "border-2", "border-brand-black", "bg-brand-black/5", "text-brand-black");
        b.classList.remove("border", "border-zinc-200", "bg-white", "text-zinc-600");
      });
    });

    mQtyMinus?.addEventListener("click", () => {
      if (mQty > 1) {
        mQty--;
        calcModal();
      }
    });

    mQtyPlus?.addEventListener("click", () => {
      if (mQty < 10) {
        mQty++;
        calcModal();
      }
    });

    // Unified Google Sheets Form Dispatcher
     const ZYLO_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbxV4hgMILSHCIhruPry9mgb-8buA1bdFKTCNgaKYIuhfd445MqVV2Kpc8UiyI_WzKz_Ig/exec";

    async function sendToGSheet(payload: Record<string, any>) {
      const gsheetUrl = (window as any).ZYLO_GSHEET_URL || localStorage.getItem("zylo_gsheet_url") || ZYLO_SCRIPT_URL;
      if (!gsheetUrl) return;

      try {
        await fetch(gsheetUrl, {
          method: "POST",
          mode: "no-cors",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ ...payload, timestamp: new Date().toLocaleString("en-PH", { timeZone: "Asia/Manila" }) })
        });
      } catch (err) {
        console.warn("GSheet submission error:", err);
      }
    }

    orderModalForm?.addEventListener("submit", (e) => {
      e.preventDefault();
      const nameInput = document.getElementById("modal-order-name") as HTMLInputElement | null;
      const emailInput = document.getElementById("modal-order-email") as HTMLInputElement | null;
      const phoneInput = document.getElementById("modal-order-phone") as HTMLInputElement | null;

      sendToGSheet({
        form_type: "Order Form (Modal)",
        product: (document.getElementById("modal-order-product-title")?.textContent || "").trim(),
        name: nameInput?.value || "",
        email: emailInput?.value || "",
        phone: phoneInput?.value || "",
        quantity: mQty,
        total_price: (document.getElementById("modal-order-total")?.textContent || "").trim()
      });

      if (orderModalForm) orderModalForm.style.display = "none";
      if (orderModalSuccess) orderModalSuccess.classList.remove("hidden");
    });

    btn.addEventListener("click", openDrawer);
    closeBtn?.addEventListener("click", closeDrawer);
    backdrop.addEventListener("click", closeDrawer);

    // Close drawer when clicking any link
    drawer.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeDrawer);
    });

    // Close on Escape key
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        if (btn.getAttribute("aria-expanded") === "true") closeDrawer();
        if (accountModal?.classList.contains("opacity-100")) closeAccountModal();
      }
    });

    // Bulletproof Smart Reveal Navigation Header
    let lastScrollY = window.scrollY || document.documentElement.scrollTop || 0;

    function handleHeaderScroll() {
      const currentScrollY = Math.max(0, window.scrollY || document.documentElement.scrollTop || 0);

      // Do not hide header if mobile drawer menu is currently open
      if (btn?.getAttribute("aria-expanded") === "true") return;

      // 1. Elevation shadow when scrolled past 10px
      if (currentScrollY > 10) {
        siteHeader?.classList.add("shadow-md");
      } else {
        siteHeader?.classList.remove("shadow-md");
      }

      // 2. Always reveal header near top of page
      if (currentScrollY <= 50) {
        siteHeader?.classList.remove("-translate-y-full");
      } else {
        // 3. Check scroll direction delta
        const scrollDelta = currentScrollY - lastScrollY;

        if (scrollDelta > 6) {
          // Scrolling DOWN -> hide header off-screen smoothly
          siteHeader?.classList.add("-translate-y-full");
        } else if (scrollDelta < -6) {
          // Scrolling UP -> reveal header back into view immediately
          siteHeader?.classList.remove("-translate-y-full");
        }
      }

      lastScrollY = currentScrollY;
    }

    window.addEventListener("scroll", handleHeaderScroll, { passive: true });
  })();
</script>
