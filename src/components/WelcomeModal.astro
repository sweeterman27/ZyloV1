---
// WelcomeModal.astro — ZYLO AI 3% Discount Popup Modal (Zylo Brand Typography & Theme)
---

<!-- Welcome Discount Modal Overlay (Z-Index 99999) -->
<div
  id="welcome-discount-modal"
  class="fixed inset-0 z-[99999] flex items-center justify-center p-4 sm:p-6 bg-zinc-950/65 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-500 ease-out"
  aria-modal="true"
  role="dialog"
  aria-labelledby="welcome-modal-heading"
>
  <!-- Modal Card Box (Solid White Brand Card - No Gradients) -->
  <div
    id="welcome-modal-card"
    class="relative w-full max-w-[480px] bg-white rounded-3xl sm:rounded-[32px] shadow-[0_25px_70px_-15px_rgba(0,0,0,0.3)] overflow-hidden flex flex-col transform scale-95 transition-all duration-500 ease-out border border-zinc-200/90"
  >
    <!-- Top Visual Showcase Image (Full Natural Aspect Ratio - Zero Cropping & No Hover Zoom) -->
    <div class="relative w-full aspect-[1666/1200] bg-zinc-100 overflow-hidden shrink-0 z-10">
      <img
        src="/assets/homepage/pop-up%20window/pop-up%20window.webp"
        alt="ZYLO Smart Home Gym Showcase"
        class="w-full h-full object-contain object-center block"
        loading="eager"
        decoding="async"
      />

      <!-- Circular Close Button (Top Right Floating Glass Button) -->
      <button
        type="button"
        id="close-welcome-modal"
        class="absolute top-4 right-4 z-20 flex h-9 w-9 items-center justify-center rounded-full border border-white/30 bg-black/40 text-white backdrop-blur-md hover:bg-black hover:scale-105 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-mint cursor-pointer shadow-md"
        aria-label="Close discount popup"
      >
        <svg class="h-4 w-4 stroke-current" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Content Panel (Pure White - Zylo Brand Typography) -->
    <div class="p-6 sm:p-8 flex flex-col text-center relative z-10 bg-white text-zinc-900">
      
      <!-- STEP 1: Email Subscription View -->
      <div id="welcome-step-1" class="flex flex-col flex-1 justify-between transition-all duration-300">
        <div>
          <!-- Eyebrow -->
          <div class="text-[10px] font-mono font-bold tracking-[0.25em] text-brand-mint uppercase mb-2">
            Welcome Discount
          </div>

          <!-- Zylo Display Headline -->
          <h2
            id="welcome-modal-heading"
            class="font-display font-black text-2xl sm:text-[28px] text-brand-black uppercase tracking-tight leading-tight mb-2"
          >
            GET 3% OFF YOUR FIRST ORDER
          </h2>

          <!-- Subtitle Branding -->
          <p class="text-xs sm:text-sm text-zinc-600 font-medium leading-relaxed mb-6">
            Here at <span class="font-bold text-brand-black uppercase tracking-wider">Z Y L O</span>, <span class="italic text-zinc-700">#TrainSmarter</span>.
          </p>

          <!-- Email Form -->
          <form id="welcome-discount-form" class="flex flex-col gap-3.5">
            <!-- Email Pill Input -->
            <div class="relative">
              <input
                type="email"
                id="welcome-discount-email"
                required
                placeholder="Enter your email address..."
                class="w-full px-6 py-4 rounded-full border border-zinc-200 bg-zinc-50 text-sm text-zinc-900 placeholder:text-zinc-400 text-center sm:text-left focus:outline-none focus:border-brand-mint focus:bg-white focus:ring-2 focus:ring-brand-mint/20 transition-all font-medium shadow-2xs"
              />
            </div>

            <!-- Zylo Solid Dark CTA Button (No Gradient) -->
            <button
              type="submit"
              id="welcome-submit-btn"
              class="w-full py-4 px-6 rounded-full bg-brand-black text-white hover:bg-zinc-800 font-extrabold text-xs sm:text-sm uppercase tracking-wider flex items-center justify-center gap-2.5 shadow-md active:scale-[0.99] transition-all cursor-pointer group"
            >
              <svg class="h-4.5 w-4.5 text-brand-mint group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
              <span id="submit-btn-text">SIGN UP TODAY &amp; CLAIM 3% OFF</span>
            </button>
          </form>
        </div>

        <!-- Privacy Disclaimer -->
        <p class="text-[11px] text-zinc-500 leading-relaxed max-w-xs mx-auto mt-5">
          By signing up you agree to receive marketing emails from Zylo. You can unsubscribe anytime.
        </p>
      </div>

      <!-- STEP 2: Unlocked Promo Code View (Hidden initially) -->
      <div id="welcome-step-2" class="hidden flex-col flex-1 justify-between gap-5 transition-all duration-300">
        <div>
          <!-- Eyebrow Badge -->
          <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-[11px] font-bold uppercase tracking-wider mx-auto mb-3 shadow-2xs">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            ✦ Voucher Unlocked!
          </div>

          <h2 class="font-display font-black text-2xl sm:text-3xl text-brand-black uppercase tracking-tight mb-2">
            HERE IS YOUR 3% DISCOUNT
          </h2>

          <p class="text-xs text-zinc-600 leading-relaxed mb-5">
            Use this promo code at checkout to claim 3% off your entire order:
          </p>

          <!-- Promo Code Box -->
          <div class="p-4.5 rounded-2xl bg-zinc-50 border border-zinc-200 text-zinc-900 flex items-center justify-between gap-3 shadow-sm mb-5">
            <div class="flex flex-col text-left">
              <span class="text-[9px] uppercase tracking-widest text-zinc-500 font-mono font-bold">Promo Code</span>
              <span class="font-mono text-xl sm:text-2xl font-black text-brand-mint tracking-wider" id="welcome-promo-code">ZYLO3WELCOME</span>
            </div>
            <button
              type="button"
              id="copy-welcome-code-btn"
              class="px-5 py-2.5 rounded-full bg-brand-black text-white font-bold text-xs hover:bg-zinc-800 transition-all flex items-center gap-1.5 shrink-0 cursor-pointer shadow-sm"
            >
              <svg class="h-4 w-4 text-brand-mint" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span id="copy-code-text">Copy Code</span>
            </button>
          </div>

          <ul class="flex flex-col gap-2 text-xs text-zinc-600 text-left mb-2">
            <li class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-brand-mint shrink-0"></span>
              <span>Valid for all ZYLO AI Home Gym models</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-brand-mint shrink-0"></span>
              <span>Includes Lifetime Subscription-Free AI Coaching</span>
            </li>
          </ul>
        </div>

        <!-- Shop Now CTA -->
        <div class="pt-2">
          <a
            href="/products"
            id="claim-welcome-discount-btn"
            class="w-full py-4 px-6 rounded-full bg-brand-black text-white hover:bg-zinc-800 font-extrabold text-xs sm:text-sm uppercase tracking-wider flex items-center justify-center gap-2 transition-all shadow-md"
          >
            <span>SHOP NOW &amp; APPLY DISCOUNT</span>
            <svg class="h-4 w-4 text-brand-mint" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  (function () {
    const modal = document.getElementById("welcome-discount-modal");
    const modalCard = document.getElementById("welcome-modal-card");
    const closeBtn = document.getElementById("close-welcome-modal");
    const discountForm = document.getElementById("welcome-discount-form") as HTMLFormElement | null;
    const emailInput = document.getElementById("welcome-discount-email") as HTMLInputElement | null;
    const submitBtn = document.getElementById("welcome-submit-btn");
    const submitBtnText = document.getElementById("submit-btn-text");
    const step1 = document.getElementById("welcome-step-1");
    const step2 = document.getElementById("welcome-step-2");
    const copyBtn = document.getElementById("copy-welcome-code-btn");
    const copyText = document.getElementById("copy-code-text");
    const claimBtn = document.getElementById("claim-welcome-discount-btn");

    if (!modal || !modalCard) return;

    const LOCAL_STORAGE_KEY = "zylo_welcome_modal_dismissed_v8";
    const ZYLO_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbxV4hgMILSHCIhruPry9mgb-8buA1bdFKTCNgaKYIuhfd445MqVV2Kpc8UiyI_WzKz_Ig/exec";

    function showModal() {
      if (localStorage.getItem(LOCAL_STORAGE_KEY) === "true") return;

      setTimeout(() => {
        modal.classList.remove("opacity-0", "pointer-events-none");
        modal.classList.add("opacity-100");
        modalCard.classList.remove("scale-95");
        modalCard.classList.add("scale-100");
        document.body.style.overflow = "hidden";
      }, 1200);
    }

    function hideModal() {
      modal.classList.remove("opacity-100");
      modal.classList.add("opacity-0", "pointer-events-none");
      modalCard.classList.remove("scale-100");
      modalCard.classList.add("scale-95");
      document.body.style.overflow = "";
      localStorage.setItem(LOCAL_STORAGE_KEY, "true");
    }

    async function sendToGSheet(email: string) {
      try {
        await fetch(ZYLO_SCRIPT_URL, {
          method: "POST",
          mode: "no-cors",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            type: "Contact Form Submission",
            form_type: "Discount Welcome Modal",
            email: email,
            fullName: "Subscriber",
            subject: "3% Welcome Discount Subscription",
            message: "Subscribed via Welcome 3% Discount Popup Modal",
            discountCode: "ZYLO3WELCOME",
            source: window.location.href,
            timestamp: new Date().toLocaleString("en-PH", { timeZone: "Asia/Manila" })
          })
        });
      } catch (err) {
        console.warn("GSheet submission warning:", err);
      }
    }

    if (discountForm && emailInput) {
      discountForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const email = emailInput.value.trim();
        if (!email) return;

        if (submitBtnText) submitBtnText.textContent = "SUBMITTING...";
        if (submitBtn) (submitBtn as HTMLButtonElement).disabled = true;

        // Send email lead to Google Sheets Database
        await sendToGSheet(email);

        // Transition to Step 2 (Voucher Unlocked)
        if (step1 && step2) {
          step1.classList.add("hidden");
          step1.classList.remove("flex");

          step2.classList.remove("hidden");
          step2.classList.add("flex");
        }
      });
    }

    // Copy Code Action
    if (copyBtn && copyText) {
      copyBtn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText("ZYLO3WELCOME");
          copyText.textContent = "COPIED! 🎉";
          copyBtn.classList.remove("bg-brand-black", "text-white");
          copyBtn.classList.add("bg-emerald-500", "text-white");

          setTimeout(() => {
            copyText.textContent = "Copy Code";
            copyBtn.classList.remove("bg-emerald-500");
            copyBtn.classList.add("bg-brand-black");
          }, 3000);
        } catch (err) {
          console.error("Failed to copy promo code:", err);
        }
      });
    }

    // Dismissal Actions
    if (closeBtn) closeBtn.addEventListener("click", hideModal);
    if (claimBtn) claimBtn.addEventListener("click", hideModal);

    // Backdrop Click Dismiss
    modal.addEventListener("click", (e) => {
      if (e.target === modal) hideModal();
    });

    // Keyboard ESC Dismiss
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal.classList.contains("opacity-100")) {
        hideModal();
      }
    });

    // Initialize on page load
    if (document.readyState === "complete" || document.readyState === "interactive") {
      showModal();
    } else {
      document.addEventListener("DOMContentLoaded", showModal);
    }
  })();
</script>
