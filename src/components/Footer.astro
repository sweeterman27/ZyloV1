---
// Reusable Universal Footer Component
---

<footer
  class="bg-zinc-950 text-white font-display py-12 sm:py-[80px] border-t border-zinc-900 w-full"
  aria-labelledby="footer-heading"
>
  <h2 id="footer-heading" class="sr-only">Footer</h2>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Top Grid: 2 columns on Mobile, 12 columns on Desktop -->
    <div class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-12 gap-6 sm:gap-8 lg:gap-12 pb-10 sm:pb-16 border-b border-zinc-900/60">
      
      <!-- Column 1: Intro (Full width 2-cols on mobile, 6-cols on desktop) -->
      <div class="col-span-2 lg:col-span-6 flex flex-col items-start gap-3 sm:gap-4 pb-4 lg:pb-0 border-b border-zinc-900/40 lg:border-b-0">
        <h3 class="font-display text-xl sm:text-2xl font-extrabold tracking-tight leading-tight">
          The Philippines' <br class="hidden sm:block" />First &amp; Only <br class="hidden sm:block" />
          <span class="text-brand-mint">AI Home Gym</span>
          <span class="text-brand-mint">.</span>
        </h3>
        <div class="h-[2.5px] w-10 bg-brand-mint rounded-full"></div>
        <p class="text-xs sm:text-sm text-zinc-500 font-medium leading-relaxed max-w-md lg:max-w-md">
          ZYLO AI brings intelligent training, real-time coaching, and full-body progress tracking into your home. Smarter choices. Stronger you.
        </p>
        <!-- Social Icons -->
        <div class="flex items-center gap-2.5 mt-1 sm:mt-2">
          <a
            href="https://www.facebook.com/ZyloAI"
            target="_blank"
            rel="noopener noreferrer"
            class="w-8 h-8 rounded-full border border-zinc-800 flex items-center justify-center text-zinc-400 hover:text-white hover:border-zinc-500 transition-colors"
            aria-label="Facebook"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1V12h3v3h-3v6.95c4.56-.93 8-4.96 8-9.75z"></path>
            </svg>
          </a>
          <a
            href="https://www.instagram.com/zyloai"
            target="_blank"
            rel="noopener noreferrer"
            class="w-8 h-8 rounded-full border border-zinc-800 flex items-center justify-center text-zinc-400 hover:text-white hover:border-zinc-500 transition-colors"
            aria-label="Instagram"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"></path>
            </svg>
          </a>
          <a
            href="https://youtube.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-8 h-8 rounded-full border border-zinc-800 flex items-center justify-center text-zinc-400 hover:text-white hover:border-zinc-500 transition-colors"
            aria-label="YouTube"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.163a3.003 3.003 0 00-2.11-2.107C19.52 3.5 12 3.5 12 3.5s-7.519 0-9.388.556a3.003 3.003 0 00-2.11 2.107C0 8.028 0 12 0 12s0 3.972.502 5.837a3.003 3.003 0 002.11 2.107C4.48 20.5 12 20.5 12 20.5s7.52 0 9.388-.556a3.003 3.003 0 002.11-2.107C24 15.972 24 12 24 12s0-3.972-.502-5.837zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"></path>
            </svg>
          </a>
          <a
            href="https://tiktok.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-8 h-8 rounded-full border border-zinc-800 flex items-center justify-center text-zinc-400 hover:text-white hover:border-zinc-500 transition-colors"
            aria-label="TikTok"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1.04-.1z"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Products (3-cols on desktop) -->
      <div class="col-span-1 lg:col-span-3 flex flex-col gap-2.5 sm:gap-4">
        <h4 class="text-xs font-bold tracking-widest text-brand-mint uppercase">
          Products
        </h4>
        <ul class="flex flex-col gap-2 sm:gap-3 text-xs sm:text-sm font-semibold text-zinc-400">
          <li>
            <a href="/products/zylo-k1" class="hover:text-white transition-colors">ZYLO K1</a>
          </li>
          <li>
            <a href="/products/zylo-s1" class="hover:text-white transition-colors">ZYLO S1 PRO</a>
          </li>
          <li>
            <a href="/products" class="hover:text-white transition-colors">All Products</a>
          </li>
          <li>
            <a href="/accessories" class="hover:text-white transition-colors">Accessories</a>
          </li>
          <li>
            <a href="/compare" class="hover:text-white transition-colors">Compare Models</a>
          </li>
          <li>
            <a href="/warranty" class="hover:text-white transition-colors">Warranty</a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Quick Links (3-cols on desktop) -->
      <div class="col-span-1 lg:col-span-3 flex flex-col gap-2.5 sm:gap-4">
        <h4 class="text-xs font-bold tracking-widest text-brand-mint uppercase">
          Quick Links
        </h4>
        <ul class="flex flex-col gap-2 sm:gap-3 text-xs sm:text-sm font-semibold text-zinc-400">
          <li>
            <a href="/about" class="hover:text-white transition-colors">About Us</a>
          </li>
          <li>
            <a href="/ai-technology" class="hover:text-white transition-colors">AI Technology</a>
          </li>
          <li>
            <a href="/training" class="hover:text-white transition-colors">Training Programs</a>
          </li>
          <li>
            <a href="/how-it-works" class="hover:text-white transition-colors">How It Works</a>
          </li>
          <li>
            <a href="/blog" class="hover:text-white transition-colors">Blog</a>
          </li>
          <li>
            <a href="/faqs" class="hover:text-white transition-colors">FAQs</a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="flex flex-col sm:flex-row items-center justify-between pt-6 sm:pt-8 gap-3 sm:gap-4 text-xs font-semibold text-zinc-400 text-center sm:text-left">
      <div>&copy; 2026 ZYLO AI. All rights reserved.</div>
      <div class="flex items-center gap-4 sm:gap-6">
        <a href="/privacy-policy" class="hover:text-brand-mint text-zinc-400 transition-colors">Privacy Policy</a>
        <span class="text-zinc-700">|</span>
        <a href="/terms-conditions" class="hover:text-brand-mint text-zinc-400 transition-colors">Terms &amp; Conditions</a>
      </div>
      <div class="text-zinc-400">
        Powered by <span class="text-brand-mint font-bold">Zion Soothing Haven Inc.</span>
      </div>
    </div>

  </div>
</footer>
